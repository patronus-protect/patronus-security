{
  "version": 1,
  "prng": "splitmix64",
  "placeholder": "<<secret:N>>",
  "note": "Alphabets are lists of chunks and literals are concatenated in order. Both are split so this spec never contains a contiguous key-shaped run (PEM header, Base58 alphabet).",
  "alphabets": {
    "alnum": ["ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz", "0123456789"],
    "alpha": ["ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz"],
    "upper": ["ABCDEFGHIJKLMNOPQRSTUVWXYZ"],
    "lower": ["abcdefghijklmnopqrstuvwxyz"],
    "digit": ["0123456789"],
    "hex_lower": ["0123456789abcdef"],
    "base32_upper": ["ABCDEFGHIJKLMNOPQRSTUVWXYZ", "234567"],
    "base58": ["123456789", "ABCDEFGHJKLMNPQRSTUVWXYZ", "abcdefghijkmnopqrstuvwxyz"],
    "base64": ["ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz", "0123456789", "+/"],
    "base64url": ["ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz", "0123456789", "-_"],
    "bcrypt": ["./", "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz", "0123456789"],
    "wif_uncompressed_lead": ["HJK"],
    "password_symbol": ["!%*?@"]
  },
  "generators": {
    "openai_project_key": {"segments": [{"lit": "sk-proj-"}, {"alphabet": "alnum", "len": 32}]},
    "huggingface_token": {"segments": [{"lit": "hf_"}, {"alphabet": "alpha", "len": 34}]},
    "groq_key": {"segments": [{"lit": "gsk_"}, {"alphabet": "alnum", "len": 52}]},
    "aws_access_key_id": {"segments": [{"lit": "AKIA"}, {"alphabet": "base32_upper", "len": 16}]},
    "aws_secret_access_key": {"segments": [{"alphabet": "base64", "len": 40}]},
    "google_api_key": {"segments": [{"lit": "AIza"}, {"alphabet": "base64url", "len": 35}]},
    "password": {"segments": [{"alphabet": "upper", "len": 1}, {"alphabet": "lower", "len": 6}, {"alphabet": "digit", "len": 4}, {"alphabet": "password_symbol", "len": 1}]},
    "url_token": {"segments": [{"alphabet": "alnum", "len": 24}]},
    "http_basic_credentials": {"segments": [{"alphabet": "base64", "len": 24}]},
    "eth_private_key_hex": {"segments": [{"lit": "0x"}, {"alphabet": "hex_lower", "len": 64}]},
    "btc_wif_uncompressed": {"segments": [{"lit": "5"}, {"alphabet": "wif_uncompressed_lead", "len": 1}, {"alphabet": "base58", "len": 49}]},
    "bcrypt_hash": {"segments": [{"lit": "$2b$12$"}, {"alphabet": "bcrypt", "len": 53}]},
    "argon2id_hash": {"segments": [{"lit": "$argon2id$v=19$m=65536,t=3,p=4$"}, {"alphabet": "base64", "len": 22}, {"lit": "$"}, {"alphabet": "base64", "len": 43}]},
    "md5_hex": {"segments": [{"alphabet": "hex_lower", "len": 32}]},
    "stripe_secret_live": {"segments": [{"lit": "sk_live_"}, {"alphabet": "alnum", "len": 24}]},
    "stripe_restricted_test": {"segments": [{"lit": "rk_test_"}, {"alphabet": "alnum", "len": 24}]},
    "stripe_webhook_secret": {"segments": [{"lit": "whsec_"}, {"alphabet": "alnum", "len": 32}]},
    "pem_pkcs8_private_key": {"segments": [{"lit": "-----BEGIN "}, {"lit": "PRIVATE KEY-----\n"}, {"alphabet": "base64", "len": 64}, {"lit": "\n-----END "}, {"lit": "PRIVATE KEY-----"}]},
    "pem_rsa_private_key": {"segments": [{"lit": "-----BEGIN "}, {"lit": "RSA PRIVATE KEY-----\n"}, {"alphabet": "base64", "len": 64}, {"lit": "\n-----END "}, {"lit": "RSA PRIVATE KEY-----"}]},
    "pem_openssh_private_key_header": {"segments": [{"lit": "-----BEGIN "}, {"lit": "OPENSSH PRIVATE KEY-----"}]},
    "github_pat_classic": {"segments": [{"lit": "ghp_"}, {"alphabet": "alnum", "len": 36}]},
    "gitlab_pat": {"segments": [{"lit": "glpat-"}, {"alphabet": "base64url", "len": 20}]},
    "jwt_hs256": {"segments": [{"lit": "eyJhbGciOiJIUzI1NiJ9.eyJ"}, {"alphabet": "base64url", "len": 37}, {"lit": "."}, {"alphabet": "base64url", "len": 43}]}
  }
}
