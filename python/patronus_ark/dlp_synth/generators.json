    "openai_legacy_key": {"source": "gitleaks:openai-api-key", "segments": [{"lit": "sk-"}, {"alphabet": "alnum", "len": 20}, {"lit": "T3BlbkFJ"}, {"alphabet": "alnum", "len": 20}]},
