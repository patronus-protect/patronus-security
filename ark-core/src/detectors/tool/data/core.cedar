// Core policies over patronus.tool_facts/1: the default set D of the reference (toolfacts.POLICIES),
// generated by tool_facts_reference.py core. Never lowered; user policies add to them.

@id("core.secret_to_egress")
@decision("block")
@title("Sends secret material (a SECRET path) out: network, message or publish")
forbid (principal, action == Action::"call", resource)
when { context.flows.containsAny(["SECRET>NET", "SECRET>MESSAGE", "SECRET>PUBLISH"]) };

@id("core.cred_literal_to_egress")
@decision("block")
@title("Sends a literal credential (token, key) out")
forbid (principal, action == Action::"call", resource)
when { context.flows.containsAny(["CRED_LITERAL>NET", "CRED_LITERAL>MESSAGE", "CRED_LITERAL>PUBLISH"]) };

@id("core.remote_to_exec")
@decision("block")
@title("Runs code fetched from the network (Cat shell flow)")
forbid (principal, action == Action::"call", resource)
when { context.flows.containsAny(["REMOTE>INTERP", "REMOTE>EXEC"]) };

@id("core.metadata_fetch")
@decision("block")
@title("Contacts a link-local address (cloud instance metadata)")
forbid (principal, action == Action::"call", resource)
when { context.net_scopes.contains("LINK_LOCAL") };

@id("core.root_delete")
@decision("block")
@title("Deletes the root or home directory itself")
forbid (principal, action == Action::"call", resource)
when { context.objects.contains("DELETE@ROOT") };

@id("core.persistence_write")
@decision("ask")
@title("Writes a persistence location (shell profile, cron, authorized_keys, ...)")
forbid (principal, action == Action::"call", resource)
when { context.objects.containsAny(["WRITE@PERSIST", "APPEND@PERSIST"]) };

@id("core.system_modify")
@decision("ask")
@title("Writes or deletes a system location (/etc, /usr, C:\\\\Windows, registry)")
forbid (principal, action == Action::"call", resource)
when { context.objects.containsAny(["WRITE@SYSTEM", "DELETE@SYSTEM", "APPEND@SYSTEM"]) };

@id("core.secret_read")
@decision("ask")
@title("Reads secret material (keys, cloud credentials, .env)")
forbid (principal, action == Action::"call", resource)
when { context.objects.contains("READ@SECRET") };

@id("core.sql_destructive")
@decision("ask")
@title("Drops or truncates tables, or deletes/updates all rows")
forbid (principal, action == Action::"call", resource)
when { context.atoms.containsAny(["SQL_DROP", "SQL_DELETE_ALL", "SQL_UPDATE_ALL", "SQL_GRANT"]) };

@id("core.cred_literal_in_args")
@decision("ask")
@title("Puts a literal credential into the call arguments")
forbid (principal, action == Action::"call", resource)
when { context.atoms.contains("CRED_LITERAL") };

@id("core.destructive_infra")
@decision("ask")
@title("Deletes in version control, cloud infrastructure, databases or secret stores")
forbid (principal, action == Action::"call", resource)
when { context.paw == "delete" && ["vcs", "cloud_infra", "database", "secrets_auth"].contains(context.sight) };

@id("core.untrusted_to_action")
@decision("ask")
@title("After untrusted input in this session, executes remotely, publishes or messages")
forbid (principal, action == Action::"call", resource)
when { context.session_sources.contains("untrusted") && context.sinks.containsAny(["remote_exec", "publish", "message"]) && (!context.shell || context.session_tool_sources.contains("untrusted")) };

@id("core.sensitive_to_egress")
@decision("ask")
@title("After sensitive data in this session, sends it out to an external target")
forbid (principal, action == Action::"call", resource)
when { (context.session_sources.contains("sensitive") && context.sinks.containsAny(["net_request", "message", "publish", "web_form"]) && context.external && ["send", "create", "update"].contains(context.paw)) || (context.linked.contains("sensitive") && context.sinks.containsAny(["net_request", "message", "publish", "web_form"]) && context.external && !context.shell) };

@id("core.money_movement")
@decision("ask")
@title("Moves money or crypto (payment, transfer, withdrawal, trade)")
forbid (principal, action == Action::"call", resource)
when { ((context.atoms.contains("TOOL_MONEY") || ["finance", "crypto"].contains(context.sight)) && (context.atoms.contains("VERB_MOVE") || (!context.atoms.contains("VERB_READ") && ["send", "create", "execute", "update", "schedule"].contains(context.paw)))) && (context.session_sources.contains("untrusted") || context.linked.containsAny(["untrusted", "sensitive"])) };

@id("core.security_loosen")
@decision("ask")
@title("Loosens a security control (unblock, disable, allow, grant access)")
forbid (principal, action == Action::"call", resource)
when { (context.atoms.contains("TOOL_SECCTL") && context.atoms.contains("TOOL_LOOSEN") && !context.atoms.contains("VERB_READ")) && (context.session_sources.contains("untrusted") || context.linked.containsAny(["untrusted", "sensitive"])) };

@id("core.physical_control")
@decision("ask")
@title("Controls a physical device (lock, robot, home device, traffic, vehicle)")
forbid (principal, action == Action::"call", resource)
when { (context.atoms.contains("TOOL_PHYSICAL") && (context.atoms.containsAny(["VERB_MUTATE", "VERB_MOVE", "VERB_DELETE"]) || (!context.atoms.contains("VERB_READ") && ["execute", "update", "create", "delete", "send"].contains(context.paw)))) && (context.session_sources.contains("untrusted") || context.linked.containsAny(["untrusted", "sensitive"])) };

@id("core.account_delete")
@decision("ask")
@title("Deletes users, accounts, customers or contacts")
forbid (principal, action == Action::"call", resource)
when { (context.atoms.contains("TOOL_ACCOUNT") && (context.atoms.contains("VERB_DELETE") || context.paw == "delete")) && (context.session_sources.contains("untrusted") || context.linked.containsAny(["untrusted", "sensitive"])) };

@id("core.public_post")
@decision("ask")
@title("Publishes publicly (post, tweet, public share)")
forbid (principal, action == Action::"call", resource)
when { (context.sinks.contains("publish") && (context.atoms.contains("VERB_MOVE") || ["send", "create", "update"].contains(context.paw))) && (context.session_sources.contains("untrusted") || context.linked.containsAny(["untrusted", "sensitive"])) };

@id("core.secret_then_egress")
@decision("block")
@title("Sends to the network, a message or publishes, reusing the path of a secret read earlier")
forbid (principal, action == Action::"call", resource)
when { context.linked.contains("secret") && context.sinks.containsAny(["net_request", "message", "publish", "web_form"]) };

@id("core.secret_then_egress_ask")
@decision("ask")
@title("After a secret was read in this session, sends to the network, a message or publishes")
forbid (principal, action == Action::"call", resource)
when { context.session_objects.contains("READ@SECRET") && context.sinks.containsAny(["net_request", "message", "publish", "web_form"]) };
