      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Faithful German lexical translation of Prompt Armor SL-004.",
      "pattern": "wiederhole\\s+(?P<anchor_2>alles|den\\s+gesamten\\s+text)\\s+(?P<anchor_1>oben|vorher|von\\s+anfang\\s+an)"
    },
    {
      "id": "ark.injection.translation.de.end_system_prompt",
      "canonical_id": "ark.injection.boundary.fake_system",
      "upstream_id": "IB-004:de-translation",
      "family": "instruction_boundary",
      "severity": "high",
      "upstream_weight": 0.80,
      "evidence_tier": "audited_high_precision",
      "description": "German translation of an artificial end to the trusted instruction block",
      "source": "https://github.com/prompt-armor/prompt-armor",
      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Faithful German lexical translation of Prompt Armor IB-004.",
      "pattern": "(?P<anchor_3>ende|stopp|abschluss)\\s+(?P<anchor_2>des|der|vom)?\\s*(?P<anchor_1>system\\s*prompt|systemnachricht|systemanweisungen?|ursprünglichen\\s+anweisungen?)"
    }
