  "rules": [
    {
      "id": "ark.injection.override.bounded_particles",
      "canonical_id": "ark.injection.override.discard_prior",
      "upstream_id": "PI-001|PI-002|PI-003|ML-DE-001:bounded-particle-relation",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.90,
      "evidence_tier": "audited_high_precision",
      "description": "Imperative override with bounded politeness or discourse particles before an instruction object",
      "source": "https://github.com/prompt-armor/prompt-armor",
      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Expresses one ordered, language-neutral relation over English and German lexicons: override verb, one to four politeness/discourse particles, optional determiner, optional prior-context modifier, and an explicit instruction object. It extends Prompt Armor PI-001/002/003 and ML-DE-001 along attested please/kindly/now and bitte/doch/jetzt axes. Particle-free forms remain covered by the existing rules. A sentence or line boundary is required and no arbitrary wildcard is used.",
      "references": [
        {
          "source": "https://github.com/luckyPipewrench/pipelock",
          "source_revision": "b4104d5af05b2d861ee6cff43e8d099dbc141c82",
          "upstream_id": "pipelock:Prompt Injection"
        }
      ],
      "ordered_relation": {
        "sentence_or_line_start": true,
        "slots": [
          {
            "alternatives": ["forget", "ignore", "disregard", "abandon", "vergiss", "ignoriere", "missachte", "verwirf", "verwerfe"]
          },
          {
            "alternatives": ["please", "kindly", "now", "bitte", "doch", "jetzt"],
            "min_repeats": 1,
            "max_repeats": 4
          },
          {
            "alternatives": ["all", "any", "your", "the", "alle", "sämtliche", "deine", "die"],
            "min_repeats": 0,
            "max_repeats": 1
          },
          {
            "alternatives": ["last", "previous", "prior", "earlier", "above", "letzte", "letzten", "letzter", "letztere", "letzteren", "letzterer", "vorherige", "vorherigen", "vorheriger", "frühere", "früheren", "früherer", "bisherige", "bisherigen", "bisheriger", "obige", "obigen", "obiger"],
            "min_repeats": 0,
            "max_repeats": 1
          },
          {
            "alternatives": ["instruction", "instructions", "prompt", "prompts", "rule", "rules", "directive", "directives", "guideline", "guidelines", "anweisung", "anweisungen", "instruktion", "instruktionen", "regel", "regeln", "befehl", "befehle", "direktive", "direktiven", "richtlinie", "richtlinien"]
          }
        ]
      }
    },
    {
      "id": "ark.injection.override.redefine_goal_audited",
      "canonical_id": "ark.injection.override.replacement_directive",
      "upstream_id": "PI-009:audited-subset",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.85,
      "evidence_tier": "audited_high_precision",
      "description": "Claims a true or actual replacement task, purpose, or goal",
      "source": "https://github.com/prompt-armor/prompt-armor",
      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Restricts PI-009 to actual/real/true purpose relationships that had no current development-negative collisions; generic new-task declarations remain candidate-only. Adds the equivalent German eigentliche/wahre/wirkliche subset.",
      "pattern": "(?:your\\s+(?P<anchor_6>actual|real|true)\\s+(?P<anchor_5>instructions?|purpose|task|goal)\\s+(?P<anchor_4>is|are)|deine\\s+(?P<anchor_3>eigentliche|wahre|wirkliche)\\s+(?P<anchor_2>anweisungen?|aufgabe|zweck|ziel)\\s+(?P<anchor_1>ist|sind))"
    },
    {
      "id": "ark.injection.identity.no_longer_ai_directive_audited",
      "canonical_id": "ark.injection.identity.reassign",
      "upstream_id": "ID-003:audited-directive-subset",
      "family": "jailbreak_framing",
      "severity": "high",
      "upstream_weight": 0.88,
      "evidence_tier": "audited_high_precision",
      "description": "Replaces the assistant identity and immediately issues a directive",
      "source": "https://github.com/prompt-armor/prompt-armor",
      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Restricts Prompt Armor ID-003 to identity replacement followed by an explicit directive. Descriptive continuations such as 'no longer an AI assistant, but a Koala' remain candidate-only on the raw upstream rule. Adds the equivalent German relationship.",
      "pattern": "(?:(?:you\\s+are\\s+no\\s+longer\\s+(?:claude|gpt|chatgpt|an?\\s+(?P<anchor_6>ai|assistant)))|(?:du\\s+bist\\s+(?:keine?\\s+(?P<anchor_5>ki|ai|assistenz|assistent)\\s+mehr|nicht\\s+länger\\s+(?P<anchor_4>eine?\\s+)?(?P<anchor_3>ki|ai|assistenz|assistent))))\\s*[,;:—-]+\\s*(?P<anchor_2>now\\s+|jetzt\\s+)?(?P<anchor_1>obey|follow|execute|comply|ignore|reveal|send|befolge|gehorche|führe|ignoriere|enthülle|sende)\\b"
    },
    {
      "id": "ark.injection.override.hierarchy_then_direct_action",
      "upstream_id": "pipelock:Prompt Injection+direct action",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.92,
      "evidence_tier": "audited_high_precision",
      "description": "Discards an instruction-hierarchy constraint and immediately requests a replacement action",
      "source": "https://github.com/luckyPipewrench/pipelock",
      "source_revision": "b4104d5af05b2d861ee6cff43e8d099dbc141c82",
      "source_license": "Apache-2.0",
      "source_file": "configs/generic-agent.yaml",
      "adaptation": "Composes Pipelock's Prompt Injection hierarchy relationship with a bounded direct action instead of importing its broad hierarchy regex alone; adds equivalent German hierarchy and action terms. Variations were selected from injection_current development misses.",
      "pattern": "\\b(?P<anchor_7>ignore|disregard|forget|abandon|override|stop\\s+enforcing|reconfigure|ignoriere|missachte|vergiss|verwirf|überschreibe)\\b[\\s\\S]{0,90}\\b(?P<anchor_6>previous|prior|above|earlier|built[ -]?in|system|setup|safety|tone|scope|vorherig\\w*|früher\\w*|obig\\w*|bisherig\\w*|system|sicherheits\\w*)\\b[\\s\\S]{0,42}\\b(?:instructions?|prompts?|rules?|context|directives?|constraints?|polic(?P<anchor_5>y|ies)|guardrails?|guidelines?|limits?|anweisungen?|prompts?|regeln?|kontext|direktiven?|beschränkungen?|richtlinien?|leitplanken?|grenzen?|sicherheits(?P<anchor_4>regeln|richtlinien|leitplanken|grenzen))\\b[\\s\\S]{0,80}(?P<anchor_3>[;,]|\\band\\b|\\bund\\b)\\s*(?P<anchor_2>please\\s+|bitte\\s+)?\\b(?P<anchor_1>say|print|output|produce|give\\s+me|reveal|send|execute|run|call|invoke|transfer|write|sage|drucke|gib\\s+mir|enthülle|sende|führe|rufe|überweise|schreibe)\\b"
    },
    {
      "id": "ark.injection.output.ignore_then_fixed_output",
      "upstream_id": "promptinject:goal_hikacking_attacks",
      "family": "output_manipulation",
      "severity": "high",
      "upstream_weight": 0.94,
      "evidence_tier": "audited_high_precision",
      "description": "Overrides surrounding instructions and restricts the response to attacker-chosen output",
      "source": "https://github.com/agencyenterprise/PromptInject",
      "source_revision": "2928a719d5de62d3766226f1b44c51d9570bc530",
      "source_license": "MIT",
      "source_file": "promptinject/prompt_data.py",
      "adaptation": "Preserves PromptInject's ignore-previous-and-following plus just-say/print composition, extends only equivalent output verbs, and adds a German translation of the same relationship.",
      "pattern": "\\b(?P<anchor_7>ignore|disregard|forget|abandon|ignoriere|missachte|vergiss|verwirf)\\b[\\s\\S]{0,70}\\b(?P<anchor_6>previous|prior|above|earlier|following|vorherig\\w*|früher\\w*|obig\\w*|folgend\\w*)\\b[\\s\\S]{0,45}\\b(?P<anchor_5>instructions?|prompts?|rules?|directives?|anweisungen?|prompts?|regeln?|direktiven?)\\b[\\s\\S]{0,100}(?:\\b(?P<anchor_4>only|just|nur|ausschließlich)\\b[\\s\\S]{0,20}\\b(?P<anchor_3>say|print|output|respond|reply|write|sage|drucke|gib|antworte|schreibe)\\b|\\b(?P<anchor_2>say|print|output|respond|reply|write|sage|drucke|gib|antworte|schreibe)\\b[\\s\\S]{0,12}\\b(?P<anchor_1>only|just|nur|ausschließlich)\\b)"
    },
    {
      "id": "ark.injection.leak.system_prompt_extraction",
      "upstream_id": "pipelock:System Prompt Extraction",
      "family": "instruction_leak",
      "severity": "high",
      "upstream_weight": 0.93,
      "description": "Directly requests disclosure of the assistant's system or initialization instructions",
      "source": "https://github.com/luckyPipewrench/pipelock",
      "source_revision": "b4104d5af05b2d861ee6cff43e8d099dbc141c82",
      "source_license": "Apache-2.0",
      "source_file": "configs/generic-agent.yaml",
      "adaptation": "Imports Pipelock's explicit System Prompt Extraction relationships, adds PromptInject's previous-instruction leakage target, and supplies equivalent German direct-request variations.",
      "references": [
        {
          "source": "https://github.com/agencyenterprise/PromptInject",
          "source_revision": "2928a719d5de62d3766226f1b44c51d9570bc530",
          "upstream_id": "prompt_leaking_attacks"
        }
      ],
      "pattern": "(?:\\b(?P<anchor_21>repeat|output|show|tell|reveal|disclose|expose|dump|divulge)\\b[\\s\\S]{0,28}\\b(?P<anchor_20>me\\s+)?(?P<anchor_19>all\\s+)?(?P<anchor_18>your|the)\\s+(?:(?P<anchor_17>entire|full|complete|previous|prior|initial|original|hidden|secret|internal)\\s+(?P<anchor_16>system\\s*)?(?P<anchor_15>instructions?|prompt|message|rules?|directives?)|system\\s+(?P<anchor_14>prompt|instructions?)|hidden\\s+instructions?|initial\\s+instructions?)\\b|\\b(?P<anchor_13>wiederhole|gib|zeige|sage|enthülle|offenbare|offenlege)\\b[\\s\\S]{0,28}\\b(?P<anchor_12>mir\\s+)?(?P<anchor_11>alle\\s+)?(?P<anchor_10>deine|die)\\s+(?:(?P<anchor_9>gesamten?|vollständigen?|kompletten?|vorherigen?|früheren?|ursprünglichen?|versteckten?|geheimen?|internen?)\\s+(?P<anchor_8>system\\s*)?(?P<anchor_7>anweisungen?|prompt|nachricht|regeln?|direktiven?)|system\\s*(?P<anchor_6>prompt|anweisungen?))\\b|\\bwhat\\s+(?P<anchor_5>is|are)\\s+your\\s+system\\s+(?P<anchor_4>prompt|instructions?)\\b|\\bwas\\s+(?P<anchor_3>ist|sind)\\s+(?P<anchor_2>dein|deine)\\s+system\\s*(?P<anchor_1>prompt|anweisungen?)\\b)"
    },
    {
      "id": "ark.injection.authority.fake_system_asset_transfer",
      "upstream_id": "pipelock:System Override+critical asset action",
      "family": "authority_escalation",
      "severity": "critical",
      "upstream_weight": 0.96,
      "evidence_tier": "audited_high_precision",
      "description": "Uses a fake system or administrator authority marker to mandate a concrete crypto-asset transfer",
      "source": "https://github.com/luckyPipewrench/pipelock",
      "source_revision": "b4104d5af05b2d861ee6cff43e8d099dbc141c82",
      "source_license": "Apache-2.0",
      "source_file": "configs/generic-agent.yaml",
      "adaptation": "Composes Pipelock's System Override authority marker with a bounded high-risk transfer action and concrete crypto asset or wallet identifier. English and German action variants were selected from injection_current development misses; generic authority prose and generic transfers remain insufficient.",
      "pattern": "(?P<anchor_6>^|[\\r\\n])\\s*(?:\\[(?P<anchor_5>system|admin|administrator|kernel|daemon|systemwarnung|administratorbefehl)[^\\]\\r\\n]{0,80}\\]|(?P<anchor_4>system|admin|administrator|kernel|daemon|security|maintenance|systemwarnung|administratorbefehl)[^.!?\\r\\n]{0,80}\\b(?P<anchor_3>command|directive|process|protocol|exception|override|restart|warning|action|befehl|direktive|prozess|protokoll|ausnahme|neustart|warnung|aktion))[\\s\\S]{0,240}\\b(?P<anchor_2>transfer|move|send|relocat\\w*|dispatch|deposit|approve|überweise|verschiebe|sende|verlagere|genehmige)\\b[\\s\\S]{0,140}(?:\\b(?P<anchor_1>btc|eth|sol|aave|matic|usdt|usdc|dai|link|uni|op|arb|wbtc)\\b|\\b0x[0-9a-f]{16,}\\b|\\bbc1q[0-9a-z]{16,}\\b|<attacker\\s+addr>)"
    },
    {
      "id": "ark.injection.translation.de.do_not_follow_prior",
      "canonical_id": "ark.injection.override.discard_prior",
      "upstream_id": "PI-004:de-translation",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.88,
      "evidence_tier": "audited_high_precision",
      "description": "German translation of the audited refusal to follow prior instructions",
      "source": "https://github.com/prompt-armor/prompt-armor",
      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Faithful German lexical translation of Prompt Armor PI-004 with the same bounded instruction-hierarchy relationship.",
      "pattern": "(?P<anchor_4>folge|befolge|beachte)\\s+nicht\\s+(?:(?P<anchor_3>deine|die|alle)\\s+)?(?P<anchor_2>vorherigen|früheren|bisherigen|ursprünglichen|obigen)\\s+(?P<anchor_1>anweisungen|regeln|richtlinien)"
    },
    {
      "id": "ark.injection.translation.de.follow_instead",
      "canonical_id": "ark.injection.override.replacement_directive",
      "upstream_id": "PI-008:de-translation",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.80,
      "evidence_tier": "audited_high_precision",
      "description": "German translation of an explicit replacement-instruction directive",
      "source": "https://github.com/prompt-armor/prompt-armor",
      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Faithful German lexical translation of Prompt Armor PI-008.",
      "pattern": "(?P<anchor_2>befolge|beachte|führe|tu)\\s+stattdessen\\s+(?P<anchor_1>die\\s+folgenden|diese|dies)"
    },
    {
      "id": "ark.injection.translation.de.forget_context",
      "canonical_id": "ark.injection.override.discard_prior",
      "upstream_id": "PI-011:de-translation",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.85,
      "evidence_tier": "audited_high_precision",
      "description": "German translation of discarding all preceding context",
      "source": "https://github.com/prompt-armor/prompt-armor",
      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Faithful German lexical translation of Prompt Armor PI-011.",
      "pattern": "vergiss\\s+(?P<anchor_2>alles|all\\s+das)\\s+(?P<anchor_1>vor|davor|oberhalb|zuvor)"
    },
    {
      "id": "ark.injection.translation.de.dump_system_prompt",
      "canonical_id": "ark.injection.leak.system_instructions",
      "upstream_id": "SL-002:de-translation",
      "family": "instruction_leak",
      "severity": "critical",
      "upstream_weight": 0.92,
      "evidence_tier": "audited_high_precision",
      "description": "German translation of a complete hidden or system-instruction dump request",
      "source": "https://github.com/prompt-armor/prompt-armor",
      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Faithful German lexical translation of Prompt Armor SL-002.",
      "pattern": "(?P<anchor_7>kopiere|wiederhole|zeige|enthülle|offenbare|gib)\\s+(?P<anchor_6>mir\\s+)?(?P<anchor_5>den|die|das)?\\s*(?P<anchor_4>gesamten|vollständigen|kompletten|ganzen)\\s+(?P<anchor_3>versteckten?\\s+)?(?P<anchor_2>system\\s*prompt|systemnachricht|systemanweisungen?|anweisungen?)(?P<anchor_1>\\s+aus)?"
    },
    {
      "id": "ark.injection.translation.de.prior_configuration",
      "canonical_id": "ark.injection.leak.system_instructions",
      "upstream_id": "SL-003:de-translation",
      "family": "instruction_leak",
      "severity": "high",
      "upstream_weight": 0.72,
      "evidence_tier": "audited_high_precision",
      "description": "German translation of asking what instructions preceded the input",
      "source": "https://github.com/prompt-armor/prompt-armor",
      "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
      "source_license": "Apache-2.0",
      "source_file": "src/prompt_armor/data/rules/default_rules.yml",
      "adaptation": "Faithful German lexical translation of Prompt Armor SL-003.",
      "pattern": "(?P<anchor_3>was\\s+wurde\\s+dir|wozu\\s+wurdest\\s+du)\\s+(?P<anchor_2>vorher|zuvor)?\\s*(?P<anchor_1>gesagt|aufgetragen|angewiesen|programmiert|konfiguriert|gegeben)"
    },
    {
      "id": "ark.injection.translation.de.repeat_context",
      "canonical_id": "ark.injection.leak.system_instructions",
      "upstream_id": "SL-004:de-translation",
      "family": "instruction_leak",
      "severity": "high",
      "upstream_weight": 0.85,
      "evidence_tier": "audited_high_precision",
