{
  "schema_version": 1,
  "catalog_id": "prompt-armor-selected-95e532e",
  "source": "https://github.com/prompt-armor/prompt-armor",
  "source_revision": "95e532e275280488b3abacb519f8b14ae17a9dcb",
  "license": "Apache-2.0",
  "rules": [
    {
      "id": "ark.injection.override.do_not_follow_prior",
      "upstream_id": "PI-004",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.88,
      "description": "Explicitly refuses the prior instruction hierarchy",
      "adaptation": "Adds a semantically equivalent German relationship while preserving the upstream requirement for an explicit refusal of prior instructions.",
      "pattern": "(?:do\\s+not\\s+follow\\s+(?:any|your|the)\\s+(?:previous|prior|original|above)\\s+(?:instructions?|rules?|guidelines?)|(?:folge|befolge|beachte)\\s+nicht\\s+(?:(?:deine|die|alle)\\s+)?(?:vorherigen|früheren|bisherigen|ursprünglichen)\\s+(?:anweisungen|regeln|richtlinien)|(?:folge|befolge|beachte)\\s+(?:(?:deine|die|alle)\\s+)?(?:vorherigen|früheren|bisherigen|ursprünglichen)\\s+(?:anweisungen|regeln|richtlinien)\\s+nicht)"
    },
    {
      "id": "ark.injection.override.follow_instead",
      "upstream_id": "PI-008",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.80,
      "description": "Redirects execution to replacement instructions",
      "adaptation": "Adds a German stattdessen-plus-replacement-instruction variant of the pinned relationship.",
      "pattern": "(?:instead\\s*,?\\s+(?:do|follow|obey|execute|respond)\\s+(?:the\\s+following|these|this)|(?:befolge|beachte|führe|tu)\\s+stattdessen\\s+(?:die\\s+folgenden|diese|dies))"
    },
    {
      "id": "ark.injection.override.redefine_goal",
      "upstream_id": "PI-009",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.85,
      "description": "Claims a replacement task, purpose, or goal",
      "adaptation": "Adds the direct German deine wahre/eigentliche Aufgabe relationship.",
      "pattern": "(?:your\\s+(?:actual|real|true|new)\\s+(?:instructions?|purpose|task|goal)\\s+(?:is|are)|deine\\s+(?:eigentliche|wahre|wirkliche|neue)\\s+(?:anweisungen?|aufgabe|zweck|ziel)\\s+(?:ist|sind))"
    },
    {
      "id": "ark.injection.override.forget_context",
      "upstream_id": "PI-011",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.85,
      "description": "Commands the model to discard all preceding context",
      "adaptation": "Adds a bounded German vergiss-alles-before-context variant.",
      "pattern": "(?:forget\\s+(?:everything|all\\s+(?:of\\s+)?(?:that|this))\\s+(?:before|above|prior)|vergiss\\s+(?:alles|all\\s+das)\\s+(?:vor|oberhalb|zuvor))"
    },
    {
      "id": "ark.injection.identity.no_longer_ai",
      "upstream_id": "ID-003",
      "family": "jailbreak_framing",
      "severity": "high",
      "upstream_weight": 0.88,
      "description": "Replaces the assistant identity to escape its constraints",
      "adaptation": "Removed the bare a/an alternatives, which matched benign phrases such as 'You are no longer a beginner', and adds only explicit German AI/assistant identity targets.",
      "pattern": "(?:you\\s+are\\s+no\\s+longer\\s+(?:claude|gpt|chatgpt|an?\\s+(?:ai|assistant))|du\\s+bist\\s+(?:keine?\\s+(?:ki|ai|assistenz|assistent)\\s+mehr|nicht\\s+länger\\s+(?:eine?\\s+)?(?:ki|ai|assistenz|assistent)))\\b"
    },
    {
      "id": "ark.injection.leak.dump_system_prompt",
      "upstream_id": "SL-002",
      "family": "instruction_leak",
      "severity": "critical",
      "upstream_weight": 0.92,
      "description": "Requests a complete dump of hidden or system instructions",
      "adaptation": "Adds German complete-dump verbs and explicit hidden/system instruction objects.",
      "pattern": "(?:(?:paste|copy|echo|dump)\\s+(?:the\\s+)?(?:entire|full|complete|whole)\\s+(?:system|initial|original|hidden)\\s+(?:prompt|message|instructions?)|(?:kopiere|wiederhole|zeige|enthülle|offenbare|gib)\\s+(?:mir\\s+)?(?:den|die|das)?\\s*(?:gesamten|vollständigen|kompletten|ganzen)\\s+(?:versteckten?\\s+)?(?:system\\s*prompt|systemnachricht|systemanweisungen?|anweisungen?)(?:\\s+aus)?)"
    },
    {
      "id": "ark.injection.leak.prior_configuration",
      "upstream_id": "SL-003",
      "family": "instruction_leak",
      "severity": "high",
      "upstream_weight": 0.72,
      "description": "Asks what hidden configuration or instructions preceded the input",
      "adaptation": "Adds direct German questions about instructions or configuration received before the current input.",
      "pattern": "(?:what\\s+(?:were|was)\\s+(?:you|your)\\s+(?:told|instructed|programmed|configured|given)\\s+(?:to\\s+do|before)|(?:was\\s+wurde\\s+dir|wozu\\s+wurdest\\s+du)\\s+(?:vorher|zuvor)?\\s*(?:gesagt|aufgetragen|angewiesen|programmiert|konfiguriert|gegeben)?)"
    },
    {
      "id": "ark.injection.leak.repeat_context",
      "upstream_id": "SL-004",
      "family": "instruction_leak",
      "severity": "high",
      "upstream_weight": 0.85,
      "description": "Requests verbatim disclosure of preceding context",
      "adaptation": "Adds German verbatim-context repetition variants.",
      "pattern": "(?:repeat\\s+(?:everything|all|the\\s+text)\\s+(?:above|before|from\\s+the\\s+beginning)|wiederhole\\s+(?:alles|den\\s+gesamten\\s+text)\\s+(?:oben|vorher|von\\s+anfang\\s+an))"
    },
    {
      "id": "ark.injection.boundary.end_system_prompt",
      "upstream_id": "IB-004",
      "family": "instruction_boundary",
      "severity": "high",
      "upstream_weight": 0.80,
      "description": "Declares an artificial end to the trusted instruction block",
      "adaptation": "Adds explicit German end-of-system-instruction boundary declarations.",
      "pattern": "(?:(?:end|stop|terminate|exit)\\s+(?:of\\s+)?(?:system|initial|original)\\s+(?:prompt|message|instructions?)|(?:ende|stopp|abschluss)\\s+(?:des|der|vom)?\\s*(?:system\\s*prompt|systemnachricht|systemanweisungen?|ursprünglichen\\s+anweisungen?))"
    },
    {
      "id": "ark.injection.exfil.markdown_image",
      "upstream_id": "DE-003",
      "family": "cross_tool_instruction",
      "severity": "critical",
      "upstream_weight": 0.90,
      "description": "Uses a remote Markdown image query to exfiltrate protected data",
      "pattern": "!\\[[^\\]]*\\]\\(https?://[^)]*?\\?[^)]*=(\\{|%7B|\\$|data|secret|password|key|token|api)"
    },
    {
      "id": "ark.injection.override.es",
      "upstream_id": "ML-ES-001",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.88,
      "description": "Spanish instruction override",
      "pattern": "(olvida|ignora|desecha|descarta)\\s+((todo|todas?|los?|las?|tus?|sus?|mis?)\\s+){0,5}(instrucci(ón|ones)|reglas?|órdenes?|orden|mensajes?|directrices?|anterior(es)?|previo?s?)"
    },
    {
      "id": "ark.injection.override.fr",
      "upstream_id": "ML-FR-001",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.88,
      "description": "French instruction override",
      "pattern": "(oublie[zs]?|ignore[zs]?|ne\\s+tien[s]?\\s+pas\\s+compte)\\s+(de\\s+)?((tout|toutes?|les?|tes|mes|vos)\\s+){0,5}(instructions?|consignes?|règles?|ordres?|directives?|messages?|précédent(e|es|s)?)"
    },
    {
      "id": "ark.injection.override.pt",
      "upstream_id": "ML-PT-001",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.88,
      "description": "Portuguese instruction override",
      "pattern": "(esqueça|ignore|descarte|desconsidere)\\s+((tudo|todas?|os?|as?|seus?|suas?|minhas?|meus?)\\s+){0,5}(instruç(ão|ões)|regras?|comandos?|mensage(m|ns)|diretrizes?|orientações?|anterior(es)?|prévi[oa]s?)"
    },
    {
      "id": "ark.injection.override.de",
      "upstream_id": "ML-DE-ARK-001",
      "family": "instruction_override",
      "severity": "high",
      "upstream_weight": 0.88,
      "description": "German instruction override",
      "adaptation": "Ark German translation of Prompt Armor's pinned multilingual instruction-override relationship; requires an override verb and an instruction-hierarchy object.",
      "pattern": "(?:vergiss|ignoriere|missachte|verwirf|verwerfe)\\s+(?:(?:alles|alle|die|deine|sämtliche)\\s+){0,4}(?:anweisungen?|instruktionen?|regeln?|befehle?|direktiven?|richtlinien?|nachrichten?|vorherigen?|früheren?|bisherigen?)"
    }
  ]
}
