{
  "schema_version": 1,
  "catalog_id": "source-derived-p0-0.1.6",
  "source": "ark-source-derived",
  "source_revision": "0.1.6",
  "license": "mixed-per-rule",
  "rules": [
    {
      "id": "ark.injection.exfil.sensitive_path_to_sink",
      "upstream_id": "pipelock:Credential Path Directive",
      "family": "cross_tool_instruction",
      "severity": "critical",
      "upstream_weight": 0.95,
      "description": "Reads a sensitive credential path and directs its contents to an output or transfer sink",
      "source": "https://github.com/luckyPipewrench/pipelock",
      "source_revision": "b4104d5af05b2d861ee6cff43e8d099dbc141c82",
      "source_license": "Apache-2.0",
      "source_file": "configs/generic-agent.yaml",
      "adaptation": "Retains Pipelock's read-verb, sensitive-path, and sink relationship while removing source-only path matches and requiring a downstream content or destination object.",
      "pattern": "\\b(?:read|get|fetch|retrieve|cat|copy|extract|open|include)\\b(?:[^.!?\\n]|\\.[^\\s]){0,80}(?:\\.ssh[/\\\\](?:id_rsa|id_ed25519)|\\.aws[/\\\\]credentials|\\.env\\b|\\.npmrc\\b|\\.pypirc\\b|\\.netrc\\b|\\bkubeconfig\\b|/etc/(?:passwd|shadow)\\b)(?:[^.!?\\n]|\\.[^\\s]){0,160}\\b(?:send|forward|transmit|share|email|exfiltrat\\w*|leak|paste|return|dump|print|output|upload|post|submit)\\b(?:[^.!?\\n]|\\.[^\\s]){0,80}(?:\\b(?:it|them|contents?|file|data|keys?|values?|secrets?)\\b|https?://|\\S+@\\S+|\\b(?:reply|response|message|answer|chat|request)\\b)"
    },
    {
      "id": "ark.injection.override.authority_issued_replacement",
      "upstream_id": "pipelock:New Instructions",
      "family": "instruction_override",
      "severity": "critical",
      "upstream_weight": 0.92,
      "description": "Claims that an authority issued replacement instructions and demands an action",
      "source": "https://github.com/luckyPipewrench/pipelock",
      "source_revision": "b4104d5af05b2d861ee6cff43e8d099dbc141c82",
      "source_license": "Apache-2.0",
      "source_file": "configs/generic-agent.yaml",
      "adaptation": "Narrows Pipelock's alternatives to require all three components: an authority, a new/updated/revised instruction object, and an imperative action within a bounded span.",
      "pattern": "(?:\\b(?:system|developer|administrator|admin)\\s*(?:message|prompt|instruction|directive)?(?:\\s*[.!?:,;>=—-]+|[ \\t]*[\\r\\n])[\\s\\W]*(?:new|updated|revised)\\s+(?:instructions?|directives?|rules?|prompt)\\b[\\s\\S]{0,120}\\b(?:obey|execute|run|follow|comply|delete|override|replace|supersede|ignore|disregard|forget|abandon|send|upload|post|transmit|forward|email)\\b|\\b(?:new|updated|revised)\\s+(?:instructions?|directives?|rules?|prompt)\\b[\\s\\S]{0,80}\\b(?:issued\\s+)?(?:from|by)\\s+(?:the\\s+)?(?:system|developer|administrator|admin)\\b[\\s\\S]{0,120}\\b(?:obey|execute|run|follow|comply|delete|override|replace|supersede|ignore|disregard|forget|abandon|send|upload|post|transmit|forward|email)\\b)"
    },
    {
      "id": "ark.injection.obfuscation.decode_then_execute",
      "upstream_id": "pipelock:Encoded Payload",
      "family": "encoded_instruction",
      "severity": "high",
      "upstream_weight": 0.90,
      "description": "Directs the model to decode an encoded payload and execute or follow it",
      "source": "https://github.com/luckyPipewrench/pipelock",
      "source_revision": "b4104d5af05b2d861ee6cff43e8d099dbc141c82",
      "source_license": "Apache-2.0",
      "source_file": "configs/generic-agent.yaml",
      "adaptation": "Preserves Pipelock's decode-then-execute relationship and extends only the encoding names implemented as active NVIDIA Garak encoding probes at the pinned revision.",
      "references": [
        {
          "source": "https://github.com/NVIDIA/garak",
          "source_revision": "8ed1543b985a5722adb659584182faf6f7907d4e",
          "upstream_id": "encoding.InjectBase64|InjectBase16|InjectBase32|InjectAscii85|InjectHex|InjectUU|InjectROT13|InjectBase2048"
        }
      ],
      "pattern": "\\bdecode\\b[\\s\\S]{0,40}\\b(?:base64|base16|hex|base32|ascii85|base85|uuencode|rot13|base2048)\\b[\\s\\S]{0,48}\\b(?:execute|run|follow|obey|eval)\\b"
    },
    {
      "id": "ark.injection.boundary.delimited_replacement_action",
      "upstream_id": "promptinject:escape_chars+delimiter_chars",
      "family": "instruction_boundary",
      "severity": "high",
      "upstream_weight": 0.88,
      "description": "Uses a synthetic delimiter boundary before a replacement instruction and action",
      "source": "https://github.com/agencyenterprise/PromptInject",
      "source_revision": "2928a719d5de62d3766226f1b44c51d9570bc530",
      "source_license": "MIT",
      "source_file": "promptinject/prompt_data.py",
      "adaptation": "Combines PromptInject's equals, dash, greater-than, and asterisk delimiter axes with its goal-hijacking actions; requires a replacement marker and action rather than matching a delimiter alone.",
      "references": [
        {
          "source": "https://github.com/luckyPipewrench/pipelock",
          "source_revision": "b4104d5af05b2d861ee6cff43e8d099dbc141c82",
          "upstream_id": "pipelock:Instruction Boundary"
        }
      ],
      "pattern": "(?:^|[\\r\\n])\\s*(?:={3,}|-{3,}|>{3,}|\\*{3,})\\s*(?:system|developer|admin|instructions?)?\\s*(?:={3,}|-{3,}|>{3,}|\\*{3,})?[\\r\\n]+[\\s\\S]{0,80}\\b(?:ignore|disregard|forget|abandon|instead|new\\s+task|stop\\s+everything)\\b[\\s\\S]{0,80}\\b(?:say|print|output|execute|run|follow|obey|send|upload|post|invoke|call)\\b"
    }
  ]
}
