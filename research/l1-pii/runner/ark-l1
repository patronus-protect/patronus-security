# ── helpers ──────────────────────────────────────────────────────────────


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, env: dict | None = None) -> str:
    proc = subprocess.run(
        cmd, cwd=cwd, text=True, capture_output=True, env={**os.environ, **(env or {})}
    )
    if check and proc.returncode != 0:
        raise RuntimeError(f"{shlex.join(cmd)} failed ({proc.returncode}):\n{proc.stdout}\n{proc.stderr}")
    return proc.stdout.strip()


# Host-side git only touches the trusted repository and checkouts it created itself; these
# flags keep it from running configured commands even so.
GIT_SAFE = ["-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null"]
EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # git hash-object -t tree /dev/null


def git(*args: str, cwd: Path = REPO, check: bool = True) -> str:
    return run(["git", *GIT_SAFE, *args], cwd=cwd, check=check)


def git_raw(*args: str, stdin: str | None = None, env: dict | None = None) -> str:
    proc = subprocess.run(["git", *GIT_SAFE, *args], cwd=REPO, text=True, capture_output=True,
                          input=stdin, env={**os.environ, **(env or {})})
    if proc.returncode != 0:
        raise RuntimeError(f"git {shlex.join(args)} failed ({proc.returncode}):\n{proc.stderr}")
    return proc.stdout


def sandbox(cmd: list[str], cwd: Path, rw: list[Path], env: dict[str, str], *,
            network: bool = True, readable: tuple[Path, ...] = (), max_sec: int = 3600
            ) -> subprocess.CompletedProcess:
    """Run cmd as the current user in a transient systemd unit without credentials."""
    exposed = {*rw, *readable}
    # A private directory stays visible when a step exposes it or something below it.
    hidden = [path for path in PRIVATE if not any(e == path or e.is_relative_to(path) for e in exposed)]
    props = [
        "NoNewPrivileges=yes", "ProtectSystem=strict", "ProtectHome=read-only", "PrivateTmp=yes",
        "ReadWritePaths=" + " ".join(f"-{path}" for path in rw),
        "InaccessiblePaths=" + " ".join(f"-{path}" for path in hidden),
        f"RuntimeMaxSec={max_sec}", "CPUQuota=500%", "MemoryMax=9G",
    ]
    if not network:
        props.append("PrivateNetwork=yes")
    full = ["sudo", "systemd-run", f"--uid={os.getuid()}", f"--gid={os.getgid()}", "--pipe",
            "--wait", "--collect", "--quiet", f"--working-directory={cwd}"]
    for prop in props:
        full += ["-p", prop]
    base = {"HOME": str(HOME), "PATH": f"{CARGO.parent}:/usr/local/bin:/usr/bin:/bin",
            "RUSTUP_HOME": str(HOME / ".rustup"), "GIT_CONFIG_NOSYSTEM": "1"}
    for key, value in {**base, **env}.items():
        full += ["-E", f"{key}={value}"]
    return subprocess.run(full + cmd, text=True, capture_output=True, stdin=subprocess.DEVNULL)


def agent_git(wt: Path, *args: str) -> subprocess.CompletedProcess:
    """git inside the agent clone reads agent-controlled config, so it only runs sandboxed."""
    return sandbox(["git", *args], wt, [TRANSFER], {}, network=False, max_sec=300)


def load(path: Path, default):
    return json.loads(path.read_text()) if path.exists() else default


def save(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)


def branch_number(name: str) -> int:
    m = re.match(rf"{re.escape(BRANCH_PREFIX)}(\d+)-", name)
    return int(m.group(1)) if m else -1


RUNNER_LOGIN: list[str] = []


def runner_login() -> str:
    """The GitHub account the runner publishes as; only its own PRs belong to a stack."""
    if not RUNNER_LOGIN:
        RUNNER_LOGIN.append(os.environ.get("ARK_L1_GH_LOGIN") or run(["gh", "api", "user", "--jq", ".login"]))
    return RUNNER_LOGIN[0]


def prs(state: str) -> list[dict]:
    """The programme's stack PRs: its label and branch prefix, opened by the runner's own account
    from a branch of this repository. A fork or someone else's PR with the same label or branch
    name is never restacked, reviewed or merged."""
    out = run([
        "gh", "pr", "list", "--repo", GH_REPO, "--label", LABEL, "--state", state, "--limit", "200",
        "--json", "number,headRefName,baseRefName,headRefOid,state,url,mergeable,isDraft,"
                  "isCrossRepository,author",
    ])
    own = runner_login()
    return [p for p in json.loads(out)
            if p["headRefName"].startswith(BRANCH_PREFIX) and not p.get("isCrossRepository")
            and (p.get("author") or {}).get("login") == own]


def sha(ref: str) -> str:
    return git("rev-parse", ref)


def conflicts_with(base: str, head: str) -> bool:
    """True when `head` does not merge cleanly into `base`. Checked locally: GitHub reports
    `mergeable` as UNKNOWN for a while after every push to main, which hid real conflicts.
    Attributes come from the empty tree: GitHub ignores merge drivers such as the repository's
    `CHANGELOG.md merge=union`, so two PRs that add a CHANGELOG bullet at the same place conflict
    there although a local merge is clean. The rebase in `restack` still uses the union driver."""
    proc = subprocess.run(["git", *GIT_SAFE, f"--attr-source={EMPTY_TREE}", "merge-tree", "--write-tree",
                           base, head],
                          cwd=REPO, capture_output=True, text=True)
    if proc.returncode > 1:
        raise RuntimeError(f"git merge-tree failed: {proc.stderr.strip()}")
    return proc.returncode == 1


def nothing(reason: str) -> int:
    print(f"RESULT={reason}")
    if reason.split()[0] in ("NOTHING_TO_DO", "NO_BACKLOG"):
        IDLE.write_text(dt.datetime.now(dt.timezone.utc).isoformat() + "\n")
    return NOTHING


def task_lane(task_id: str) -> str:
    """The lane that owns a task id (any case; branch names carry it lower-cased)."""
    return next((lane for lane, patterns in LANE_TASKS.items()
                 if any(fnmatch.fnmatchcase(task_id.lower(), pat.lower()) for pat in patterns)), "a")


def in_lane(task_id: str) -> bool:
    """True when this host's lane owns the task; always true without a lane setting."""
    return not LANE or task_lane(task_id) == LANE


def own(pulls: list[dict]) -> list[dict]:
    """The PRs of this host's lane: the others are reviewed, restacked and merged by their own lane."""
    return [p for p in pulls if in_lane(task_of_branch(p["headRefName"]))]


def next_branch_number(all_prs: list[dict]) -> int:
    """Above every number in use (PRs in any state, remote task branches, the local counter). With
    lanes, number % len(LANES) is the lane's index: hosts never pick the same number, even for runs
    that have not pushed their branch yet."""
    remote = git("for-each-ref", "--format=%(refname:lstrip=3)", f"refs/remotes/origin/{BRANCH_PREFIX.rstrip('/')}")
    used = [branch_number(name) for name in [p["headRefName"] for p in all_prs] + remote.split()]
    number = max([*used, load(STATE / "counter.json", 0)], default=0) + 1
    while LANE and number % len(LANES) != LANES.index(LANE):
        number += 1
    return number


# ── restack ──────────────────────────────────────────────────────────────


def restack(open_prs: list[dict]) -> tuple[tuple[str, str], dict | None]:
    """Keep the open task PRs mergeable on main (flat: each PR is based on main, not on another).

    Returns ((top_name, top_sha), conflict); conflict describes the first branch whose rebase did
    not apply cleanly (the branches above it stay untouched until it is resolved)."""
    stack = load(STACK, {})
    prev_name, prev_sha = "main", sha("origin/main")
    conflict = None
    for pr in sorted(open_prs, key=lambda p: branch_number(p["headRefName"])):
        name = pr["headRefName"]
        rec = stack.get(name)
        head = pr["headRefOid"]
        if rec is None:
            print(f"WARN=unrecorded stack branch {name}; leaving it untouched")
        elif (rec["base"] != prev_name or rec["base_sha"] != prev_sha) and subprocess.run(
                ["git", *GIT_SAFE, "merge-base", "--is-ancestor", prev_sha, head], cwd=REPO).returncode == 0:
            # Rebased outside the runner (by hand or by a report run), the bottom branch included:
            # only record the new base; replaying from the stale base would duplicate the parent's commits.
            stack[name] = {"base": prev_name, "base_sha": prev_sha}
            print(f"RECORDED={name} already on {prev_name}")
        elif (conflicts_with(prev_sha, head) if prev_name == "main" and rec["base"] == "main"
              else rec["base_sha"] != prev_sha):
            # The bottom branch stays on its main commit until it conflicts with main;
            # its old base is where it forks from main, whatever stack.json still says.
            old_base = (git("merge-base", head, prev_sha) if prev_name == "main" and rec["base"] == "main"
                        else rec["base_sha"])
            git("checkout", "--quiet", "--detach", head)
            proc = subprocess.run(
                ["git", *GIT_SAFE, "rebase", "--quiet", "--onto", prev_sha, old_base],
                cwd=REPO, text=True, capture_output=True,
            )
            if proc.returncode != 0:
                git("rebase", "--abort", check=False)
                git("checkout", "--quiet", "--detach", "origin/main")
                print(f"CONFLICT_BRANCH={name}")
                conflict = {"branch": name, "pr": pr["url"], "old_head": head, "old_base": old_base,
                            "onto_name": prev_name, "onto": prev_sha}
                break
            new_head = sha("HEAD")
            try:
                git("push", "--quiet", f"--force-with-lease=refs/heads/{name}:{head}", "origin",
                    f"HEAD:refs/heads/{name}")
            except RuntimeError as err:
                # E.g. a branch that touches .github/workflows and a token without `workflow` scope.
                # Keep the rebase for a push from outside; once the branch is there, the next run
                # only records it (see above).
                ref = f"refs/ark/{PROGRAM}/restack/{name}"
                git("update-ref", ref, new_head)
                git("checkout", "--quiet", "--detach", "origin/main")
                reason = next((line.strip() for line in str(err).splitlines() if "rejected" in line),
                              str(err).strip().splitlines()[-1])
                print(f"RESTACK_PUSH_ERROR={name}: {reason}\nRESTACK_REF={ref} {new_head} lease={head}")
                conflict = {"branch": name, "push_error": reason}
                break
            git("checkout", "--quiet", "--detach", "origin/main")
            stack[name] = {"base": prev_name, "base_sha": prev_sha}
            head = new_head
            print(f"RESTACKED={name}")
        if pr["baseRefName"] != prev_name:
            try:
                run(["gh", "pr", "edit", str(pr["number"]), "--repo", GH_REPO, "--base", prev_name])
            except RuntimeError as err:
                # GitHub refuses base changes on PRs that are part of a native stack. The branch is
                # already rebased; a stale PR base must not abort every following run.
                print(f"WARN=base of #{pr['number']} not changed to {prev_name}: "
                      f"{str(err).strip().splitlines()[-1]}")
                move_stale_base(pr, prev_name, prev_sha, {p["headRefName"] for p in open_prs})
        # Flat since 2026-10-23: every task PR targets main, none builds on another one; a PR is
        # rebased only when it conflicts with main (or its recorded base is a branch).
    for name in list(stack):
        if name not in {p["headRefName"] for p in open_prs}:
            del stack[name]
    save(STACK, stack)
    return (prev_name, prev_sha), conflict


def move_stale_base(pr: dict, onto_name: str, onto_sha: str, open_heads: set[str]) -> None:
    """Point the stale base branch of a stacked PR at its new parent.

    A PR keeps the head branch of its merged parent as base when GitHub refuses the base change
    (native stack). That branch still holds the parent's unsquashed commits, so GitHub reports the
    rebased PR as conflicting and the next run rebases it again. Moving the merged branch, never an
    open stack branch, to the new parent leaves the PR with only its own commits."""
    base = pr["baseRefName"]
    if not base.startswith(BRANCH_PREFIX) or base in open_heads:
        return
    old = ""
    try:
        old = git("ls-remote", "origin", f"refs/heads/{base}").split("\t")[0]
        if not old or old == onto_sha:
            return
        git("push", "--quiet", f"--force-with-lease=refs/heads/{base}:{old}", "origin",
            f"{onto_sha}:refs/heads/{base}")
    except RuntimeError as err:
        # E.g. a `.github/workflows` change between the two commits and a token without `workflow`
        # scope; the PR stays as it is and the next run tries again.
        print(f"WARN=stale base {base} of #{pr['number']} not moved to {onto_name}: "
              f"{str(err).strip().splitlines()[-1]}\nSTALE_BASE_REF={base} {onto_sha} lease={old}")
        return
    print(f"MOVED_BASE={base} → {onto_name} for #{pr['number']}")


def workflow_refusal(err: Exception, base: str, head: str) -> bool:
    """True when GitHub refused a push for `.github/workflows` while the commits between base and
    head touch no workflow file: the difference comes from main."""
    return "workflow" in str(err) and not git("diff", "--name-only", base, head, "--", ".github/workflows")


def with_main_workflows(head: str) -> str:
    """head plus a commit that takes `.github/workflows` from origin/main; head when they already match.

    The runner token has no `workflow` scope, and GitHub refuses a push whose head has other
    `.github/workflows` files than the default branch, also when only main changed them after the
    branch's base (probed on 2026-11-06: once the head carries main's workflow files, both new and
    existing branches accept the push; the refs and merges APIs refuse like git push). The commit
    only repeats changes that are on main, so a squash merge adds nothing for it and the next
    rebase onto main drops it."""
    main_workflows = git("rev-parse", "origin/main:.github/workflows")
    if git("rev-parse", "--verify", "--quiet", f"{head}:.github/workflows", check=False) == main_workflows:
        return head
    with tempfile.TemporaryDirectory() as tmp:
        env = {"GIT_INDEX_FILE": str(Path(tmp) / "index")}
        git_raw("read-tree", head, env=env)
        git_raw("rm", "-r", "-q", "-f", "--cached", "--ignore-unmatch", ".github/workflows", env=env)
        git_raw("read-tree", "--prefix=.github/workflows/", "origin/main:.github/workflows", env=env)
        tree = git_raw("write-tree", env=env).strip()
    return git_raw("commit-tree", tree, "-p", head, "-m",
                   f"ci: take .github/workflows from main ({sha('origin/main')[:12]})\n\n"
                   "The runner token may not push a branch whose workflow files differ from main's.").strip()


def start_restack(conflict: dict) -> int:
    """Hand a conflicting rebase to the agent: same sandbox, gate and rounds as a backlog task."""
    branch = conflict["branch"]
    task = {"id": f"RESTACK:{branch}", "type": "restack",
            "title": f"Rebase {branch} onto {conflict['onto_name']} and resolve the conflicts",
            "branch": branch, "pr": conflict["pr"], "onto": conflict["onto"],
            "onto_name": conflict["onto_name"], "old_base": conflict["old_base"],
            "old_head": conflict["old_head"]}
    return start_on_branch(task, conflict["old_head"], conflict["onto_name"], conflict["onto"])


def start_on_branch(task: dict, head: str, base: str, base_sha: str) -> int:
    """Make `task` the current run in a fresh agent clone of `task["branch"]` at `head`
    (restack, review and verify runs; `base_sha` is where the agent's own commits start)."""
    branch = task["branch"]
    worktree = WORKTREES / (f"{task['type']}-" + branch.replace("/", "-"))
    shutil.rmtree(worktree, ignore_errors=True)
    git("clone", "--quiet", "--shared", "--no-checkout", str(REPO), str(worktree))
    git("checkout", "--quiet", "-B", branch, head, cwd=worktree)
    current = {
        "task_id": task["id"], "task": task, "branch": branch, "base": base, "base_sha": base_sha,
        "worktree": str(worktree), "started": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    save(CURRENT, current)
    print(f"TASK_ID={task['id']}\nBRANCH={branch}\nBASE={base}\nWORKTREE={worktree}")
    return 0


# ── review ───────────────────────────────────────────────────────────────

# Log lines or annotations of a failed CI job that point at the GitHub runner, not at the code.
INFRA_FAILURES = ("failed to install component", "No space left on device",
                  "The runner has received a shutdown signal", "Could not resolve host",
                  "The operation was canceled", "lost communication with the server",
                  # Downloads in build scripts (ort-sys fetches ONNX Runtime from cdn.pyke.io).
                  "prebuilt binaries downloaded from", "Peer disconnected", "timeout: global",
                  "Connection reset by peer",
                  # GitHub release downloads during an outage (RESTACK:dlp/116-f-struct, 2026-11-08):
                  # maturin-action got 50x three times, cargo-deny-action untarred an error page.
                  "Unexpected HTTP response: 50", "gzip: invalid magic",
                  # A hosted runner never picked the job up (macos-latest capacity, T18 2026-10-28): no
                  # log at all, only a check-run annotation, and the job ends "cancelled".
                  "was not acquired by Runner",
                  # native-throughput on hosted runners: L3 requests time out in the queue (0.2-0.34
                  # MiB/s vs 0.30 minimum). Push runs fail where the PR run on the same SHA passes
                  # (0fc0fa6d, 50c62094, a8b514ad on 2026-11-07); a restack head has no PR run to
                  # compare with. A real slowdown stays red after CI_RESTART_LIMIT restarts.
                  "expired_before_inference")
BAD_CONCLUSIONS = ("failure", "cancelled", "timed_out", "startup_failure")
NO_RESTART = "no-restart"  # rerun_infra_failures: runner failure, but CI could not be restarted

# The native-throughput job (scripts/ark_api_throughput_benchmark.py) fails on hosted runners now and
# then with nothing but L3 `expired_before_inference` timeouts of unified-v3-threat at normal MiB/s and
# RPS; it did so on main and on unrelated branches. P08 and P09 were blocked on it after 3 rounds
# (2026-11-06) although agents cannot change the L3 model. Only that exact report is a flake.
THROUGHPUT_JOB = "native-throughput"
GH_LOG_PREFIX = re.compile(r"^[^\t]*\t[^\t]*\t\S+Z ?")


def throughput_timeout_flake(log: str) -> bool:
    """The benchmark JSON in a failed native-throughput log reports only pipeline failures, and every
    one is an L3 timeout that expired before inference (no throughput, RPS or coverage error)."""
    lines = [GH_LOG_PREFIX.sub("", line) for line in log.splitlines()]
    try:
        start = lines.index("{")
        end = lines.index("}", start)
        report = json.loads("\n".join(lines[start:end + 1]))
    except ValueError:
        return False
    errors, failures = report.get("errors") or [], report.get("failures") or []
    return (bool(failures) and len(errors) == 1
            and re.fullmatch(r"received \d+ pipeline failures", str(errors[0])) is not None
            and all(f.get("kind") == "timeout" and f.get("level") == "L3"
                    and f.get("message") == "expired_before_inference" for f in failures))


CI_RESTART_LIMIT = 2  # CI restarts per head; macos capacity + a Windows flake needed two (H06, 2026-11-03)


def run_jobs(run_id: int) -> list[dict]:
    view = json.loads(run(["gh", "run", "view", str(run_id), "--repo", GH_REPO, "--json", "jobs"],
                          check=False) or "{}")
    return view.get("jobs", [])


def run_is_infra_failure(run_id: int, passed_elsewhere: frozenset[str] = frozenset()) -> bool:
    """Every failed or cancelled job of the run shows a runner or toolchain failure in its log or its
    annotations (a job that never got a runner has no log). Judged per job: a real failure cancels its
    matrix siblings ("The operation was canceled"), which must not turn the whole run into infra.
    A job that passed in another CI run on the same head (passed_elsewhere) is a flake on the same
    code, not a verdict: H06's Windows job failed once on a file rename race it passed before."""
    bad = [j for j in run_jobs(run_id) if j.get("conclusion") in BAD_CONCLUSIONS]
    for job in bad:
        if job.get("name") in passed_elsewhere:
            continue
        text = run(["gh", "run", "view", str(run_id), "--repo", GH_REPO, "--job", str(job["databaseId"]),
                    "--log-failed"], check=False) + run(
            ["gh", "api", f"repos/{GH_REPO}/check-runs/{job['databaseId']}/annotations", "--jq", ".[].message"],
            check=False)
        if job.get("name") == THROUGHPUT_JOB and throughput_timeout_flake(text):
            continue
        if not any(marker in text for marker in INFRA_FAILURES):
            return False
    return bool(bad)


def restart_count(entry: str | dict | None) -> int:
    """CI restarts recorded for a head in ci-reruns.json (a plain timestamp: one, from older runners)."""
    if entry is None:
        return 0
    return entry.get("count", 1) if isinstance(entry, dict) else 1


def same_tree_ancestors(head: str, limit: int = CI_RESTART_LIMIT + 1) -> list[str]:
    """First-parent ancestors of head with head's tree (the commits under retrigger commits)."""
    found, commit = [], head
    try:
        tree = git_raw("rev-parse", f"{head}^{{tree}}").strip()
        for _ in range(limit):
            parent = git_raw("rev-parse", "--verify", "--quiet", f"{commit}^1").strip()
            if not parent or git_raw("rev-parse", f"{parent}^{{tree}}").strip() != tree:
                break
            found.append(commit := parent)
    except RuntimeError:
        pass
    return found


def rerun_infra_failures(head: str, branch: str | None = None, push: dict | None = None) -> str | None:
    """Restart CI on head (up to CI_RESTART_LIMIT times) when every failed job of its failed runs is
    a runner, toolchain or download failure or passed in another run on head (run_is_infra_failure). Returns the commit whose CI to wait for; NO_RESTART for
    such a failure that could not be restarted (no verdict on the code); None for a real failure or
    a head that was restarted CI_RESTART_LIMIT times.

    The runner token may not rerun workflow runs (no actions:write), so a restart is a push. For a
    PR branch an empty commit on top of head: pull_request runs filter paths on the whole PR diff.
    A task branch without a PR (push: the current run) only gets push runs, whose path filter sees
    nothing in an empty commit, and pushing it as a new branch is refused when main changed a
    workflow since its base. Moving the branch back to its main base and then to head again starts
    a push run on head (plus one on the base commit, which is already on main)."""
    reruns = load(STATE / "ci-reruns.json", {})
    restarts = restart_count(reruns.get(head))
    if restarts >= CI_RESTART_LIMIT:
        return None
    runs = json.loads(run(["gh", "run", "list", "--repo", GH_REPO, "--commit", head, "--json",
                           "databaseId,conclusion"], check=False) or "[]")
    failed = [r["databaseId"] for r in runs if r.get("conclusion") in BAD_CONCLUSIONS]
    if not failed:
        return None
    # A retrigger commit has its parent's tree: jobs that passed there passed on the same code
    # (native-throughput L3 timeouts on #286, 2026-11-06: green on bb6ee7e, red on its retrigger).
    for commit in same_tree_ancestors(head):
        runs += json.loads(run(["gh", "run", "list", "--repo", GH_REPO, "--commit", commit, "--json",
                                "databaseId,conclusion"], check=False) or "[]")
    passed = {r["databaseId"]: {j.get("name") for j in run_jobs(r["databaseId"]) if j.get("conclusion") == "success"}
              for r in runs}
    if not all(run_is_infra_failure(r, frozenset().union(*(v for k, v in passed.items() if k != r)))
               for r in failed):
        return None
    new = head
    if branch is None:
        if not (push and push["branch"].startswith(BRANCH_PREFIX) and push.get("base") == "main"):
            # Only a main base: a push run on a stacked base would add checks to another PR's head.
            print(f"WARN=CI on {head[:12]} failed on the runner; no branch to restart it on")
            return NO_RESTART
        ref = f"refs/heads/{push['branch']}"
        try:
            git("push", "--quiet", f"--force-with-lease={ref}:{head}", "origin", f"{push['base_sha']}:{ref}")
            git("push", "--quiet", f"--force-with-lease={ref}:{push['base_sha']}", "origin", f"{head}:{ref}")
        except RuntimeError as err:
            print(f"WARN=CI retrigger on {push['branch']} failed: {push_error_reason(err)}")
            return NO_RESTART
        print(f"CI_RETRIGGER={push['branch']} {head[:12]} pushed again via its base (runner/toolchain failure)")
    else:
        try:
            git("fetch", "--quiet", "origin", f"refs/heads/{branch}")
            new = git_raw("commit-tree", f"{head}^{{tree}}", "-p", head, "-m",
                          "ci: retrigger after a runner or download failure").strip()
            git("push", "--quiet", f"--force-with-lease=refs/heads/{branch}:{head}",
                "origin", f"{new}:refs/heads/{branch}")
        except RuntimeError as err:
            print(f"WARN=CI retrigger on {branch} failed: {push_error_reason(err)}")
            return NO_RESTART
        print(f"CI_RETRIGGER={branch} {head[:12]} → {new[:12]} (runner/toolchain failure)")
    # The retrigger commit counts as the restart too: a CDN that stays down must not stack them.
    reruns[head] = reruns[new] = {"at": dt.datetime.now(dt.timezone.utc).isoformat(), "count": restarts + 1}
    save(STATE / "ci-reruns.json", reruns)
    return new


def find_review(open_prs: list[dict]) -> dict | None:
    """The lowest stack PR with unresolved review threads or red CI that is not a runner failure.

    Fixing it comes before any new backlog task: such a PR can never be merged, and everything
    stacked on it waits."""
    blocked = load(BLOCKED, {})
    for pr in sorted(open_prs, key=lambda p: branch_number(p["headRefName"])):
        threads = review_threads(pr["number"])
        ci_red = (ci_state(pr["headRefOid"]) == "red"
                  and rerun_infra_failures(pr["headRefOid"], pr["headRefName"]) is None)
        if not threads and not ci_red:
            continue
        if f"REVIEW:{pr['headRefName']}" in blocked:
            print(f"WARN=review of {pr['headRefName']} is blocked; it stays unmergeable until unblocked")
            continue
        return {"pr": pr, "threads": threads, "ci_red": ci_red}
    return None


def start_review(review: dict) -> int:
    """Hand a PR's open review threads and/or red CI to the agent, on top of the PR's own branch."""
    pr = review["pr"]
    branch, head = pr["headRefName"], pr["headRefOid"]
    git("fetch", "--quiet", "origin", f"+refs/heads/{branch}:refs/ark/{PROGRAM}/review-head")
    task = {"id": f"REVIEW:{branch}", "type": "review",
            "title": f"Address the open review threads and red CI of {pr['url']}",
            "branch": branch, "pr": pr["url"], "number": pr["number"], "old_head": head,
            "threads": review["threads"],
            "ci_failure": ci_failure_log(head) if review["ci_red"] else ""}
    # base_sha is the PR head: the agent's fix commits sit on top of it and the gate compares
    # the fixed head against the PR as it was.
    return start_on_branch(task, head, pr["baseRefName"], head)


def public_text(text: str) -> str:
    """Agent text for a public GitHub comment, with every value of secrets.env masked."""
    try:
        values = [line.split("=", 1)[1].strip().strip("'\"") for line in SECRETS.read_text().splitlines()
                  if "=" in line and not line.lstrip().startswith("#")]
    except OSError:
        values = []
    for value in values:
        if len(value) >= 8:
            text = text.replace(value, "[redacted]")
    return text


# ── verify ───────────────────────────────────────────────────────────────

VERIFY_PATH = "ark-core/"     # a PR that changes the detector crate merges only after a passing verify
VERIFIED = STATE / "verify.json"  # {"pass": {head sha: time}, "fails": {branch: count}}
VERIFY_FAIL_LIMIT = 2         # failed verifies of one PR; after that its review fixes merge without another verify
VERIFY_LATENCY_ATTEMPTS = 4   # latency A/B attempts (the gate takes 2); a slowdown must show in every one
VERIFY_MAX_FINDINGS = 20
VERDICT_PATH = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_./-]{0,255}")


def diff_base(head: str) -> str:
    return git("merge-base", "origin/main", head)


def touches_core(head: str) -> bool:
    """True when the PR head changes ark-core/ against its merge base with main."""
    return bool(git("diff", "--name-only", diff_base(head), head, "--", VERIFY_PATH))


def needs_verify(head: str, branch: str = "") -> bool:
    """True for a head that changes ark-core/ and has no passing verify verdict of its own. Verify is a
    sanity check, never a gate a person must clear: once a PR failed VERIFY_FAIL_LIMIT verifies, the
    review flow fixes those findings and the PR merges on green CI without a further verify."""
    state = load(VERIFIED, {})
    if branch and state.get("fails", {}).get(branch, 0) >= VERIFY_FAIL_LIMIT:
        return False
    return head not in state.get("pass", {}) and touches_core(head)


def verify_held(head: str, branch: str) -> bool:
    """needs_verify for auto_merge's scan; an unreadable head counts as held (skipped this run)."""
    try:
        return needs_verify(head, branch)
    except (RuntimeError, ValueError):
        return True


def start_verify(pr: dict) -> int:
    """Hand a mergeable, green PR that changes ark-core/ to a fresh agent for an independent check of
    its exact head. The agent writes a verdict file, never a commit; `verdict` acts on it."""
    branch, head = pr["headRefName"], pr["headRefOid"]
    backlog = backlog_at(head) or {}
    entry = next((t for t in backlog.get("tasks", []) + backlog.get("recurring", [])
                  if str(t.get("id", "")).lower() == task_of_branch(branch)), None)
    body = run(["gh", "pr", "view", str(pr["number"]), "--repo", GH_REPO, "--json", "body", "--jq", ".body"])
    task = {"id": f"VERIFY:{branch}", "type": "verify",
            "title": f"Verify {pr['url']} independently before it merges",
            "branch": branch, "pr": pr["url"], "number": pr["number"], "head": head,
            "diff_base": diff_base(head), "backlog_task": entry,
            # The body carries the gate report with the scoreboard summary (aggregates, no holdout data).
            "pr_body": body[:20000]}
    # base_sha is the head: a verify run adds no commits.
    return start_on_branch(task, head, pr["baseRefName"], head)


# Runs in the sandbox with the base checkout's scoreboard.py: the gate's latency check on the gate's
# cached builds of base and head, with more attempts. Prints one JSON line (numbers only).
DLP_LATENCY_AB = """\
import importlib.util, json, sys
from pathlib import Path
tree, base, head, dev, cache, attempts = sys.argv[1:]
spec = importlib.util.spec_from_file_location("ark_verify_scoreboard", Path(tree, "scripts/l1_dlp/scoreboard.py"))
sb = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = sb
spec.loader.exec_module(sb)
builds = [sb.ensure_build(Path(tree), sb.resolve_commit(Path(tree), rev), Path(cache)) for rev in (base, head)]
result = sb.LATENCY.gate_check(*builds, Path(dev), Path(cache) / "latency", attempts=int(attempts))
print(json.dumps({"lines": sb.LATENCY.gate_lines(result), "ok": [c["ok"] for c in result["checks"]]}))
"""


def latency_ab(task: dict) -> dict:
    """Quiet latency A/B of the PR head against its merge base with main. run.sh calls it while it
    holds the run lock, so no other ARK job runs on the host. The latency code is the base
    checkout's (merged, reviewed), never the head's: DLP the gate's `LATENCY.gate_check`, PII
    `latency.py run` + `compare` (ark and ark-native, 100 KiB p95) per attempt, threat
    `scripts/l1_threat/latency.py run --repo` + `compare` (real-DE 100 KiB p95 of threat, injection and
    all L1) per attempt. Like the gate, a check fails only when it fails in every attempt. Returns
    {"lines", "regression"} or {"error"}."""
    out = GATE_TREES / "verify-latency"   # not under CACHE: head code runs here with network
    trees = {"base": GATE_TREES / "verify-base", "head": GATE_TREES / "verify-head"}
    sides = {"base": task["diff_base"], "head": task["head"]}
    if PROGRAM == "dlp":
        del sides["head"]  # scoreboard builds both commits from one checkout
    for d in (out, GATE_TARGET, GATE_HOME / "cargo", GATE_HOME / "cache", CACHE):
        d.mkdir(parents=True, exist_ok=True)
    try:
        git("worktree", "prune")
        for side, rev in sides.items():
            shutil.rmtree(trees[side], ignore_errors=True)
            git("worktree", "add", "--quiet", "--detach", str(trees[side]), rev)
        if PROGRAM == "dlp":
            proc = sandbox([str(ROOT / P["eval_venv"] / "bin" / "python"), "-c", DLP_LATENCY_AB,
                            str(trees["base"]), task["diff_base"], task["head"], str(DEV_DATA),
                            str(CACHE / "scoreboard"), str(VERIFY_LATENCY_ATTEMPTS)],
                           trees["base"], [CACHE], gate_env(), network=False,
                           readable=(DEV_DATA, trees["base"]), max_sec=7200)
            if proc.returncode != 0:
                raise RuntimeError(f"latency A/B exit {proc.returncode}: {proc.stderr.strip()[-1500:]}")
            result = json.loads(proc.stdout.strip().splitlines()[-1])
            return {"lines": [str(x)[:300] for x in result["lines"]], "regression": not all(result["ok"])}
        if PROGRAM == "threat":
            return _threat_latency_ab(trees, out)
        return _pii_latency_ab(trees, out)
    except (RuntimeError, OSError, ValueError, KeyError, IndexError, TypeError) as err:
        return {"error": str(err).strip()[-1500:]}
    finally:
        for tree in trees.values():
            shutil.rmtree(tree, ignore_errors=True)
        shutil.rmtree(out, ignore_errors=True)
        git("worktree", "prune", check=False)


def _pii_latency_ab(trees: dict[str, Path], out: Path) -> dict:
    gpy = str(GATE_VENV / "bin" / "python")
    script = "scripts/l1_presidio/latency.py"
    shutil.copy2(trees["base"] / script, trees["head"] / script)  # `run` measures its own checkout
    engines = ("ark", "ark-native")
    passed = dict.fromkeys(engines, False)
    lines = []
    for attempt in range(1, VERIFY_LATENCY_ATTEMPTS + 1):
        for side in ("base", "head"):
            proc = sandbox([gpy, script, "run", "--engines", *engines, "--ark-python", gpy,
                            "--output", str(out / f"{side}.json")], trees[side],
                           [trees[side], GATE_TARGET, GATE_HOME, out], gate_env(), max_sec=7200)
            if proc.returncode != 0:
                raise RuntimeError(f"latency.py run ({side}) exit {proc.returncode}: {proc.stderr.strip()[-1500:]}")
        for engine in engines:
            proc = sandbox([gpy, script, "compare", "--base", str(out / "base.json"), "--head",
                            str(out / "head.json"), "--engine", engine], trees["base"], [], {},
                           network=False, readable=(out, trees["base"]), max_sec=300)
            if proc.returncode not in (0, 1):
                raise RuntimeError(f"latency.py compare exit {proc.returncode}: {proc.stderr.strip()[-1500:]}")
            passed[engine] = passed[engine] or proc.returncode == 0
            lines += [f"attempt {attempt}: {line[:200]}" for line in proc.stdout.strip().splitlines()]
        if all(passed.values()):
            break
    return {"lines": lines, "regression": not all(passed.values())}


THREAT_LATENCY_CORPUS = CACHE / "threat-latency-de"   # frozen real-DE windows, built once by `prepare`


def _threat_latency_ab(trees: dict[str, Path], out: Path) -> dict:
    gpy = str(GATE_VENV / "bin" / "python")
    script = str(trees["base"] / "scripts/l1_threat/latency.py")
    corpus = THREAT_LATENCY_CORPUS
    # Licensed source texts only (pinned revisions and SHA-256); a frozen corpus is kept as it is.
    proc = sandbox([gpy, script, "prepare", "--out", str(corpus)], trees["base"], [CACHE], gate_env(),
                   readable=(trees["base"],), max_sec=3600)
    if proc.returncode != 0:
        raise RuntimeError(f"threat latency prepare exit {proc.returncode}: {proc.stderr.strip()[-1500:]}")
    lines = []
    for attempt in range(1, VERIFY_LATENCY_ATTEMPTS + 1):
        for side in ("base", "head"):
            proc = sandbox([gpy, script, "run", "--corpus", str(corpus), "--repo", str(trees[side]),
                            "--output", str(out / f"{side}.json")], trees["base"],
                           [trees[side], GATE_TARGET, GATE_HOME, out], gate_env(), network=False,
                           readable=(trees["base"], corpus), max_sec=7200)
            if proc.returncode != 0:
                raise RuntimeError(f"threat latency run ({side}) exit {proc.returncode}: {proc.stderr.strip()[-1500:]}")
        proc = sandbox([gpy, script, "compare", "--base", str(out / "base.json"), "--head", str(out / "head.json")],
                       trees["base"], [], {}, network=False, readable=(out, trees["base"]), max_sec=300)
        if proc.returncode not in (0, 1):
            raise RuntimeError(f"threat latency compare exit {proc.returncode}: {proc.stderr.strip()[-1500:]}")
        lines += [f"attempt {attempt}: {line[:200]}" for line in proc.stdout.strip().splitlines()]
        if proc.returncode == 0:
            return {"lines": lines, "regression": False}
    return {"lines": lines, "regression": True}


def verify_verdict(cur: dict) -> dict | None:
    """The agent's verdict from `.git/ark-verify.json` in its clone, or None when there is none.

    Untrusted agent output: only the pass/fail word and findings with a plain relative path, a line
    number and a short reason (secrets.env values masked) are used."""
    path = Path(cur["worktree"]) / ".git" / "ark-verify.json"
    try:
        data = json.loads(path.read_text()) if path.is_file() and path.stat().st_size < 64_000 else None
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or data.get("verdict") not in ("pass", "fail"):
        return None
    findings = []
    for item in data.get("findings") or []:
        if not isinstance(item, dict) or not isinstance(item.get("reason"), str) or not item["reason"].strip():
            continue
        where, line = item.get("path"), item.get("line")
        findings.append({
            "path": where if isinstance(where, str) and VERDICT_PATH.fullmatch(where) and ".." not in where else "",
            "line": line if isinstance(line, int) and not isinstance(line, bool) and line > 0 else None,
            "reason": public_text(item["reason"].strip()[:1500]),
        })
    return {"verdict": data["verdict"], "findings": findings[:VERIFY_MAX_FINDINGS]}


def diff_lines(base: str, head: str) -> dict[str, set[int]]:
    """Per file, the head-side lines of the PR diff GitHub accepts review comments on (hunks, 3 lines context)."""
    lines: dict[str, set[int]] = {}
    path = None
    for row in git_raw("diff", "--no-ext-diff", "--no-color", "--unified=3", base, head).splitlines():
        if row.startswith("+++ "):
            path = row[6:] if row.startswith("+++ b/") else None
        elif row.startswith("@@") and path and (m := re.match(r"@@ -\S+ \+(\d+)(?:,(\d+))? @@", row)):
            start = int(m.group(1))
            lines.setdefault(path, set()).update(range(start, start + int(m.group(2) or 1)))
    return lines


def post_findings(task: dict, findings: list[dict]) -> int:
    """Each finding becomes a review comment on the PR head, i.e. an unresolved thread the review flow
    fixes: on its line when the diff shows it, else on its file, else on the first changed ark-core/
    file; a PR comment only when GitHub rejects that. Returns the number of findings not posted."""
    head = task["head"]
    lines = diff_lines(task["diff_base"], head)
    anchor = next((p for p in sorted(lines) if p.startswith(VERIFY_PATH)), min(lines, default=""))
    failed = 0
    for finding in findings:
        where, line = finding["path"], finding["line"]
        body = f"**Verify ({P['name']}, {head[:12]}):** {finding['reason']}"
        if where in lines and line in lines[where]:
            place = ["-f", f"path={where}", "-F", f"line={line}", "-f", "side=RIGHT"]
        else:
            if where:
                body += f"\n\nLocation: `{where}{f':{line}' if line else ''}`"
            place = ["-f", f"path={where if where in lines else anchor}", "-f", "subject_type=file"]
        try:
            run(["gh", "api", "-X", "POST", f"repos/{GH_REPO}/pulls/{task['number']}/comments",
                 "-f", f"body={body}", "-f", f"commit_id={head}", *place])
        except RuntimeError:
            try:
                run(["gh", "api", "-X", "POST", f"repos/{GH_REPO}/issues/{task['number']}/comments",
                     "-f", f"body={body}"])
            except RuntimeError as err:
                failed += 1
                print(f"WARN=verify finding not posted: {str(err).strip().splitlines()[0] if str(err).strip() else err}")
    return failed


# ── backlog ──────────────────────────────────────────────────────────────


def backlog_at(rev: str, path: str = BACKLOG) -> dict | None:
    text = git("show", f"{rev}:{path}", check=False)
    return yaml.safe_load(text) if text else None


MAIN_DONE: dict[str, set[str]] = {}


def done_on_main(ref: str) -> bool:
    """True when `program:ID` is done in that programme's backlog on origin/main."""
    program, _, task_id = ref.partition(":")
    if program not in PROGRAMS or not task_id:
        raise RuntimeError(f"bad ext_deps entry {ref!r}; expected <program>:<id>")
    if program not in MAIN_DONE:
        backlog = backlog_at("origin/main", PROGRAMS[program]["backlog"]) or {}
        MAIN_DONE[program] = {t["id"] for t in backlog.get("tasks", []) if t.get("status") == "done"}
    return task_id in MAIN_DONE[program]


def task_of_branch(branch: str) -> str:
    """`l1/042-b-iban` -> `b-iban`: the lower-cased task id a task branch was created for."""
    m = re.match(rf"{re.escape(BRANCH_PREFIX)}\d+-(.+)$", branch)
    return m.group(1) if m else ""


def pick(backlog: dict, blocked: dict, in_flight: set[str] = frozenset()) -> dict | None:
    """First selectable task; `in_flight` holds lower-cased ids that already have an open PR."""
    tasks = backlog.get("tasks", [])
    done = {t["id"] for t in tasks if t.get("status") == "done"}
    today = dt.date.today()
    week = f"{today.isocalendar().year}-W{today.isocalendar().week:02d}"
    # A programme in its final stretch defers TRIAGE so no new tasks reach its backlog.
    rec = next((r for r in backlog.get("recurring", []) if r["id"] == "TRIAGE"), {})
    # `touch state/triage-now` asks for a triage before the next Monday; it is removed when the triage lands.
    due = (STATE / "triage-now").exists() or (today.weekday() == 0 and not (STATE / f"triage-{week}").exists())
    if due and done and in_lane("TRIAGE") and rec.get("status") != "deferred":
        return {**rec, "type": "triage", "week": week}
    for t in tasks:
        if t.get("status", "todo") != "todo" or t["id"] in blocked or t["id"].lower() in in_flight \
                or not in_lane(t["id"]):
            continue
        if t.get("needs_decision"):
            continue
        if all(d in done for d in t.get("deps", [])) and all(
            done_on_main(d) for d in t.get("ext_deps", [])
        ):
            return t
    return None


def mark_done(path: Path, task_id: str) -> None:
    path.write_text(mark_done_text(path.read_text(), task_id))


def mark_done_text(text: str, task_id: str) -> str:
    lines = text.splitlines(keepends=True)
    for i, line in enumerate(lines):
        flow = re.match(rf"(\s*- \{{id: {re.escape(task_id)},.*)\}}(\s*)$", line)
        if flow:
            lines[i] = f"{flow.group(1)}, status: done}}{flow.group(2)}"
            break
        block = re.match(rf"(\s*)- id: {re.escape(task_id)}\s*$", line)
        if block:
            lines.insert(i + 1, f"{block.group(1)}  status: done\n")
            break
    else:
        raise RuntimeError(f"task {task_id} not found in {BACKLOG}")
    return "".join(lines)


# ── auto-merge ───────────────────────────────────────────────────────────


def check_runs(head: str) -> list[dict]:
    """The check runs on head that still count: those of the newest workflow run per workflow and
    event, and of those the newest attempt per job name. A CI restart adds a run on the same head,
    and before this the superseded run's cancelled macos job kept every later verdict red or
    pending (H06 waited out its 150 min after its restart had finished, 2026-11-03)."""
    checks = json.loads(run(["gh", "api", f"repos/{GH_REPO}/commits/{head}/check-runs?per_page=100"]))[
        "check_runs"]
    try:
        runs = json.loads(run(["gh", "api", f"repos/{GH_REPO}/actions/runs?head_sha={head}&per_page=100"]))[
            "workflow_runs"]
    except (RuntimeError, ValueError, KeyError):
        runs = []
    newest: dict[tuple, dict] = {}
    for r in runs:
        key = (r.get("workflow_id"), r.get("event"))
        if key not in newest or r["id"] > newest[key]["id"]:
            newest[key] = r
    stale = {r.get("check_suite_id") for r in runs} - {r.get("check_suite_id") for r in newest.values()}
    latest: dict[tuple, dict] = {}
    for c in checks:
        suite = (c.get("check_suite") or {}).get("id")
        if suite in stale:
            continue
        key = (suite, c["name"])
        if key not in latest or c["id"] > latest[key]["id"]:
            latest[key] = c
    return list(latest.values())


def ci_state(head: str) -> str:
    """'green', 'red' or 'pending' for the GitHub check runs on head (same rule as `ci`)."""
    try:
        checks = check_runs(head)
    except (RuntimeError, ValueError, KeyError):
        return "pending"
    names = {c["name"] for c in checks}
    if not CI_REQUIRED <= names or any(c["status"] != "completed" for c in checks):
        return "pending"
    return "green" if all(c["conclusion"] in OK_CONCLUSIONS or c["name"] in CI_NON_BLOCKING
                          for c in checks) else "red"


def review_threads(number: int) -> list[dict]:
    """Unresolved review threads of a PR (Codex, CodeQL, people); main requires all resolved."""
    owner, name = GH_REPO.split("/")
    query = (f'query($n:Int!){{repository(owner:"{owner}",name:"{name}"){{pullRequest(number:$n)'
             '{reviewThreads(first:100){nodes{id isResolved path line comments(first:1)'
             '{nodes{databaseId author{login} body}}}}}}}')
    out = json.loads(run(["gh", "api", "graphql", "-f", f"query={query}", "-F", f"n={number}"]) or "{}")
    nodes = (((out.get("data") or {}).get("repository") or {}).get("pullRequest") or {}).get(
        "reviewThreads", {}).get("nodes", [])
    threads = []
    for node in nodes:
        if node.get("isResolved") or not node["comments"]["nodes"]:
            continue
        first = node["comments"]["nodes"][0]
        threads.append({
            "id": node["id"], "comment": first["databaseId"], "path": node.get("path"),
            "line": node.get("line"), "author": (first.get("author") or {}).get("login", ""),
            # Bot comments carry HTML metadata after the finding; the agent needs only the text.
            "body": first.get("body", "").split("<!--")[0].strip()[:4000],
        })
    return threads


def open_review_threads(number: int) -> int:
    return len(review_threads(number))


def merge_async(number: int, head: str) -> str:
    """Squash-merge one PR through the asynchronous merge API (required for native stacks).

    Returns 'merged', 'failed: <message>' or 'pending' after MERGE_TIMEOUT seconds."""
    out = json.loads(run(["gh", "api", "-X", "PUT", f"repos/{GH_REPO}/pulls/{number}/merge-async",
                          "-f", "merge_method=squash", "-f", "merge_action=direct_merge",
                          "-f", f"sha={head}"]) or "{}")
    status, uuid = out.get("status"), (out.get("details") or {}).get("uuid")
    deadline = dt.datetime.now() + dt.timedelta(seconds=MERGE_TIMEOUT)
    while status not in ("merged", "failed") and uuid and dt.datetime.now() < deadline:
        subprocess.run(["sleep", "10"])
        out = json.loads(run(["gh", "api", f"repos/{GH_REPO}/pulls/{number}/merge-async/{uuid}"],
                             check=False) or "{}")
        status = out.get("status", status)
    if status == "failed":
        return f"failed: {(out.get('details') or {}).get('message', '')}"
    return status if status == "merged" else "pending"


CODEX_LOGIN = "chatgpt-codex-connector[bot]"
CODEX_WAIT = 20 * 60     # seconds to wait for the automatic Codex review of a new PR
CODEX_POLL = 30


def codex_reviewed(number: int, head: str) -> bool:
    """True once the Codex review summary on the PR reports a finished review of `head`: completed,
    or failed (usage limit, 2026-11-01), after which no review comes and waiting only delays the merge."""
    out = run(["gh", "api", f"repos/{GH_REPO}/issues/{number}/comments", "--paginate", "--jq",
               f'[.[] | select(.user.login == "{CODEX_LOGIN}") | .body]'], check=False)
    try:
        bodies = json.loads(out or "[]")
    except ValueError:
        return False
    for body in bodies:
        for raw in re.findall(r"codex-review-state:v1 (\{.*?\}) -->", body or "", re.S):
            try:
                review = json.loads(raw).get("code_review") or {}
            except ValueError:
                continue
            if review.get("commit_sha") == head and review.get("status") in ("completed", "failed"):
                return True
    return False


def land(number: int, head: str, wait_for_codex: bool = True) -> None:
    """Merge a just-published, green PR in the same run instead of stacking the next task on it.

    A new PR gets an automatic Codex review: wait for it (CODEX_WAIT), and leave the PR open when
    it opened threads; the next run turns them into a REVIEW task and lands the fix the same way.
    A Codex review that never completes does not block the merge."""
    if not AUTO_MERGE:
        return
    label = f"#{number}"
    deadline = dt.datetime.now() + dt.timedelta(seconds=CODEX_WAIT if wait_for_codex else 0)
    while wait_for_codex and dt.datetime.now() < deadline and not codex_reviewed(number, head):
        if open_review_threads(number):
            break
        subprocess.run(["sleep", str(CODEX_POLL)])
    threads = open_review_threads(number)
    if threads:
        print(f"LAND_WAIT={label} {threads} unresolved review thread(s); the next run reviews them")
        return
    if needs_verify(head):
        print(f"LAND_WAIT={label} changes {VERIFY_PATH}; the next run's auto-merge verifies it first")
        return
    # Opening the PR starts a second CI run on the same head; main requires it, so wait for it.
    deadline = dt.datetime.now() + dt.timedelta(seconds=LAND_CI_WAIT)
    while (state := ci_state(head)) == "pending" and dt.datetime.now() < deadline:
        subprocess.run(["sleep", str(CODEX_POLL)])
    if state != "green":
        print(f"LAND_WAIT={label} CI {state}; the next run's auto-merge retries")
        return
    # Only ever merge into main: a legacy stacked PR may still target an old task branch.
    base = run(["gh", "pr", "view", str(number), "--repo", GH_REPO, "--json", "baseRefName", "--jq", ".baseRefName"])
    if base != "main":
        run(["gh", "pr", "edit", str(number), "--repo", GH_REPO, "--base", "main"], check=False)
        base = run(["gh", "pr", "view", str(number), "--repo", GH_REPO, "--json", "baseRefName", "--jq", ".baseRefName"])
    if base != "main":
        print(f"LAND_WAIT={label} targets {base}, not main; the next restack retargets it")
        return
    result = merge_async(number, head)
    if result == "merged":
        print(f"LANDED={label}")
    else:
        print(f"LAND_WAIT={label} merge {result}; the next run's auto-merge retries")


def wait_for_retarget(merged_branch: str) -> None:
    """After a merge GitHub rebases the PRs above and moves them to main; let it finish first so
    `restack` does not race the server-side rebase with its own force-push."""
    deadline = dt.datetime.now() + dt.timedelta(seconds=RETARGET_TIMEOUT)
    while dt.datetime.now() < deadline:
        if not any(p["baseRefName"] == merged_branch for p in prs("open")):
            return
        subprocess.run(["sleep", "15"])
    print(f"WARN=PRs on {merged_branch} not retargeted after {RETARGET_TIMEOUT}s; restack takes over")


def pr_mergeable(pr: dict) -> str:
    """The PR's `mergeable`; GitHub computes it lazily and answers UNKNOWN on the first read after a
    push or a merge to main, which used to skip a green PR for a whole run (#229, 2026-11-01)."""
    state = pr.get("mergeable")
    for _ in range(MERGEABLE_RETRIES):
        if state != "UNKNOWN":
            break
        subprocess.run(["sleep", "10"])
        state = run(["gh", "pr", "view", str(pr["number"]), "--repo", GH_REPO, "--json", "mergeable",
                     "--jq", ".mergeable"], check=False).strip() or "UNKNOWN"
    pr["mergeable"] = state
    return state


def auto_merge(open_prs: list[dict]) -> int | dict | None:  # PR number, MERGE_PENDING, PR to verify or None
    """Squash-merge the oldest open PR that targets main, is mergeable and has green CI.

    At most one per run; a PR with conflicts or pending CI does not hold back the ones after it
    (restack fixes its conflicts). A PR that changes ark-core/ merges only with a passing verify
    verdict for its exact head; without one it is returned for a VERIFY run instead. Returns the
    merged PR number, else None."""
    if not AUTO_MERGE or not open_prs:
        return None
    bottom = None
    blocked = load(BLOCKED, {})
    for pr in sorted(open_prs, key=lambda p: branch_number(p["headRefName"])):
        label = f"#{pr['number']} {pr['headRefName']}"
        if pr["baseRefName"] != "main" or pr.get("isDraft"):
            print(f"AUTO_MERGE_SKIP={label} (base {pr['baseRefName']}, draft {pr.get('isDraft')})")
        elif pr_mergeable(pr) != "MERGEABLE":
            print(f"AUTO_MERGE_WAIT={label} mergeable={pr.get('mergeable')}")
        elif (state := ci_state(pr["headRefOid"])) != "green":
            print(f"AUTO_MERGE_WAIT={label} CI {state}")
        elif f"VERIFY:{pr['headRefName']}" in blocked and verify_held(pr["headRefOid"], pr["headRefName"]):
            # A verify block waits for a person; it must not hold back the green PRs after it
            # (#291 kept #292-#294 unmerged for 5 h on 2026-11-07, while `landable` saw #292).
            print(f"AUTO_MERGE_WAIT={label} verify blocked; it stays unmerged until unblocked")
        else:
            bottom = pr
            break
    if bottom is None:
        return None
    label = f"#{bottom['number']} {bottom['headRefName']}"
    try:
        threads = open_review_threads(bottom["number"])
        if threads:
            print(f"AUTO_MERGE_WAIT={label} {threads} unresolved review thread(s)")
            return None
        if needs_verify(bottom["headRefOid"], bottom["headRefName"]):
            if f"VERIFY:{bottom['headRefName']}" in load(BLOCKED, {}):
                print(f"AUTO_MERGE_WAIT={label} verify blocked; it stays unmerged until unblocked")
                return None
            print(f"AUTO_MERGE_VERIFY={label} changes {VERIFY_PATH}; verify run first")
            return bottom
        result = merge_async(bottom["number"], bottom["headRefOid"])
    except (RuntimeError, ValueError) as err:
        print(f"AUTO_MERGE_ERROR={label}: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
        return None
    if result == "pending":
        # Still in progress: it may yet merge and rebase the stack on the server, so this run must
        # not restack or start a task now.
        print(f"AUTO_MERGE_PENDING={label} after {MERGE_TIMEOUT}s")
        return MERGE_PENDING
    if result != "merged":
        print(f"AUTO_MERGE_ERROR={label}: {result}")
        return None
    print(f"AUTO_MERGED={label}")
    wait_for_retarget(bottom["headRefName"])
    return bottom["number"]


def resume_auto_merge(cur: dict) -> None:
    """Merge a green, mergeable PR of this lane while a resumed run only waits for CI and publishes.

    Without it a task whose CI needs several runs held back every other green PR for hours
    (#246 on 2026-11-03). No restack here: that one stays with the next `next`. The resumed run's
    own branch is left alone (a review or restack run publishes it itself). A PR that needs a verify
    run waits for the next `next`."""
    try:
        open_prs = [p for p in own(prs("open")) if p["headRefName"] != cur.get("branch")]
        auto_merge(open_prs)
    except (RuntimeError, ValueError) as err:
        print(f"WARN=auto-merge during resume failed: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")


# ── subcommands ──────────────────────────────────────────────────────────


def cmd_next() -> int:
    for d in (WORKTREES, GATE_TREES, TRANSFER, STATE, LOGS, TARGET, CACHE, DEV_DATA, HOLDOUT):
        d.mkdir(parents=True, exist_ok=True)
    if CURRENT.exists():
        # Watchdog: a run that died before its gate, or whose CI/publish step keeps failing, must
        # not pin the programme; drop it and pick work again from the current GitHub state.
        cur = load(CURRENT, {})
        attempts = cur.get("resume_attempts", 0) + 1
        if cur.get("gated_commit") and attempts <= RESUME_LIMIT:
            cur["resume_attempts"] = attempts
            save(CURRENT, cur)
            print(f"RESULT=RESUME_PUBLISH {cur.get('task_id')} (attempt {attempts}/{RESUME_LIMIT})")
            resume_auto_merge(cur)
            return 11
        reason = "gated run not published" if cur.get("gated_commit") else "run died before its gate"
        print(f"WATCHDOG={cur.get('task_id')}: {reason} after {attempts - 1} resume(s); run dropped")
        # The next `next` would pick the same task on the same base again (a review of the same PR
        # head, say) and repeat the agent round and the failing publish forever: block it instead.
        drops = load(STATE / "watchdog.json", {})
        key = f"{cur.get('task_id')}@{cur.get('base_sha', '')}"
        drops[key] = drops.get(key, 0) + 1
        save(STATE / "watchdog.json", drops)
        if cur.get("gated_commit") and drops[key] >= DROP_LIMIT:
            print(f"WATCHDOG_BLOCK={cur.get('task_id')}: dropped {drops[key]} times on {cur.get('base_sha', '')[:12]}")
            cmd_block(cur["task_id"], f"{reason} in {drops[key]} watchdog rounds on the same base; "
                                      f"see PUBLISH_ERROR in the logs; needs a person")
        else:
            drop_worktree(cur)
    IDLE.unlink(missing_ok=True)
    git("fetch", "--quiet", "--prune", "origin")
    git("checkout", "--quiet", "--detach", "origin/main")
    every = prs("open")      # all lanes: the PR limit and the tasks in flight
    open_prs = own(every)
    merged = auto_merge(open_prs)
    if merged == MERGE_PENDING:
        return nothing("MERGE_PENDING (asynchronous merge still running; the next run continues)")
    if isinstance(merged, dict):
        return start_verify(merged)
    if merged is not None:
        git("fetch", "--quiet", "--prune", "origin")
        git("checkout", "--quiet", "--detach", "origin/main")
        # GitHub may still list the PR as open for a moment; a merged (and deleted) branch must
        # never become the stack top a new task is based on.
        every = [p for p in prs("open") if p["number"] != merged]
        open_prs = own(every)
    top, conflict = restack(open_prs)
    if conflict is not None:
        if conflict.get("push_error"):
            return nothing(f"RESTACK_PUSH_ERROR {conflict['branch']} (push the RESTACK_REF from outside)")
        if f"RESTACK:{conflict['branch']}" in load(BLOCKED, {}):
            return nothing(f"REBASE_CONFLICT {conflict['branch']} (agent failed; resolve by hand, then unblock)")
        return start_restack(conflict)
    # Heads may have moved in restack; read them again before judging threads and CI.
    review = find_review(own([p for p in prs("open") if p["number"] != merged]))
    if review is not None:
        return start_review(review)
    if LAND_ONLY:
        return nothing("LAND_ONLY no new task while the priority programme has work")
    if len(every) >= MAX_OPEN:
        return nothing(f"PAUSED {len(every)} open stack PRs (limit {MAX_OPEN})")
    top_name, top_sha = top
    backlog = backlog_at(top_sha)
    if backlog is None:
        return nothing(f"NO_BACKLOG on {top_name}")
    in_flight = {task_of_branch(p["headRefName"]) for p in every}
    task = pick(backlog, load(BLOCKED, {}), in_flight)
    if task is None:
        return nothing("NOTHING_TO_DO")

    number = next_branch_number(prs("all"))
    save(STATE / "counter.json", number)
    branch = f"{BRANCH_PREFIX}{number:03d}-{task['id'].lower()}"
    worktree = WORKTREES / branch.replace("/", "-")
    shutil.rmtree(worktree, ignore_errors=True)
    git("clone", "--quiet", "--shared", "--no-checkout", str(REPO), str(worktree))
    git("checkout", "--quiet", "-B", branch, top_sha, cwd=worktree)
    current = {
        "task_id": task["id"], "task": task, "branch": branch, "base": top_name,
        "base_sha": top_sha, "worktree": str(worktree), "started": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    save(CURRENT, current)
    print(f"TASK_ID={task['id']}\nBRANCH={branch}\nBASE={top_name}\nWORKTREE={worktree}")
    return 0


def cmd_env() -> int:
    cur = load(CURRENT, None)
    if cur is None:
        return 1
    for key in ("task_id", "branch", "base", "base_sha", "worktree"):
        print(f"{key.upper()}={shlex.quote(cur[key])}")
    print(f"PROGRAM={PROGRAM}")
    print(f"PROGRAM_ROOT={shlex.quote(str(ROOT))}")
    prompt = {"restack": "AGENT_PROMPT.restack.md", "review": "AGENT_PROMPT.review.md",
              "verify": "AGENT_PROMPT.verify.md"}.get(cur["task"].get("type"), P["prompt"])
    print(f"PROMPT_FILE={prompt}")
    print(f"TASK_TYPE={shlex.quote(cur['task'].get('type', 'task'))}")
    print(f"TASK_YAML={shlex.quote(yaml.safe_dump(cur['task'], allow_unicode=True, sort_keys=False))}")
    return 0


GATE_TEST_MAX_SEC = 6 * 3600  # cargo test step; other gate steps keep the 1 h sandbox default.
# With the shared PII/DLP pipeline on main (#268) the step takes ~2 h including the cold build
# (RESTACK:dlp/098-t23, 2026-11-05: 2 h 05 min), but under heavy CPU steal the cold build alone
# ran past 3 h (same run, round 1, no test started). The gate cache rarely survives a round
# (26 GB, under MIN_FREE_GB in run.sh), so every gate pays the cold build.
# 2026-11-08 (REVIEW:dlp/114-d01 round 2, 30-55 % steal): the cold build alone took 217 min of the
# 4 h, so 6 h; ACTIVE_QUIET_HOURS in ark-doctor-check.py follows this limit.
GATE_BUILD_MAX_SEC = 3 * 3600  # clippy, golden eval and the other steps that can start a cold build.
# Clippy (check profile) and the golden eval (dev profile, the test profile differs by opt-level)
# each build the dependency tree from scratch after a cache wipe. Under CPU steal both passed the
# 1 h sandbox default on 2026-11-06 (F-STRUCT rounds 2 and 3), so a correct branch was blocked on
# time alone.


def gate_steps(wt: Path) -> list[tuple[str, list[str], dict]]:
    """(name, command, sandbox options); every step runs sandboxed in the trusted checkout wt."""
    py = str(ROOT / P["eval_venv"] / "bin" / "python")
    gpy = str(GATE_VENV / "bin" / "python")
    build = {"rw": [wt, GATE_TARGET, GATE_HOME, GATE_VENV]}
    gitleaks = program_root("dlp") / "baselines" / "bin" / "gitleaks"
    steps = [
        # First and cheap: GitHub push protection rejects a branch for one literal token in any commit.
        ("plaintext-secrets", ["python3", str(SHARED / "bin" / "secret_check.py"), "--repo", str(wt),
                               "--base", load(CURRENT, {}).get("base_sha", ""), "--head", "HEAD",
                               "--gitleaks", str(gitleaks)], {"rw": [wt], "network": False}),
        ("fmt", [str(CARGO), "fmt", "--all", "--", "--check"], build),
        ("clippy", [str(CARGO), "clippy", "--workspace", "--all-targets", "--", "-D", "warnings"],
         {**build, "max_sec": GATE_BUILD_MAX_SEC}),
        # The following steps mirror .github/workflows/ci.yml (rust and python jobs); GitHub CI on
        # the pushed branch is checked again before a PR is opened (`ark-l1 ci`).
        # The suite grows with every task (26 min on 2026-10-25, 57 min on 2026-10-29 under the
        # 5-CPU quota, over 120 min unoptimised on 2026-11-01); the default 1 h cap would turn every
        # gate red on time alone. A cold gate build plus the full test run also passed 60 minutes.
        # --no-fail-fast: one flaky binary must not hide the rest of the suite (retry_flaky_tests).
        ("test", [str(CARGO), "test", "--no-fail-fast", "-p", "patronus-ark", "-p", "ark-api",
                  "-p", "ark-coordinator", "-p", "ark-distributed-protocol"],
         {**build, "max_sec": GATE_TEST_MAX_SEC}),
        ("golden", ["sh", "-c", f"cd rust && exec {CARGO} run --quiet --locked --example 13_l1_golden_eval -- all"],
         {**build, "max_sec": GATE_BUILD_MAX_SEC}),
        ("python-ext", [gpy, "-m", "maturin", "develop", "--quiet", "--manifest-path", "python/Cargo.toml"],
         {**build, "max_sec": GATE_BUILD_MAX_SEC}),
        ("python-tests", [gpy, "-m", "unittest", "discover", "-s", "python/tests"], build),
        # scripts/tests/entrypoint_peers.py expects the binary in the checkout's target/debug.
        ("ark-api-entrypoint", ["sh", "-c", f"{CARGO} build --locked -p ark-api --bin ark-api-entrypoint && "
                                "mkdir -p target/debug && ln -sf \"$CARGO_TARGET_DIR/debug/ark-api-entrypoint\" "
                                "target/debug/ark-api-entrypoint"],
         {**build, "max_sec": GATE_BUILD_MAX_SEC}),
        ("scripts-tests", [gpy, "-m", "pytest", "scripts/tests", "-q"], build),
        ("docs", ["python3", "scripts/generate_docs.py", "--check"], build),
    ]
    prepare = wt / P["eval_dir"] / "prepare_corpora.py"
    if prepare.exists() and not (HOLDOUT / ".ready").exists():
        # Downloads public corpora and freezes the split; no credentials in the sandbox.
        steps.append(("prepare-corpora", [py, str(prepare), "--dev-out", str(DEV_DATA),
                                          "--holdout-out", str(HOLDOUT)],
                      {"rw": [wt, DEV_DATA, HOLDOUT, CACHE]}))
    favored = HOLDOUT / "presidio_favored"
    # Second source family (E12), frozen once like the neutral split; raw sources stay in the holdout.
    # Only scripts that know --family (not the DLP program's, not branches before E12) get the step.
    if prepare.exists() and "presidio_favored" in prepare.read_text(encoding="utf-8") \
            and not (favored / ".ready").exists():
        steps.append(("presidio-favored-corpora", [py, str(prepare), "--family", "presidio_favored",
                                                   "--dev-out", str(DEV_DATA / "presidio_favored"),
                                                   "--holdout-out", str(favored)],
                      {"rw": [wt, DEV_DATA, HOLDOUT, CACHE]}))
    synth = wt / P["eval_dir"] / "synth_goldset.py"
    # One directory per goldset (E05, GOLD-VAT1, GOLD-VAT2); a branch whose script lacks a goldset skips it.
    for step, goldset, directory in (("synthetic-goldset", None, "synthetic"),
                                     ("synthetic-goldset-vat-1", "vat-1", "synthetic-vat-1"),
                                     ("synthetic-goldset-vat-2", "vat-2", "synthetic-vat-2")):
        if not synth.exists() or (HOLDOUT / directory / ".ready").exists() \
                or (goldset and f'"{goldset}"' not in synth.read_text(encoding="utf-8")):
            continue
        # Once, like prepare-corpora: afterwards agent branches never get write access to the holdout.
        # The secret holdout seed is created in HOLDOUT/<directory>/.seed.
        steps.append((step, [py, str(synth), *(["--goldset", goldset] if goldset else []),
                             "--dev-out", str(DEV_DATA / directory), "--holdout-out", str(HOLDOUT / directory)],
                      {"rw": [DEV_DATA, HOLDOUT], "readable": (wt,), "network": False}))
    external = wt / P["eval_dir"] / "external_content.py"
    if external.exists() and not (DEV_DATA / "external" / ".ready").exists():
        # Dev only (gitleaks Go, SchemaPile SQL): public sources, never part of the holdout.
        steps.append(("external-corpora", [py, str(external), "prepare", "--out", str(DEV_DATA / "external"),
                                           "--sources", str(CACHE / "external_sources")],
                      {"rw": [wt, DEV_DATA, CACHE]}))
    scoreboard = wt / P["eval_dir"] / "scoreboard.py"
    if scoreboard.exists():
        cur = load(CURRENT, {})
        # The only step that reads the holdout: no network, writes only to the private cache.
        # It builds the release module of head and base and predicts every split uncached for a new
        # base; under CPU steal that passed the 1 h sandbox default (RESTACK:dlp/114-d01 round 1,
        # 2026-11-07: builds 6 + 21 min, predictions 24 min, stopped at 3604 s), usually 2-14 min.
        steps.append(("scoreboard", [py, str(scoreboard), "gate", "--head", str(wt),
                                     "--base-sha", cur.get("base_sha", ""), "--dev", str(DEV_DATA),
                                     "--holdout", str(HOLDOUT), "--cache", str(CACHE)],
                      {"rw": [CACHE], "readable": (HOLDOUT, wt), "network": False,
                       "max_sec": GATE_BUILD_MAX_SEC}))
    return steps


def failure_output(proc: subprocess.CompletedProcess, timed_out: bool, elapsed: float, max_sec: int) -> str:
    """Tail of a failed gate step: stdout and stderr each, so cargo's test failures on stdout
    are not pushed out by its `Running ...` lines on stderr; a sandbox timeout is named."""
    parts = []
    if timed_out:
        parts.append(f"TIMEOUT: the step was stopped after {int(elapsed)} s (limit {max_sec} s); "
                     "this is not a test failure in the output below")
    if proc.stdout.strip():
        parts.append("--- stdout (tail) ---\n" + proc.stdout.strip()[-4000:])
    if proc.stderr.strip():
        parts.append("--- stderr (tail) ---\n" + proc.stderr.strip()[-2500:])
    return "\n".join(parts)


# The ark-coordinator orchestrator tests assert wall-clock deadlines (150-500 ms) and fail now and then
# on this host under CPU steal (REVIEW:dlp/114-d01, 2026-11-08: two gates red on them while CI was green
# on the same code). Without --no-fail-fast that also skipped every patronus-ark binary. A failed test
# gets one rerun of exactly the failed tests; a test that fails twice, a crashed binary or a target
# without a FAILED test line stays red.
FAILED_TEST = re.compile(r"^test (\S+) \.\.\. FAILED$", re.M)
FAILED_TARGET = re.compile(r"`(-p [\w-]+ (?:--lib|--doc|--bins?(?: [\w-]+)?|--test [\w-]+))`")
TEST_RESULT = re.compile(r"^test result: (\w+)\. (\d+) passed; (\d+) failed", re.M)


def failed_tests(proc: subprocess.CompletedProcess) -> tuple[list[str], list[str]]:
    """(failed test names, failed cargo targets as rerun arguments) of a `cargo test` run."""
    names = sorted(set(FAILED_TEST.findall(proc.stdout)))
    targets = list(dict.fromkeys(FAILED_TARGET.findall(proc.stderr)))
    return names, targets


FAILURE_BLOCK = re.compile(r"^failures:\n\n(.*?)^failures:$", re.M | re.S)


def test_failure_summary(proc: subprocess.CompletedProcess) -> str:
    """Failed tests, targets and panic messages first: with --no-fail-fast the output tail usually
    shows only the binaries that ran after the failure."""
    names, targets = failed_tests(proc)
    if not names and not targets:
        return ""
    blocks = "\n".join(b.strip() for b in FAILURE_BLOCK.findall(proc.stdout))
    return (f"--- failed tests: {', '.join(names) or '?'}\n--- failed targets: {', '.join(targets) or '?'}\n"
            + (blocks[:4000] + "\n" if blocks else ""))


def retry_flaky_tests(cmd: list[str], tree: Path, opts: dict, max_sec: int,
                      proc: subprocess.CompletedProcess) -> tuple[bool, str]:
    """Rerun the failed tests of a red `cargo test` step once, target by target with --exact.
    (True, summary) when every failed test passed on its rerun; (False, summary) otherwise."""
    names, targets = failed_tests(proc)
    if not names or not targets:
        return False, "no rerun: no failed test names or targets in the output"
    passed: set[str] = set()
    notes = []
    for target in targets:
        rerun = [cmd[0], "test", *shlex.split(target), "--", "--exact", *names]
        retry = sandbox(rerun, tree, opts["rw"], gate_env(), network=opts.get("network", True),
                        readable=opts.get("readable", ()), max_sec=max_sec)
        results = TEST_RESULT.findall(retry.stdout)
        ran = sum(int(p) + int(f) for _, p, f in results)
        ok = retry.returncode == 0 and ran > 0 and all(r == "ok" for r, _, _ in results)
        notes.append(f"`{target}`: exit {retry.returncode}, {ran} test(s) rerun")
        if not ok:
            return False, "rerun failed: " + "; ".join(notes)
        passed.update(re.findall(r"^test (\S+) \.\.\. ok$", retry.stdout, re.M))
    missing = [n for n in names if n not in passed]
    if missing:
        return False, "rerun did not pass " + ", ".join(missing) + ": " + "; ".join(notes)
    return True, "passed on rerun: " + ", ".join(names) + " (" + "; ".join(notes) + ")"


def gate_env() -> dict[str, str]:
    # Test binaries at opt-level 1 (debug assertions and overflow checks stay on): the unoptimised
    # suite grew from ~22 to over 120 minutes (2026-11-01); opt-level 1 runs the slow regex-heavy
    # test binaries about 6x faster. Only the `test` profile changes; run.sh sets it for the agent too.
    return {"CARGO_TARGET_DIR": str(GATE_TARGET), "CARGO_HOME": str(GATE_HOME / "cargo"),
            "XDG_CACHE_HOME": str(GATE_HOME / "cache"), "VIRTUAL_ENV": str(GATE_VENV),
            "PIP_NO_CACHE_DIR": "1", "CARGO_PROFILE_TEST_OPT_LEVEL": "1",
            # Small target dirs: line tables keep backtraces; the gate builds each commit once.
            "CARGO_PROFILE_DEV_DEBUG": "line-tables-only", "CARGO_PROFILE_TEST_DEBUG": "line-tables-only",
            "CARGO_INCREMENTAL": "0"}


def import_agent_commits(cur: dict) -> str | None:
    """Bundle the agent branch inside the sandbox and fetch the bundle into the trusted repository."""
    bundle = TRANSFER / "agent.bundle"
    bundle.unlink(missing_ok=True)
    proc = agent_git(Path(cur["worktree"]), "bundle", "create", "--quiet", str(bundle),
                     f"{cur['base_sha']}..HEAD")
    if proc.returncode != 0 or not bundle.exists():
        return None
    ref = f"refs/ark/{PROGRAM}/gate"
    git("fetch", "--quiet", "--no-tags", str(bundle), f"+HEAD:{ref}")
    bundle.unlink(missing_ok=True)
    return sha(ref)


def cmd_ahead() -> int:
    cur = load(CURRENT, None)
    if cur is None:
        print(0)
        return 1
    proc = agent_git(Path(cur["worktree"]), "rev-list", "--count", f"{cur['base_sha']}..HEAD")
    print(proc.stdout.strip() if proc.returncode == 0 else 0)
    return 0


def cmd_stale() -> int:
    """Drop a review/restack run whose PR branch changed on GitHub under it.

    `ci` only noticed this at the final push, after every agent round and gate: twice on
    2026-11-08 a person merged main into dlp/114-d01 (and then merged the PR) during a run, which
    then spent its three rounds (about 5 h each) on a stale head. run.sh asks before each agent
    round and each gate. A lookup error is not stale: the run goes on and `ci` decides."""
    cur = load(CURRENT, None)
    if cur is None or cur["task"].get("type") not in ("review", "restack"):
        return 1
    expected = {h for h in (cur["task"].get("old_head"), cur.get("review_pushed")) if h}
    try:
        remote = git("ls-remote", "origin", f"refs/heads/{cur['branch']}").split("\t")[0].strip()
    except RuntimeError as err:
        print(f"WARN=stale check failed: {str(err).strip()[-300:]}")
        return 1
    if remote in expected:
        return 1
    now = f"now {remote[:12]}" if remote else "deleted (PR merged or closed)"
    print(f"STALE_RUN={cur['task_id']}: {cur['branch']} is {now}; run dropped")
    drop_worktree(cur)
    return 0


def cmd_gate() -> int:
    cur = load(CURRENT, None)
    if cur is None:
        print("no current run")
        return 1
    report = STATE / "gate-report.md"
    lines = [f"# Gate {cur['task_id']} ({cur['branch']})", ""]
    ok = True
    status = agent_git(Path(cur["worktree"]), "status", "--porcelain")
    dirty = status.stdout.strip() if status.returncode == 0 else f"git status failed: {status.stderr[-500:]}"
    commit = import_agent_commits(cur)
    if dirty:
        lines.append("- ❌ uncommitted changes (only committed work is gated):\n```\n" + dirty[:2000] + "\n```")
        ok = False
    if commit is None or commit == cur["base_sha"]:
        lines.append("- ❌ no commits on the branch")
        ok = False
    elif subprocess.run(["git", *GIT_SAFE, "merge-base", "--is-ancestor", cur["base_sha"], commit],
                        cwd=REPO).returncode != 0:
        lines.append(f"- ❌ branch does not build on its base {cur['base_sha'][:12]}")
        ok = False
    if ok:
        # Writable sandbox paths must exist, or systemd silently leaves them read-only.
        for d in (GATE_TARGET, GATE_HOME / "cargo", GATE_HOME / "cache", CACHE, TRANSFER):
            d.mkdir(parents=True, exist_ok=True)
        tree = GATE_TREES / "current"
        shutil.rmtree(tree, ignore_errors=True)
        git("worktree", "prune")
        git("worktree", "add", "--quiet", "--detach", str(tree), commit)
        try:
            for name, cmd, opts in gate_steps(tree):
                max_sec = opts.get("max_sec", 3600)
                started = time.monotonic()
                proc = sandbox(cmd, tree, opts["rw"], gate_env(), network=opts.get("network", True),
                               readable=opts.get("readable", ()), max_sec=max_sec)
                elapsed = time.monotonic() - started
                if proc.returncode != 0 and name == "test" and elapsed < max_sec - 5:
                    flaky, summary = retry_flaky_tests(cmd, tree, opts, max_sec, proc)
                    print(f"GATE_TEST_RERUN={'pass' if flaky else 'fail'} {summary}")
                    if flaky:
                        lines.append(f"- ✅ {name} (flaky, {summary})")
                        continue
                if proc.returncode == 0:
                    tail = proc.stdout.strip().splitlines()[-15:] if name == "scoreboard" else []
                    lines.append(f"- ✅ {name}" + ("\n```\n" + "\n".join(tail) + "\n```" if tail else ""))
                else:
                    # The scoreboard reads the holdout: report its exit code, never its output. The
                    # failed checks come from the stored results, summarised by runner code.
                    timed_out = elapsed >= max_sec - 5
                    out = scoreboard_regressions(commit, cur["base_sha"]) if name == "scoreboard" \
                        else failure_output(proc, timed_out, elapsed, max_sec)
                    if name == "test" and not timed_out:
                        out = test_failure_summary(proc) + out
                    result = f"timeout {int(elapsed)} s" if timed_out else f"exit {proc.returncode}"
                    lines.append(f"- ❌ {name} ({result}): `{shlex.join(cmd)}`\n```\n{out}\n```")
                    ok = False
                    break
        finally:
            shutil.rmtree(tree, ignore_errors=True)
            git("worktree", "prune", check=False)
    if ok:
        cur["gated_commit"] = commit
        save(CURRENT, cur)
    report.write_text("\n".join(lines) + "\n")
    print(report.read_text())
    return 0 if ok else 1


# Identifiers that may leave the holdout through the gate report: gated bucket, check, entity and
# rule ids, each with a strict pattern so an agent-controlled scoreboard cannot smuggle holdout text
# into the report through names. Values are numbers only.
GATED_BUCKET = re.compile(r"all|language/(de|en)|entity/(pii|entity)(\.[a-z0-9_]{1,32}){1,3}|family/[a-z0-9_]{1,32}")
ENTITY_ID = re.compile(r"(pii|entity)(\.[a-z0-9_]{1,32}){1,3}")
DLP_CHECK = re.compile(r"[a-z0-9_.]{1,32}(:[A-Za-z0-9_.]{1,64}){1,2}")
DLP_RULE = re.compile(r"dlp_[a-z0-9_]{1,64}")
SCOREBOARD_TOLERANCE_PP = 0.5
SCOREBOARD_MAX_LINES = 20


def _f1(hits: int, predicted: int, found: int, gold: int) -> tuple[float, float, float]:
    precision = hits / predicted if predicted else 1.0
    recall = found / gold if gold else 1.0
    return precision, recall, (2 * precision * recall / (precision + recall) if precision + recall else 0.0)


def _num(value) -> str:
    """A number for the gate report; anything else (text from a report) is withheld."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return "?"
    return str(value) if isinstance(value, int) else f"{value:.4g}"


def scoreboard_regressions(head: str, base: str) -> str:
    """The failed checks of a red scoreboard gate, summarised by runner code from what the gate stored.

    Aggregates only: split, check, bucket/entity/rule ids and base → head numbers. Never holdout
    text, values, spans, row ids, document or file names, so the next agent round learns which
    check failed without seeing holdout data.
    """
    try:
        lines = _dlp_failed_checks(head, base) if PROGRAM == "dlp" else _pii_failed_checks(head, base)
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return "(stored scoreboard results unreadable)"
    if lines is None:
        return "(no stored scoreboard results for head and base; infrastructure error or crash)"
    if not lines:
        return "(no failed check in the stored results; infrastructure error or crash)"
    more = len(lines) - SCOREBOARD_MAX_LINES
    return ("Failed scoreboard checks (aggregates only, no holdout data):\n"
            + "\n".join(lines[:SCOREBOARD_MAX_LINES]) + (f"\n… {more} more" if more > 0 else ""))


def _pii_failed_checks(head: str, base: str) -> list[str] | None:
    """Regressed gated buckets and new hard-negative FP per entity, from CACHE/scoreboard/results
    (scoreboard.py `compare` over the per-commit results the gate stored)."""
    results = CACHE / "scoreboard" / "results"
    try:
        sides = [json.loads((results / f"{sha}.json").read_text())["modes"] for sha in (base, head)]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    lines = []
    for mode in sorted(sides[1]):
        for split in sorted(sides[1][mode]):
            before = sides[0].get(mode, {}).get(split, {})
            after = sides[1][mode][split]
            keys = set(before.get("buckets", {})) | set(after.get("buckets", {}))
            for key in sorted(k for k in keys if GATED_BUCKET.fullmatch(k)):
                b, a = before["buckets"].get(key), after["buckets"].get(key)
                if not b or not a:
                    continue
                for metric, fields in (("exact", ("exact", "predicted", "exact", "gold")),
                                       ("overlap", ("predicted_correct", "predicted", "gold_found", "gold"))):
                    pb, rb, fb = _f1(*(int(b[f]) for f in fields))
                    pa, ra, fa = _f1(*(int(a[f]) for f in fields))
                    delta = (fa - fb) * 100
                    if delta < -SCOREBOARD_TOLERANCE_PP - 1e-9:
                        lines.append(f"- {mode} {split} f1 {key} {metric}: {fb * 100:.1f} → {fa * 100:.1f} % "
                                     f"({delta:+.1f} pp; precision {(pa - pb) * 100:+.1f} pp, "
                                     f"recall {(ra - rb) * 100:+.1f} pp; gold {int(a['gold'])})")
            old = {json.dumps(x) for x in before.get("hard_negative_fp", [])}
            new = [x for x in after.get("hard_negative_fp", []) if json.dumps(x) not in old]
            if new:
                # Items are [dataset, row id, entity, start, end]: only the entity id is reported.
                per_entity: dict[str, int] = {}
                for item in new:
                    entity = item[2] if isinstance(item[2], str) and ENTITY_ID.fullmatch(item[2]) else "(other id)"
                    per_entity[entity] = per_entity.get(entity, 0) + 1
                lines.append(f"- {mode} {split} hard_negatives:new_fp: {len(new)} new (HN-FP {len(old)} → "
                             f"{len(after.get('hard_negative_fp', []))}): "
                             + ", ".join(f"{k} {v}" for k, v in sorted(per_entity.items())))
    return lines


def _dlp_failed_checks(head: str, base: str) -> list[str] | None:
    """The `ok: false` checks of scoreboard.py `compare`, from CACHE/scoreboard/reports/<head>-<base>/,
    with the per-rule FP counts behind a failed benign FP check."""
    reports = CACHE / "scoreboard" / "reports" / f"{head[:12]}-{base[:12]}"
    lines, found = [], False
    for split in ("dev", "holdout"):
        path = reports / f"{split}.json"
        if not path.is_file():
            continue
        found = True
        report = json.loads(path.read_text())
        for check in report["checks"]:
            if check.get("ok") is not False:
                continue
            name = check.get("check")
            name = name if isinstance(name, str) and DLP_CHECK.fullmatch(name) else "(unnamed check)"
            detail = []
            if "delta_pp" in check:
                detail.append(f"{_num(check['delta_pp'])} pp, gold {_num(check.get('gold'))}")
            if isinstance(check.get("new"), list):
                detail.append(f"{len(check['new'])} new")
            for bound in ("limit", "budget"):
                if bound in check:
                    detail.append(f"{bound} {_num(check[bound])}")
            lines.append(f"- {split} {name}: {_num(check.get('base'))} → {_num(check.get('head'))}"
                         + (f" ({'; '.join(detail)})" if detail else ""))
            corpus = {"fp:benign_code": ("benign_code",), "fp:benign_docs": ("benign_docs", "default")}.get(name)
            if corpus:
                sides = []
                for side in ("base", "head"):
                    node = report[side]
                    for part in corpus:
                        node = node.get(part) or {}
                    sides.append(node.get("by_rule") or {})
                for rule in sorted(set(sides[1]) | set(sides[0])):
                    b, h = (s.get(rule, {}).get("fp", 0) for s in sides)
                    if DLP_RULE.fullmatch(rule) and _num(h) != "?" and _num(b) != "?" and h > b:
                        lines.append(f"  - rule {rule}: {b} → {h} FP")
    return lines if found else None


def done_commit(commit: str, task: dict) -> str:
    """Commit the task's `status: done` on top of commit without any checkout."""
    text = git_raw("show", f"{commit}:{BACKLOG}")
    tasks = (yaml.safe_load(text) or {}).get("tasks", [])
    if any(t["id"] == task["id"] and t.get("status") == "done" for t in tasks):
        return commit
    blob = git_raw("hash-object", "-w", "--stdin", stdin=mark_done_text(text, task["id"])).strip()
    with tempfile.TemporaryDirectory() as tmp:
        env = {"GIT_INDEX_FILE": str(Path(tmp) / "index")}
        git_raw("read-tree", commit, env=env)
        git_raw("update-index", "--cacheinfo", f"100644,{blob},{BACKLOG}", env=env)
        tree = git_raw("write-tree", env=env).strip()
    return git_raw("commit-tree", tree, "-p", commit, "-m",
                   f"chore({PROGRAM}): mark {task['id']} done").strip()


CI_REQUIRED = {"rust", "python"}     # jobs of .github/workflows/ci.yml that must be among the checks
CI_TIMEOUT = 150 * 60                # the rust job took 102-103 min on 2026-11-03 (#246); 75 min
                                     # timed out every task and left its run to a resume
CI_POLL = 60
CI_CONFLICT_POLLS = 10               # polls between conflict checks while required checks are missing
OK_CONCLUSIONS = {"success", "skipped", "neutral"}
# The ARK API image job: main's ruleset does not require it and it flakes on toolchain installs.
# Agents cannot fix it either (workflow files are outside the runner token's scope).
CI_NON_BLOCKING = {"validate"}


def publish_head(cur: dict) -> str:
    """The PR head for the gated commit, built once: commit-tree stamps the time, so building it
    again on a resumed run would give a new SHA, lose the green-CI record and push again."""
    task = cur["task"]
    cached = cur.get("publish_commit")
    if cached and "publish_of" not in cur:
        # State from a runner before publish_of: the head belongs to the gated commit when it is
        # that commit (triage) or the done commit right on top of it.
        parent = git("rev-parse", "--verify", "--quiet", f"{cached}^", check=False)
        if cached == cur["gated_commit"] or parent == cur["gated_commit"]:
            cur["publish_of"] = cur["gated_commit"]
    if cached and cur.get("publish_of") == cur["gated_commit"]:
        return cached
    head = (cur["gated_commit"] if task.get("type") in ("triage", "review", "restack")
            else done_commit(cur["gated_commit"], task))
    cur["publish_commit"], cur["publish_of"] = head, cur["gated_commit"]
    return head


def push_error_reason(err: Exception) -> str:
    """The lines of a failed push that say why (`! [remote rejected] ... (reason)`, `remote: error`,
    `stale info`); git's last line alone ("failed to push some refs") hides the cause."""
    lines = [line.strip() for line in str(err).splitlines() if line.strip()]
    why = [line for line in lines
           if line.startswith("!") or "rejected" in line or "stale info" in line
           or line.startswith(("remote: error", "error: src refspec", "fatal:"))]
    return " | ".join(why[:4])[:600] if why else (lines[-1] if lines else str(err))


def push_protection_hits(err: Exception) -> list[str]:
    """`rule: commit path:line` for each secret GitHub push protection reported in a rejected push
    (GH013, "Push cannot contain secrets"); empty for any other rejection. Unblock URLs are left out:
    allowing a secret is a person's decision, the agent removes the literal instead."""
    text = str(err)
    if "GH013" not in text or "Push cannot contain secrets" not in text:
        return []
    hits, rule, commit = [], "", ""
    for line in text.splitlines():
        line = line.removeprefix("remote:").strip()
        if match := re.fullmatch(r"—— (.+?) —+", line):
            rule = match.group(1)
        elif line.startswith("- commit:"):
            commit = line.split(":", 1)[1].strip()[:12]
        elif line.startswith("path:") and rule:
            hits.append(f"{rule}: {commit} {line.split(':', 1)[1].strip()}")
    return hits or ["(push protection named no location)"]


def ci_failure_log(head: str) -> str:
    """Tail of the failed job logs of the CI runs on head, for the agent's next round."""
    runs = json.loads(run(["gh", "run", "list", "--repo", GH_REPO, "--commit", head, "--json",
                           "databaseId,conclusion,name"], check=False) or "[]")
    out = []
    for r in runs:
        if r.get("conclusion") not in OK_CONCLUSIONS:
            log = run(["gh", "run", "view", str(r["databaseId"]), "--repo", GH_REPO, "--log-failed"], check=False)
            out.append(f"### {r['name']} ({r.get('conclusion')})\n{log[-5000:]}")
    return "\n".join(out)[-9000:]


def rebase_onto_main(cur: dict) -> int:
    """Replay the gated task commits onto the current origin/main and push them for CI.

    The local gate ran on the old base; GitHub CI on the rebased head still decides before any PR.
    A conflicting replay drops the run without blocking: the next run redoes the task on main."""
    git("fetch", "--quiet", "--prune", "origin")
    onto = sha("origin/main")
    if onto == cur["base_sha"]:
        print(f"PUBLISH_ERROR=push refused for .github/workflows although {cur['task_id']} changes none "
              f"and its base is main; needs a person")
        return 3
    # `ci` runs without the run lock: rebase in a private checkout, not in the shared clone.
    tree = GATE_TREES / "rebase"
    shutil.rmtree(tree, ignore_errors=True)
    git("worktree", "prune")
    git("worktree", "add", "--quiet", "--detach", str(tree), cur["gated_commit"])
    try:
        proc = subprocess.run(["git", *GIT_SAFE, "rebase", "--quiet", "--onto", onto, cur["base_sha"]],
                              cwd=tree, text=True, capture_output=True)
        if proc.returncode != 0:
            git("rebase", "--abort", cwd=tree, check=False)
        gated = git("rev-parse", "HEAD", cwd=tree) if proc.returncode == 0 else ""
    finally:
        shutil.rmtree(tree, ignore_errors=True)
        git("worktree", "prune", check=False)
    if not gated:
        print(f"PUBLISH_ERROR={cur['task_id']} is behind a .github/workflows change on main and does "
              f"not rebase onto {onto[:12]} cleanly; run dropped, the task stays selectable")
        drop_worktree(cur)
        return 3
    git("update-ref", f"refs/ark/{PROGRAM}/gate", gated)
    print(f"REBASED={cur['branch']} onto main {onto[:12]} (behind a .github/workflows change): "
          f"{cur['gated_commit'][:12]} → {gated[:12]}")
    for key in ("publish_commit", "publish_of", "ci_green"):
        cur.pop(key, None)
    cur["base_sha"], cur["gated_commit"] = onto, gated
    save(CURRENT, cur)
    return cmd_ci()


def pr_conflicts_with_main(cur: dict, head: str) -> bool:
    """True for a review/restack run on a main-based PR whose head no longer merges into origin/main."""
    if cur["task"].get("type") not in ("review", "restack") or cur.get("base", "main") != "main":
        return False
    try:
        git("fetch", "--quiet", "origin", "main")
        return conflicts_with(sha("origin/main"), head)
    except RuntimeError as err:
        print(f"WARN=conflict check failed: {str(err).strip()[-300:]}")
        return False


def cmd_ci() -> int:
    """Push the would-be PR head to the branch (no PR yet) and wait for GitHub CI on it.

    Exit 0 = green (publish may open a ready PR), 1 = red (report in gate-report.md for the next
    round), 3 = no verdict (timeout, missing checks, GitHub error): the run stays resumable."""
    cur = load(CURRENT, None)
    if cur is None or not cur.get("gated_commit"):
        print("no gated run to check")
        return 3
    head = publish_head(cur)
    cur["publish_commit"] = head
    save(CURRENT, cur)
    if cur.get("ci_green") == head:
        print(f"CI=green {head[:12]} (cached)")
        return 0
    try:
        if cur["task"].get("type") in ("review", "restack"):
            # The PR branch exists; fast-forward it, but never over a push made in the meantime
            # (a server-side stack rebase after a merge below, or a person). The lease follows our own
            # last push: after a red round the branch sits at that fix, not at the original PR head.
            lease = cur.get("review_pushed") or cur["task"]["old_head"]
            if cur.get("review_pushed") != head:
                git("push", "--quiet", f"--force-with-lease=refs/heads/{cur['branch']}:{lease}",
                    "origin", f"{head}:refs/heads/{cur['branch']}")
                cur["review_pushed"] = head
                save(CURRENT, cur)
        else:
            git("push", "--quiet", "origin", f"+{head}:refs/heads/{cur['branch']}")
    except RuntimeError as err:
        if cur["task"].get("type") in ("review", "restack"):
            remote = git("ls-remote", "origin", f"refs/heads/{cur['branch']}", check=False).split("\t")[0]
            if remote and remote not in (lease, head):
                # The PR branch moved since this run started: its fix is stale and the push can never
                # succeed. Drop the run; the next `next` looks at the PR again from its new head.
                print(f"STALE_RUN={cur['task_id']}: {cur['branch']} is now {remote[:12]}; run dropped")
                drop_worktree(cur)
                return 3
        if cur["task"].get("type") in ("review", "restack") and workflow_refusal(err, cur["base_sha"], head) \
                and (synced := with_main_workflows(head)) != head:
            # Main changed a workflow after the run's base (RESTACK:dlp/098-t23, 2026-11-06): push the
            # gated commit with main's workflow files on top; the gated code is unchanged.
            try:
                git("push", "--quiet", f"--force-with-lease=refs/heads/{cur['branch']}:{lease}",
                    "origin", f"{synced}:refs/heads/{cur['branch']}")
            except RuntimeError as sync_err:
                print(f"PUBLISH_ERROR=push with main's .github/workflows failed: {push_error_reason(sync_err)}")
                return 3
            print(f"WORKFLOW_SYNC={cur['branch']} {head[:12]} → {synced[:12]} (main's .github/workflows on top)")
            cur["gated_commit_before_workflow_sync"] = cur["gated_commit"]
            cur["gated_commit"] = cur["publish_commit"] = cur["publish_of"] = cur["review_pushed"] = synced
            save(CURRENT, cur)
            head = synced
        else:
            if "workflow" in str(err) and cur["task"].get("type") not in ("review", "restack"):
                if not git("diff", "--name-only", cur["base_sha"], cur["gated_commit"], "--",
                           ".github/workflows"):
                    # GitHub checks a new branch against main: a branch cut before a workflow change
                    # landed on main "reverts" it and is refused, although the task never touched one.
                    return rebase_onto_main(cur)
                # The token may not push .github/workflows changes; retrying the same task loops forever.
                print(f"PUBLISH_ERROR=push touches .github/workflows, which the runner token cannot push")
                cmd_block(cur["task_id"], "fix changes .github/workflows; needs a person")
                return 3
            if hits := push_protection_hits(err):
                # The same commits are rejected on every retry; only a new agent round can remove the
                # literal, so this counts as red (T18 resumed 3 times on the same GH013, 2026-10-28).
                (STATE / "gate-report.md").write_text(
                    f"# GitHub push protection {cur['task_id']} ({cur['branch']} @ {head[:12]})\n\n"
                    f"- ❌ GitHub rejected the push: plaintext secrets in commits of the branch. The local\n"
                    f"  plaintext-secrets step did not know these formats. Remove the literal from every commit\n"
                    f"  of the branch (rewrite the commits; goldens as generator recipes, test values assembled\n"
                    f"  at test time):\n" + "".join(f"  - {h}\n" for h in hits))
                print((STATE / "gate-report.md").read_text())
                print(f"PUBLISH_ERROR=push protection: {'; '.join(hits)[:500]}")
                return 1
            print(f"PUBLISH_ERROR={push_error_reason(err)}")
            return 3
    print(f"== waiting for GitHub CI on {cur['branch']} @ {head[:12]}")
    deadline = dt.datetime.now() + dt.timedelta(seconds=CI_TIMEOUT)
    checks: list[dict] = []
    rerun_at = ""  # UTC timestamp of a CI restart, in GitHub's format
    polls = 0
    while dt.datetime.now() < deadline:
        subprocess.run(["sleep", str(CI_POLL)])
        polls += 1
        try:
            checks = check_runs(head)
        except (RuntimeError, ValueError, KeyError) as err:
            print(f"WARN=check-runs not readable: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
            continue
        names = {c["name"] for c in checks}
        if not CI_REQUIRED <= names and polls % CI_CONFLICT_POLLS == 1 and pr_conflicts_with_main(cur, head):
            # GitHub starts no pull_request runs for a PR that conflicts with its base, so this wait
            # can never end (#287: its CI retrigger landed 4 min after #284 made it conflict, two
            # 150-min waits on CodeQL only, 2026-11-06). Drop the run: the branch already holds
            # the pushed fix, and the next `next` restacks it onto main.
            print(f"CI=conflict {head[:12]}: {cur['branch']} conflicts with main, GitHub runs no PR CI; "
                  f"run dropped, the next run restacks it")
            drop_worktree(cur)
            return 3
        if not CI_REQUIRED <= names or any(c["status"] != "completed" for c in checks):
            continue
        failed = [c["name"] for c in checks
                  if c["conclusion"] not in OK_CONCLUSIONS and c["name"] not in CI_NON_BLOCKING]
        if failed and rerun_at and any((c.get("completed_at") or "") < rerun_at for c in checks
                                       if c["name"] in failed):
            continue  # the restart has not replaced the failed check runs yet
        pr_branch = cur["branch"] if cur["task"].get("type") in ("review", "restack") else None
        restarted = rerun_infra_failures(head, pr_branch, None if pr_branch else cur) if failed else None
        if restarted == NO_RESTART:
            # Red would cost an agent round and finally block gate-green work (T18 after round 3,
            # 2026-10-28). No verdict: the run stays resumable, a person restarts the failed jobs.
            print(f"CI=no_verdict {head[:12]}: runner failure in {', '.join(failed)}; CI could not be "
                  f"restarted, rerun the failed jobs by hand")
            return 3
        if restarted:
            # A runner or download failure is no verdict on the code; before, it went back to the agent
            # as red CI, or blocked a resumed run (T18, 2026-10-28). Wait for the restart in full.
            if restarted != head:
                # An empty retrigger commit with the gated tree: it is what publish lands now.
                head = restarted
                cur["gated_commit"] = cur["publish_commit"] = cur["publish_of"] = head
                cur["review_pushed"] = head
                save(CURRENT, cur)
                print(f"== waiting for GitHub CI on {cur['branch']} @ {head[:12]}")
            rerun_at = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            deadline = dt.datetime.now() + dt.timedelta(seconds=CI_TIMEOUT)
            continue
        report = STATE / "gate-report.md"
        if not failed:
            cur["ci_green"] = head
            save(CURRENT, cur)
            if report.exists():
                report.write_text(report.read_text() + f"- ✅ GitHub CI ({', '.join(sorted(names))})\n")
            print(f"CI=green {head[:12]}")
            return 0
        report.write_text(
            f"# GitHub CI {cur['task_id']} ({cur['branch']} @ {head[:12]})\n\n"
            f"- ❌ GitHub CI red: {', '.join(failed)}. The local gate was green, so the failing step is not\n"
            f"  mirrored locally; reproduce it like .github/workflows/ci.yml does.\n```\n{ci_failure_log(head)}\n```\n")
        print(report.read_text())
        print(f"CI=red {', '.join(failed)}")
        return 1
    print(f"CI=timeout after {CI_TIMEOUT // 60} min; checks: "
          + ", ".join(f"{c['name']}:{c['status']}/{c.get('conclusion')}" for c in checks))
    return 3


def cmd_publish() -> int:
    cur = load(CURRENT, None)
    if cur is None or not cur.get("gated_commit"):
        print("no gated run to publish")
        return 1
    task = cur["task"]
    if task.get("type") == "restack":
        return publish_restack(cur)
    if task.get("type") == "review":
        return publish_review(cur)
    head = publish_head(cur)
    if cur.get("ci_green") != head:
        # Rule: no PR without green GitHub CI on exactly the commit the PR shows.
        print(f"PUBLISH_ERROR=GitHub CI not green on {head[:12]} (run `ark-l1 ci` first)")
        return 1
    if task.get("type") == "triage":
        (STATE / f"triage-{task['week']}").write_text(dt.datetime.now(dt.timezone.utc).isoformat() + "\n")
        (STATE / "triage-now").unlink(missing_ok=True)
    cur["publish_commit"] = head
    save(CURRENT, cur)
    git("push", "--quiet", "origin", f"+{head}:refs/heads/{cur['branch']}")
    report = (STATE / "gate-report.md").read_text() if (STATE / "gate-report.md").exists() else ""
    body = "\n".join([
        f"Scheduled {P['name']} run, backlog task **{task['id']}**: {task.get('title', '')}",
        "",
        f"Stacked on `{cur['base']}`. One task per run; see `{P['readme']}`.",
        "",
        "```yaml",
        yaml.safe_dump(task, allow_unicode=True, sort_keys=False).strip(),
        "```",
        "",
        report,
        "",
        "🤖 Generated with [Claude Code](https://claude.com/claude-code)",
    ])
    existing = json.loads(run(["gh", "pr", "list", "--repo", GH_REPO, "--head", cur["branch"],
                               "--state", "open", "--json", "url"]))
    if existing:
        url = existing[0]["url"]
    else:
        # Ready for review, not a draft: only green, finished work reaches this point.
        url = run(["gh", "pr", "create", "--repo", GH_REPO, "--base", cur["base"],
                   "--head", cur["branch"], "--label", LABEL,
                   "--title", f"{P['title']} {task['id']}: {task.get('title', '')}"[:250], "--body", body])
    stack = load(STACK, {})
    stack[cur["branch"]] = {"base": cur["base"], "base_sha": cur["base_sha"]}
    save(STACK, stack)
    drop_worktree(cur)
    print(f"PR={url}")
    try:
        number = int(url.rstrip("/").rsplit("/", 1)[-1])
        land(number, head)
    except (RuntimeError, ValueError) as err:
        print(f"WARN=landing {url} failed: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
    return 0


def publish_restack(cur: dict) -> int:
    """Replace the conflicting branch with the gated rebase; the next `next` restacks the branches above."""
    task, branch, head = cur["task"], cur["branch"], cur["gated_commit"]
    if cur.get("ci_green") != head:
        # `ci` pushed the rebase (lease on the head it started from) and waits for GitHub CI.
        print(f"PUBLISH_ERROR=GitHub CI not green on {head[:12]} (run `ark-l1 ci` first)")
        return 1
    stack = load(STACK, {})
    stack[branch] = {"base": task["onto_name"], "base_sha": task["onto"]}
    save(STACK, stack)
    drop_worktree(cur)
    print(f"RESTACKED={branch}\nPR={task['pr']}")
    try:
        # Merge the rebased PR in this run instead of leaving it to a later auto-merge, before main
        # moves again; open review threads keep it open for a REVIEW run.
        land(int(task["pr"].rstrip("/").rsplit("/", 1)[-1]), head, wait_for_codex=False)
    except (RuntimeError, ValueError) as err:
        print(f"WARN=landing {task['pr']} failed: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
    return 0


def review_notes(cur: dict) -> dict:
    """Per-thread notes the agent left in its clone (`.git/ark-review.json`, thread id -> text).

    Untrusted agent output: only short plain strings for known thread ids are used."""
    path = Path(cur["worktree"]) / ".git" / "ark-review.json"
    try:
        notes = json.loads(path.read_text()) if path.is_file() and path.stat().st_size < 64_000 else {}
    except (OSError, ValueError):
        return {}
    if not isinstance(notes, dict):
        return {}
    known = {t["id"] for t in cur["task"].get("threads", [])}
    return {k: public_text(v.strip()[:1500]) for k, v in notes.items()
            if k in known and isinstance(v, str) and v.strip()}


def publish_review(cur: dict) -> int:
    """The fix is on the PR branch (pushed by `ci`, CI green): answer and resolve every thread."""
    task, head = cur["task"], cur["gated_commit"]
    if cur.get("ci_green") != head:
        print(f"PUBLISH_ERROR=GitHub CI not green on {head[:12]} (run `ark-l1 ci` first)")
        return 1
    notes = review_notes(cur)
    # Per-thread progress survives a failed GitHub call: the retry neither posts a reply twice nor
    # drops the state (and with it the promised answer) before every thread is answered and resolved.
    done = cur.setdefault("review_done", {})
    failed = []
    for thread in task.get("threads", []):
        step = done.setdefault(thread["id"], {})
        try:
            if not step.get("replied"):
                body = f"Addressed in {head[:12]} (scheduled {P['name']} review run)."
                if notes.get(thread["id"]):
                    body += "\n\n" + notes[thread["id"]]
                run(["gh", "api", f"repos/{GH_REPO}/pulls/{task['number']}/comments/{thread['comment']}/replies",
                     "-f", f"body={body}"])
                step["replied"] = True
                save(CURRENT, cur)
            if not step.get("resolved"):
                run(["gh", "api", "graphql", "-f",
                     f'query=mutation{{resolveReviewThread(input:{{threadId:"{thread["id"]}"}}){{thread{{isResolved}}}}}}'])
                step["resolved"] = True
                save(CURRENT, cur)
        except RuntimeError as err:
            failed.append(thread["id"])
            print(f"WARN=thread {thread['id']}: {str(err).strip().splitlines()[0] if str(err).strip() else err}")
    if failed:
        print(f"PUBLISH_ERROR=GitHub thread update failed for {len(failed)} thread(s); the next run retries")
        return 1
    drop_worktree(cur)
    print(f"REVIEWED={cur['branch']} threads={len(task.get('threads', []))}\nPR={task['pr']}")
    try:
        # Codex does not review follow-up pushes on its own; merge once the threads are resolved.
        land(task["number"], head, wait_for_codex=False)
    except (RuntimeError, ValueError) as err:
        print(f"WARN=landing {task['pr']} failed: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
    return 0


def drop_worktree(cur: dict) -> None:
    # Keep the agent's commits before deleting the clone: a run killed mid-gate (2026-10-29, A13)
    # otherwise loses every round. The bundle import runs sandboxed like the gate's.
    if Path(cur.get("worktree", "")).is_dir() and cur.get("base_sha"):
        try:
            commit = import_agent_commits(cur)
            if commit and commit != cur["base_sha"]:
                ref = f"refs/ark/{PROGRAM}/salvage/{cur['branch'].replace('/', '-')}"
                git("update-ref", ref, commit)
                print(f"SALVAGED={ref} {commit[:12]}")
        except (RuntimeError, OSError) as err:
            print(f"SALVAGE_ERROR={cur.get('branch')}: {str(err).strip()[-300:]}")
    # Plain deletes: the host never runs git inside the agent clone.
    shutil.rmtree(cur["worktree"], ignore_errors=True)
    shutil.rmtree(GATE_TREES / "current", ignore_errors=True)
    git("worktree", "prune", check=False)
    git("update-ref", "-d", f"refs/ark/{PROGRAM}/gate", check=False)
    CURRENT.unlink(missing_ok=True)


def cmd_latency() -> int:
    """Verify runs: the quiet latency A/B before the agent round; the result goes into the task."""
    cur = load(CURRENT, None)
    if cur is None or cur["task"].get("type") != "verify":
        print("no verify run")
        return 1
    cur["task"]["latency"] = latency_ab(cur["task"])
    save(CURRENT, cur)
    result = cur["task"]["latency"]
    print("\n".join(result.get("lines", [])) or f"LATENCY_ERROR={result.get('error', '')[-300:]}")
    print(f"LATENCY={'regression' if result.get('regression') else 'error' if 'error' in result else 'ok'}")
    return 0


def cmd_verdict() -> int:
    """Verify runs: act on the agent's verdict. Pass records the head, and the next auto-merge merges
    it; fail posts the findings as review threads for the review flow, whose new head needs a fresh
    verify. After VERIFY_FAIL_LIMIT failed verifies the PR is settled: the review flow fixes the findings and
    it merges on green CI without another verify (needs_verify)."""
    cur = load(CURRENT, None)
    if cur is None or cur["task"].get("type") != "verify":
        print("no verify run")
        return 1
    task, branch = cur["task"], cur["branch"]
    verdict = verify_verdict(cur)
    if verdict is None:
        print(f"VERIFY_ERROR={branch}: no valid verdict in .git/ark-verify.json; run dropped")
        drop_worktree(cur)
        return 1
    findings = verdict["findings"] if verdict["verdict"] == "fail" else []
    if verdict["verdict"] == "fail" and not findings:
        findings.append({"path": "", "line": None, "reason": "Verify failed without a specific finding."})
    latency = task.get("latency") or {}
    if latency.get("regression"):
        findings.append({"path": "", "line": None, "reason": public_text(
            "Latency A/B against main (quiet host, base vs head): slower beyond noise in every attempt.\n```\n"
            + "\n".join(latency["lines"][-12:]) + "\n```")})
    state = load(VERIFIED, {})
    if not findings:
        state.setdefault("pass", {})[task["head"]] = dt.datetime.now(dt.timezone.utc).isoformat()
        save(VERIFIED, state)
        drop_worktree(cur)
        print(f"VERIFIED={branch} pass {task['head'][:12]}\nPR={task['pr']}")
        return 0
    fails = state.setdefault("fails", {})
    fails[branch] = fails.get(branch, 0) + 1
    save(VERIFIED, state)
    unposted = post_findings(task, findings)
    print(f"VERIFIED={branch} fail {task['head'][:12]}: {len(findings)} finding(s), {unposted} not posted "
          f"(failed verify {fails[branch]}/{VERIFY_FAIL_LIMIT})\nPR={task['pr']}")
    if fails[branch] >= VERIFY_FAIL_LIMIT:
        print(f"VERIFY_SETTLED={branch}: the review flow fixes these findings, then it merges without another verify")
    drop_worktree(cur)
    return 0


def cmd_block(task_id: str, reason: str) -> int:
    blocked = load(BLOCKED, {})
    cur = load(CURRENT, None)
    blocked[task_id] = {"reason": reason, "at": dt.datetime.now(dt.timezone.utc).isoformat()}
    save(BLOCKED, blocked)
    if cur is not None and cur["task_id"] == task_id:
        if cur.get("publish_commit") and cur["task"].get("type") != "restack" and not json.loads(run(
                ["gh", "pr", "list", "--repo", GH_REPO, "--head", cur["branch"], "--state", "all",
                 "--json", "number"], check=False) or "[]"):
            # `ark-l1 ci` pushed the branch for a CI run that stayed red; without a PR it is just noise.
            git("push", "--quiet", "origin", "--delete", cur["branch"], check=False)
        drop_worktree(cur)
    print(f"BLOCKED={task_id}")
    return 0


def cmd_abort() -> int:
    cur = load(CURRENT, None)
    if cur is not None:
        drop_worktree(cur)
    print("ABORTED")
    return 0


def cmd_unblock(task_id: str) -> int:
    blocked = load(BLOCKED, {})
    blocked.pop(task_id, None)
    save(BLOCKED, blocked)
    drops = load(STATE / "watchdog.json", {})
    save(STATE / "watchdog.json", {k: v for k, v in drops.items() if not k.startswith(f"{task_id}@")})
    if task_id.startswith("VERIFY:") and VERIFIED.exists():
        verified = load(VERIFIED, {})
        verified.get("fails", {}).pop(task_id.removeprefix("VERIFY:"), None)
        save(VERIFIED, verified)
    print(f"UNBLOCKED={task_id}")
    return 0


def cmd_status() -> int:
    git("fetch", "--quiet", "--prune", "origin")
    every = prs("open")
    open_prs = sorted(own(every), key=lambda p: branch_number(p["headRefName"]))
    print(f"Lane: {LANE or '(all tasks)'}")
    print("Stack (open):")
    for p in open_prs:
        print(f"  #{p['number']} {p['headRefName']} ← {p['baseRefName']}  {p['url']}")
    print("Blocked:", json.dumps(load(BLOCKED, {}), indent=2, ensure_ascii=False))
    print("Current:", load(CURRENT, None))
    # Same choice as `next`: flat tasks start from main and skip tasks that already have a PR.
    backlog = backlog_at("origin/main")
    in_flight = {task_of_branch(p["headRefName"]) for p in every}
    task = pick(backlog, load(BLOCKED, {}), in_flight) if backlog else None
    print("Next:", task and f"{task['id']} {task.get('title', '')}")
    return 0


def landable(open_prs: list[dict]) -> str | None:
    """What `next` would do for an open PR of this lane, as "<action> #<n> <branch>", else None:
    merge or verify (auto_merge's choice), restack (conflicts with main), review (threads or red CI).
    Read-only; a blocked RESTACK/REVIEW/VERIFY does not count."""
    blocked, stack = load(BLOCKED, {}), load(STACK, {})  # restack() skips unrecorded branches
    main = sha("origin/main")
    for pr in sorted(open_prs, key=lambda p: branch_number(p["headRefName"])):
        name, head = pr["headRefName"], pr["headRefOid"]
        label = f"#{pr['number']} {name}"
        if pr.get("isDraft"):
            continue
        ci = ci_state(head)
        if review_threads(pr["number"]) or ci == "red":
            if f"REVIEW:{name}" not in blocked:
                return f"review {label}"
            continue
        if pr["baseRefName"] == "main" and name in stack and conflicts_with(main, head):
            if f"RESTACK:{name}" not in blocked:
                return f"restack {label}"
            continue
        if (AUTO_MERGE and pr["baseRefName"] == "main" and ci == "green"
                and pr_mergeable(pr) == "MERGEABLE"):
            if not needs_verify(head, name):
                return f"merge {label}"
            if f"VERIFY:{name}" not in blocked:
                return f"verify {label}"
    return None


def cmd_landable() -> int:
    if CURRENT.exists():
        print(f"BUSY={PROGRAM}")
        return 1
    git("fetch", "--quiet", "--prune", "origin")
    label = landable(own(prs("open")))
    print(f"LANDABLE={label}" if label else "LANDABLE=none")
    return 0 if label else 1


def cmd_idle() -> int:
    idle = IDLE.exists() and not CURRENT.exists()
    print(f"IDLE={PROGRAM} since {IDLE.read_text().strip()}" if idle else f"BUSY={PROGRAM}")
    return 0 if idle else 1


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__)
        return 2
    cmd, args = argv[0], argv[1:]
    table = {
        "next": cmd_next, "env": cmd_env, "gate": cmd_gate, "publish": cmd_publish,
        "abort": cmd_abort, "status": cmd_status, "ahead": cmd_ahead, "stale": cmd_stale, "ci": cmd_ci, "idle": cmd_idle,
        "landable": cmd_landable,
        "latency": cmd_latency, "verdict": cmd_verdict,
    }
    if cmd in table:
        return table[cmd]()
    if cmd == "block" and len(args) >= 2:
        return cmd_block(args[0], " ".join(args[1:]))
    if cmd == "unblock" and len(args) == 1:
        return cmd_unblock(args[0])
    if cmd == "own":
        print("\n".join(b for b in args if b.startswith(BRANCH_PREFIX) and in_lane(task_of_branch(b))))
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
