def take_program(argv: list[str]) -> str:
    """Remove `--program NAME` from argv and return the programme name."""
    name = os.environ.get("ARK_L1_PROGRAM", "pii")
    if "--program" in argv:
        i = argv.index("--program")
        if i + 1 >= len(argv):
            sys.exit("--program needs a value")
        name = argv[i + 1]
        del argv[i:i + 2]
    if name not in PROGRAMS:
        sys.exit(f"unknown programme {name!r}; expected one of {', '.join(PROGRAMS)}")
    return name


