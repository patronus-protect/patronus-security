def cmd_next() -> int:
    for d in (WORKTREES, GATE_TREES, TRANSFER, STATE, LOGS, TARGET, CACHE, DEV_DATA, HOLDOUT):
        d.mkdir(parents=True, exist_ok=True)
    if CURRENT.exists():
        cur = load(CURRENT, {})
        if cur.get("gated_commit"):
            print(f"RESULT=RESUME_PUBLISH {cur.get('task_id')}")
            return 11
        return nothing(f"STALE_RUN {cur.get('task_id')} (run `ark-l1 abort`)")
    git("fetch", "--quiet", "--prune", "origin")
    git("checkout", "--quiet", "--detach", "origin/main")
    open_prs = prs("open")
    merged = auto_merge(open_prs)
    if merged == MERGE_PENDING:
        return nothing("MERGE_PENDING (asynchronous merge still running; the next run continues)")
    if merged is not None:
        git("fetch", "--quiet", "--prune", "origin")
        git("checkout", "--quiet", "--detach", "origin/main")
        # GitHub may still list the PR as open for a moment; a merged (and deleted) branch must
        # never become the stack top a new task is based on.
        open_prs = [p for p in prs("open") if p["number"] != merged]
    top, conflict = restack(open_prs)
    if conflict is not None:
        if conflict.get("push_error"):
            return nothing(f"RESTACK_PUSH_ERROR {conflict['branch']} (push the RESTACK_REF from outside)")
        if f"RESTACK:{conflict['branch']}" in load(BLOCKED, {}):
            return nothing(f"REBASE_CONFLICT {conflict['branch']} (agent failed; resolve by hand, then unblock)")
        return start_restack(conflict)
    # Heads may have moved in restack; read them again before judging threads and CI.
    review = find_review([p for p in prs("open") if p["number"] != merged])
    if review is not None:
        return start_review(review)
    if len(open_prs) >= MAX_OPEN:
        return nothing(f"PAUSED {len(open_prs)} open stack PRs (limit {MAX_OPEN})")
    top_name, top_sha = top
    backlog = backlog_at(top_sha)
    if backlog is None:
        return nothing(f"NO_BACKLOG on {top_name}")
    in_flight = {task_of_branch(p["headRefName"]) for p in open_prs}
    task = pick(backlog, load(BLOCKED, {}), in_flight)
    if task is None:
        return nothing("NOTHING_TO_DO")

    used = [branch_number(p["headRefName"]) for p in prs("all")]
    number = max([*used, load(STATE / "counter.json", 0)], default=0) + 1
    save(STATE / "counter.json", number)
    branch = f"{BRANCH_PREFIX}{number:03d}-{task['id'].lower()}"
    worktree = WORKTREES / branch.replace("/", "-")
    shutil.rmtree(worktree, ignore_errors=True)
    git("clone", "--quiet", "--shared", "--no-checkout", str(REPO), str(worktree))
    git("checkout", "--quiet", "-B", branch, top_sha, cwd=worktree)
    current = {
        "task_id": task["id"], "task": task, "branch": branch, "base": top_name,
        "base_sha": top_sha, "worktree": str(worktree), "started": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    save(CURRENT, current)
    print(f"TASK_ID={task['id']}\nBRANCH={branch}\nBASE={top_name}\nWORKTREE={worktree}")
    return 0


