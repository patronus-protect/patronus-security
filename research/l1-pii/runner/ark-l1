PRIVATE = [
    SECRETS, HOME / ".config" / "gh", HOME / ".ssh", HOME / ".bash_history",
    HOME / "patronus-research-scanner", HOME / "web-census", HOME / "repos",
    *[program_root(n) / d for n in PROGRAMS for d in ("holdout", "state", "cache", "gate", "transfer")],
