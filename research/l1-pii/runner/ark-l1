# ── helpers ──────────────────────────────────────────────────────────────


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, env: dict | None = None) -> str:
    proc = subprocess.run(
        cmd, cwd=cwd, text=True, capture_output=True, env={**os.environ, **(env or {})}
    )
    if check and proc.returncode != 0:
        raise RuntimeError(f"{shlex.join(cmd)} failed ({proc.returncode}):\n{proc.stdout}\n{proc.stderr}")
    return proc.stdout.strip()


# Host-side git only touches the trusted repository and checkouts it created itself; these
# flags keep it from running configured commands even so.
GIT_SAFE = ["-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null"]


def git(*args: str, cwd: Path = REPO, check: bool = True) -> str:
    return run(["git", *GIT_SAFE, *args], cwd=cwd, check=check)


def git_raw(*args: str, stdin: str | None = None, env: dict | None = None) -> str:
    proc = subprocess.run(["git", *GIT_SAFE, *args], cwd=REPO, text=True, capture_output=True,
                          input=stdin, env={**os.environ, **(env or {})})
    if proc.returncode != 0:
        raise RuntimeError(f"git {shlex.join(args)} failed ({proc.returncode}):\n{proc.stderr}")
    return proc.stdout


def sandbox(cmd: list[str], cwd: Path, rw: list[Path], env: dict[str, str], *,
            network: bool = True, readable: tuple[Path, ...] = (), max_sec: int = 3600
            ) -> subprocess.CompletedProcess:
    """Run cmd as the current user in a transient systemd unit without credentials."""
    exposed = {*rw, *readable}
    # A private directory stays visible when a step exposes it or something below it.
    hidden = [path for path in PRIVATE if not any(e == path or e.is_relative_to(path) for e in exposed)]
    props = [
        "NoNewPrivileges=yes", "ProtectSystem=strict", "ProtectHome=read-only", "PrivateTmp=yes",
        "ReadWritePaths=" + " ".join(f"-{path}" for path in rw),
        "InaccessiblePaths=" + " ".join(f"-{path}" for path in hidden),
        f"RuntimeMaxSec={max_sec}", "CPUQuota=500%", "MemoryMax=9G",
    ]
    if not network:
        props.append("PrivateNetwork=yes")
    full = ["sudo", "systemd-run", f"--uid={os.getuid()}", f"--gid={os.getgid()}", "--pipe",
            "--wait", "--collect", "--quiet", f"--working-directory={cwd}"]
    for prop in props:
        full += ["-p", prop]
    base = {"HOME": str(HOME), "PATH": f"{CARGO.parent}:/usr/local/bin:/usr/bin:/bin",
            "RUSTUP_HOME": str(HOME / ".rustup"), "GIT_CONFIG_NOSYSTEM": "1"}
    for key, value in {**base, **env}.items():
        full += ["-E", f"{key}={value}"]
    return subprocess.run(full + cmd, text=True, capture_output=True, stdin=subprocess.DEVNULL)


def agent_git(wt: Path, *args: str) -> subprocess.CompletedProcess:
    """git inside the agent clone reads agent-controlled config, so it only runs sandboxed."""
    return sandbox(["git", *args], wt, [TRANSFER], {}, network=False, max_sec=300)


def load(path: Path, default):
    return json.loads(path.read_text()) if path.exists() else default


def save(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)


def branch_number(name: str) -> int:
    m = re.match(rf"{re.escape(BRANCH_PREFIX)}(\d+)-", name)
    return int(m.group(1)) if m else -1


def prs(state: str) -> list[dict]:
    out = run([
        "gh", "pr", "list", "--repo", GH_REPO, "--label", LABEL, "--state", state, "--limit", "200",
        "--json", "number,headRefName,baseRefName,headRefOid,state,url,mergeable",
    ])
    return [p for p in json.loads(out) if p["headRefName"].startswith(BRANCH_PREFIX)]


def sha(ref: str) -> str:
    return git("rev-parse", ref)


def nothing(reason: str) -> int:
    print(f"RESULT={reason}")
    return NOTHING


# ── restack ──────────────────────────────────────────────────────────────


def restack(open_prs: list[dict]) -> tuple[tuple[str, str], dict | None]:
    """Rebase open stack branches whose recorded parent moved.

    Returns ((top_name, top_sha), conflict); conflict describes the first branch whose rebase did
    not apply cleanly (the branches above it stay untouched until it is resolved)."""
    stack = load(STACK, {})
    prev_name, prev_sha = "main", sha("origin/main")
    conflict = None
    for pr in sorted(open_prs, key=lambda p: branch_number(p["headRefName"])):
        name = pr["headRefName"]
        rec = stack.get(name)
        head = pr["headRefOid"]
        if rec is None:
            print(f"WARN=unrecorded stack branch {name}; leaving it untouched")
        elif (rec["base"] != prev_name or rec["base_sha"] != prev_sha) and subprocess.run(
                ["git", *GIT_SAFE, "merge-base", "--is-ancestor", prev_sha, head], cwd=REPO).returncode == 0:
            # Rebased outside the runner (by hand or by a report run), the bottom branch included:
            # only record the new base; replaying from the stale base would duplicate the parent's commits.
            stack[name] = {"base": prev_name, "base_sha": prev_sha}
            print(f"RECORDED={name} already on {prev_name}")
        elif (pr.get("mergeable") == "CONFLICTING" if prev_name == "main" and rec["base"] == "main"
              else rec["base_sha"] != prev_sha):
            # The bottom branch stays on its main commit until GitHub reports a conflict with main;
            # its old base is where it forks from main, whatever stack.json still says.
            old_base = (git("merge-base", head, prev_sha) if prev_name == "main" and rec["base"] == "main"
                        else rec["base_sha"])
            git("checkout", "--quiet", "--detach", head)
            proc = subprocess.run(
                ["git", *GIT_SAFE, "rebase", "--quiet", "--onto", prev_sha, old_base],
                cwd=REPO, text=True, capture_output=True,
            )
            if proc.returncode != 0:
                git("rebase", "--abort", check=False)
                git("checkout", "--quiet", "--detach", "origin/main")
                print(f"CONFLICT_BRANCH={name}")
                conflict = {"branch": name, "pr": pr["url"], "old_head": head, "old_base": old_base,
                            "onto_name": prev_name, "onto": prev_sha}
                break
            new_head = sha("HEAD")
            try:
                git("push", "--quiet", f"--force-with-lease=refs/heads/{name}:{head}", "origin",
                    f"HEAD:refs/heads/{name}")
            except RuntimeError as err:
                # E.g. a branch that touches .github/workflows and a token without `workflow` scope.
                # Keep the rebase for a push from outside; once the branch is there, the next run
                # only records it (see above).
                ref = f"refs/ark/{PROGRAM}/restack/{name}"
                git("update-ref", ref, new_head)
                git("checkout", "--quiet", "--detach", "origin/main")
                reason = next((line.strip() for line in str(err).splitlines() if "rejected" in line),
                              str(err).strip().splitlines()[-1])
                print(f"RESTACK_PUSH_ERROR={name}: {reason}\nRESTACK_REF={ref} {new_head} lease={head}")
                conflict = {"branch": name, "push_error": reason}
                break
            git("checkout", "--quiet", "--detach", "origin/main")
            stack[name] = {"base": prev_name, "base_sha": prev_sha}
            head = new_head
            print(f"RESTACKED={name}")
        if pr["baseRefName"] != prev_name:
            try:
                run(["gh", "pr", "edit", str(pr["number"]), "--repo", GH_REPO, "--base", prev_name])
            except RuntimeError as err:
                # GitHub refuses base changes on PRs that are part of a native stack. The branch is
                # already rebased; a stale PR base must not abort every following run.
                print(f"WARN=base of #{pr['number']} not changed to {prev_name}: "
                      f"{str(err).strip().splitlines()[-1]}")
        prev_name, prev_sha = name, head
    for name in list(stack):
        if name not in {p["headRefName"] for p in open_prs}:
            del stack[name]
    save(STACK, stack)
    return (prev_name, prev_sha), conflict


def start_restack(conflict: dict) -> int:
    """Hand a conflicting rebase to the agent: same sandbox, gate and rounds as a backlog task."""
    branch = conflict["branch"]
    task = {"id": f"RESTACK:{branch}", "type": "restack",
            "title": f"Rebase {branch} onto {conflict['onto_name']} and resolve the conflicts",
            "branch": branch, "pr": conflict["pr"], "onto": conflict["onto"],
            "onto_name": conflict["onto_name"], "old_base": conflict["old_base"],
            "old_head": conflict["old_head"]}
    worktree = WORKTREES / ("restack-" + branch.replace("/", "-"))
    shutil.rmtree(worktree, ignore_errors=True)
    git("clone", "--quiet", "--shared", "--no-checkout", str(REPO), str(worktree))
    git("checkout", "--quiet", "-B", branch, conflict["old_head"], cwd=worktree)
    current = {
        "task_id": task["id"], "task": task, "branch": branch, "base": conflict["onto_name"],
        "base_sha": conflict["onto"], "worktree": str(worktree),
        "started": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    save(CURRENT, current)
    print(f"TASK_ID={task['id']}\nBRANCH={branch}\nBASE={conflict['onto_name']}\nWORKTREE={worktree}")
    return 0


# ── backlog ──────────────────────────────────────────────────────────────


def backlog_at(rev: str, path: str = BACKLOG) -> dict | None:
    text = git("show", f"{rev}:{path}", check=False)
    return yaml.safe_load(text) if text else None


MAIN_DONE: dict[str, set[str]] = {}


def done_on_main(ref: str) -> bool:
    """True when `program:ID` is done in that programme's backlog on origin/main."""
    program, _, task_id = ref.partition(":")
    if program not in PROGRAMS or not task_id:
        raise RuntimeError(f"bad ext_deps entry {ref!r}; expected <program>:<id>")
    if program not in MAIN_DONE:
        backlog = backlog_at("origin/main", PROGRAMS[program]["backlog"]) or {}
        MAIN_DONE[program] = {t["id"] for t in backlog.get("tasks", []) if t.get("status") == "done"}
    return task_id in MAIN_DONE[program]


def pick(backlog: dict, blocked: dict) -> dict | None:
    tasks = backlog.get("tasks", [])
    done = {t["id"] for t in tasks if t.get("status") == "done"}
    today = dt.date.today()
    week = f"{today.isocalendar().year}-W{today.isocalendar().week:02d}"
    if today.weekday() == 0 and not (STATE / f"triage-{week}").exists() and done:
        rec = next(r for r in backlog.get("recurring", []) if r["id"] == "TRIAGE")
        return {**rec, "type": "triage", "week": week}
    for t in tasks:
        if t.get("status", "todo") != "todo" or t["id"] in blocked:
            continue
        if t.get("needs_decision"):
            continue
        if all(d in done for d in t.get("deps", [])) and all(
            done_on_main(d) for d in t.get("ext_deps", [])
        ):
            return t
    return None


def mark_done(path: Path, task_id: str) -> None:
    path.write_text(mark_done_text(path.read_text(), task_id))


def mark_done_text(text: str, task_id: str) -> str:
    lines = text.splitlines(keepends=True)
    for i, line in enumerate(lines):
        flow = re.match(rf"(\s*- \{{id: {re.escape(task_id)},.*)\}}(\s*)$", line)
        if flow:
            lines[i] = f"{flow.group(1)}, status: done}}{flow.group(2)}"
            break
        block = re.match(rf"(\s*)- id: {re.escape(task_id)}\s*$", line)
        if block:
            lines.insert(i + 1, f"{block.group(1)}  status: done\n")
            break
    else:
        raise RuntimeError(f"task {task_id} not found in {BACKLOG}")
    return "".join(lines)


# ── subcommands ──────────────────────────────────────────────────────────


def cmd_next() -> int:
    for d in (WORKTREES, GATE_TREES, TRANSFER, STATE, LOGS, TARGET, CACHE, DEV_DATA, HOLDOUT):
        d.mkdir(parents=True, exist_ok=True)
    if CURRENT.exists():
        cur = load(CURRENT, {})
        if cur.get("gated_commit"):
            print(f"RESULT=RESUME_PUBLISH {cur.get('task_id')}")
            return 11
        return nothing(f"STALE_RUN {cur.get('task_id')} (run `ark-l1 abort`)")
    git("fetch", "--quiet", "--prune", "origin")
    git("checkout", "--quiet", "--detach", "origin/main")
    open_prs = prs("open")
    top, conflict = restack(open_prs)
    if conflict is not None:
        if conflict.get("push_error"):
            return nothing(f"RESTACK_PUSH_ERROR {conflict['branch']} (push the RESTACK_REF from outside)")
        if f"RESTACK:{conflict['branch']}" in load(BLOCKED, {}):
            return nothing(f"REBASE_CONFLICT {conflict['branch']} (agent failed; resolve by hand, then unblock)")
        return start_restack(conflict)
    if len(open_prs) >= MAX_OPEN:
        return nothing(f"PAUSED {len(open_prs)} open stack PRs (limit {MAX_OPEN})")
    top_name, top_sha = top
    backlog = backlog_at(top_sha)
    if backlog is None:
        return nothing(f"NO_BACKLOG on {top_name}")
    task = pick(backlog, load(BLOCKED, {}))
    if task is None:
        return nothing("NOTHING_TO_DO")

    used = [branch_number(p["headRefName"]) for p in prs("all")]
    number = max([*used, load(STATE / "counter.json", 0)], default=0) + 1
    save(STATE / "counter.json", number)
    branch = f"{BRANCH_PREFIX}{number:03d}-{task['id'].lower()}"
    worktree = WORKTREES / branch.replace("/", "-")
    shutil.rmtree(worktree, ignore_errors=True)
    git("clone", "--quiet", "--shared", "--no-checkout", str(REPO), str(worktree))
    git("checkout", "--quiet", "-B", branch, top_sha, cwd=worktree)
    current = {
        "task_id": task["id"], "task": task, "branch": branch, "base": top_name,
        "base_sha": top_sha, "worktree": str(worktree), "started": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    save(CURRENT, current)
    print(f"TASK_ID={task['id']}\nBRANCH={branch}\nBASE={top_name}\nWORKTREE={worktree}")
    return 0


def cmd_env() -> int:
    cur = load(CURRENT, None)
    if cur is None:
        return 1
    for key in ("task_id", "branch", "base", "base_sha", "worktree"):
        print(f"{key.upper()}={shlex.quote(cur[key])}")
    print(f"PROGRAM={PROGRAM}")
    print(f"PROGRAM_ROOT={shlex.quote(str(ROOT))}")
    restack_run = cur["task"].get("type") == "restack"
    print(f"PROMPT_FILE={'AGENT_PROMPT.restack.md' if restack_run else P['prompt']}")
    print(f"TASK_YAML={shlex.quote(yaml.safe_dump(cur['task'], allow_unicode=True, sort_keys=False))}")
    return 0


def gate_steps(wt: Path) -> list[tuple[str, list[str], dict]]:
    """(name, command, sandbox options); every step runs sandboxed in the trusted checkout wt."""
    py = str(ROOT / P["eval_venv"] / "bin" / "python")
    gpy = str(GATE_VENV / "bin" / "python")
    build = {"rw": [wt, GATE_TARGET, GATE_HOME, GATE_VENV]}
    steps = [
        ("fmt", [str(CARGO), "fmt", "--all", "--", "--check"], build),
        ("clippy", [str(CARGO), "clippy", "--workspace", "--all-targets", "--", "-D", "warnings"], build),
        ("test", [str(CARGO), "test", "-p", "patronus-ark"], build),
        ("golden", ["sh", "-c", f"cd rust && exec {CARGO} run --quiet --example 13_l1_golden_eval -- "
                    + shlex.quote(P["golden"])], build),
        ("python-ext", [gpy, "-m", "maturin", "develop", "--quiet", "--manifest-path", "python/Cargo.toml"],
         build),
        ("python-tests", [gpy, "-m", "unittest", "discover", "-s", "python/tests"], build),
        ("docs", ["python3", "scripts/generate_docs.py", "--check"], build),
    ]
    prepare = wt / P["eval_dir"] / "prepare_corpora.py"
    if prepare.exists() and not (HOLDOUT / ".ready").exists():
        # Downloads public corpora and freezes the split; no credentials in the sandbox.
        steps.append(("prepare-corpora", [py, str(prepare), "--dev-out", str(DEV_DATA),
                                          "--holdout-out", str(HOLDOUT)],
                      {"rw": [wt, DEV_DATA, HOLDOUT, CACHE]}))
    synth = wt / P["eval_dir"] / "synth_goldset.py"
    if synth.exists() and not (HOLDOUT / "synthetic" / ".ready").exists():
        # Once, like prepare-corpora: afterwards agent branches never get write access to the holdout.
        # The secret holdout seed is created in HOLDOUT/synthetic/.seed.
        steps.append(("synthetic-goldset", [py, str(synth), "--dev-out", str(DEV_DATA / "synthetic"),
                                            "--holdout-out", str(HOLDOUT / "synthetic")],
                      {"rw": [DEV_DATA, HOLDOUT], "readable": (wt,), "network": False}))
    external = wt / P["eval_dir"] / "external_content.py"
    if external.exists() and not (DEV_DATA / "external" / ".ready").exists():
        # Dev only (gitleaks Go, SchemaPile SQL): public sources, never part of the holdout.
        steps.append(("external-corpora", [py, str(external), "prepare", "--out", str(DEV_DATA / "external"),
                                           "--sources", str(CACHE / "external_sources")],
                      {"rw": [wt, DEV_DATA, CACHE]}))
    scoreboard = wt / P["eval_dir"] / "scoreboard.py"
    if scoreboard.exists():
        cur = load(CURRENT, {})
        # The only step that reads the holdout: no network, writes only to the private cache.
        steps.append(("scoreboard", [py, str(scoreboard), "gate", "--head", str(wt),
                                     "--base-sha", cur.get("base_sha", ""), "--dev", str(DEV_DATA),
                                     "--holdout", str(HOLDOUT), "--cache", str(CACHE)],
                      {"rw": [CACHE], "readable": (HOLDOUT, wt), "network": False}))
    return steps


def gate_env() -> dict[str, str]:
    return {"CARGO_TARGET_DIR": str(GATE_TARGET), "CARGO_HOME": str(GATE_HOME / "cargo"),
            "XDG_CACHE_HOME": str(GATE_HOME / "cache"), "VIRTUAL_ENV": str(GATE_VENV),
            "PIP_NO_CACHE_DIR": "1"}


def import_agent_commits(cur: dict) -> str | None:
    """Bundle the agent branch inside the sandbox and fetch the bundle into the trusted repository."""
    bundle = TRANSFER / "agent.bundle"
    bundle.unlink(missing_ok=True)
    proc = agent_git(Path(cur["worktree"]), "bundle", "create", "--quiet", str(bundle),
                     f"{cur['base_sha']}..HEAD")
    if proc.returncode != 0 or not bundle.exists():
        return None
    ref = f"refs/ark/{PROGRAM}/gate"
    git("fetch", "--quiet", "--no-tags", str(bundle), f"+HEAD:{ref}")
    bundle.unlink(missing_ok=True)
    return sha(ref)


def cmd_ahead() -> int:
    cur = load(CURRENT, None)
    if cur is None:
        print(0)
        return 1
    proc = agent_git(Path(cur["worktree"]), "rev-list", "--count", f"{cur['base_sha']}..HEAD")
    print(proc.stdout.strip() if proc.returncode == 0 else 0)
    return 0


def cmd_gate() -> int:
    cur = load(CURRENT, None)
    if cur is None:
        print("no current run")
        return 1
    report = STATE / "gate-report.md"
    lines = [f"# Gate {cur['task_id']} ({cur['branch']})", ""]
    ok = True
    status = agent_git(Path(cur["worktree"]), "status", "--porcelain")
    dirty = status.stdout.strip() if status.returncode == 0 else f"git status failed: {status.stderr[-500:]}"
    commit = import_agent_commits(cur)
    if dirty:
        lines.append("- ❌ uncommitted changes (only committed work is gated):\n```\n" + dirty[:2000] + "\n```")
        ok = False
    if commit is None or commit == cur["base_sha"]:
        lines.append("- ❌ no commits on the branch")
        ok = False
    elif subprocess.run(["git", *GIT_SAFE, "merge-base", "--is-ancestor", cur["base_sha"], commit],
                        cwd=REPO).returncode != 0:
        lines.append(f"- ❌ branch does not build on its base {cur['base_sha'][:12]}")
        ok = False
    if ok:
        # Writable sandbox paths must exist, or systemd silently leaves them read-only.
        for d in (GATE_TARGET, GATE_HOME / "cargo", GATE_HOME / "cache", CACHE, TRANSFER):
            d.mkdir(parents=True, exist_ok=True)
        tree = GATE_TREES / "current"
        shutil.rmtree(tree, ignore_errors=True)
        git("worktree", "prune")
        git("worktree", "add", "--quiet", "--detach", str(tree), commit)
        try:
            for name, cmd, opts in gate_steps(tree):
                proc = sandbox(cmd, tree, opts["rw"], gate_env(), network=opts.get("network", True),
                               readable=opts.get("readable", ()))
                if proc.returncode == 0:
                    tail = proc.stdout.strip().splitlines()[-15:] if name == "scoreboard" else []
                    lines.append(f"- ✅ {name}" + ("\n```\n" + "\n".join(tail) + "\n```" if tail else ""))
                else:
                    # The scoreboard reads the holdout: report its exit code, never its output.
                    out = "" if name == "scoreboard" else (proc.stdout + "\n" + proc.stderr).strip()[-6000:]
                    lines.append(f"- ❌ {name} (exit {proc.returncode}): `{shlex.join(cmd)}`\n```\n{out}\n```")
                    ok = False
                    break
        finally:
            shutil.rmtree(tree, ignore_errors=True)
            git("worktree", "prune", check=False)
    if ok:
        cur["gated_commit"] = commit
        save(CURRENT, cur)
    report.write_text("\n".join(lines) + "\n")
    print(report.read_text())
    return 0 if ok else 1


def done_commit(commit: str, task: dict) -> str:
    """Commit the task's `status: done` on top of commit without any checkout."""
    text = git_raw("show", f"{commit}:{BACKLOG}")
    tasks = (yaml.safe_load(text) or {}).get("tasks", [])
    if any(t["id"] == task["id"] and t.get("status") == "done" for t in tasks):
        return commit
    blob = git_raw("hash-object", "-w", "--stdin", stdin=mark_done_text(text, task["id"])).strip()
    with tempfile.TemporaryDirectory() as tmp:
        env = {"GIT_INDEX_FILE": str(Path(tmp) / "index")}
        git_raw("read-tree", commit, env=env)
        git_raw("update-index", "--cacheinfo", f"100644,{blob},{BACKLOG}", env=env)
        tree = git_raw("write-tree", env=env).strip()
    return git_raw("commit-tree", tree, "-p", commit, "-m",
                   f"chore({PROGRAM}): mark {task['id']} done").strip()


def cmd_publish() -> int:
    cur = load(CURRENT, None)
    if cur is None or not cur.get("gated_commit"):
        print("no gated run to publish")
        return 1
    task = cur["task"]
    if task.get("type") == "restack":
        return publish_restack(cur)
    if task.get("type") == "triage":
        (STATE / f"triage-{task['week']}").write_text(dt.datetime.now(dt.timezone.utc).isoformat() + "\n")
        head = cur["gated_commit"]
    else:
        head = cur.get("publish_commit") or done_commit(cur["gated_commit"], task)
    cur["publish_commit"] = head
    save(CURRENT, cur)
    git("push", "--quiet", "origin", f"+{head}:refs/heads/{cur['branch']}")
    report = (STATE / "gate-report.md").read_text() if (STATE / "gate-report.md").exists() else ""
    body = "\n".join([
        f"Scheduled {P['name']} run, backlog task **{task['id']}**: {task.get('title', '')}",
        "",
        f"Stacked on `{cur['base']}`. One task per run; see `{P['readme']}`.",
        "",
        "```yaml",
        yaml.safe_dump(task, allow_unicode=True, sort_keys=False).strip(),
        "```",
        "",
        report,
        "",
        "🤖 Generated with [Claude Code](https://claude.com/claude-code)",
    ])
    existing = json.loads(run(["gh", "pr", "list", "--repo", GH_REPO, "--head", cur["branch"],
                               "--state", "open", "--json", "url"]))
    if existing:
        url = existing[0]["url"]
    else:
        url = run(["gh", "pr", "create", "--repo", GH_REPO, "--draft", "--base", cur["base"],
                   "--head", cur["branch"], "--label", LABEL,
                   "--title", f"{P['title']} {task['id']}: {task.get('title', '')}"[:250], "--body", body])
    stack = load(STACK, {})
    stack[cur["branch"]] = {"base": cur["base"], "base_sha": cur["base_sha"]}
    save(STACK, stack)
    drop_worktree(cur)
    print(f"PR={url}")
    return 0


def publish_restack(cur: dict) -> int:
    """Replace the conflicting branch with the gated rebase; the next `next` restacks the branches above."""
    task, branch, head = cur["task"], cur["branch"], cur["gated_commit"]
    remote = git("ls-remote", "origin", f"refs/heads/{branch}").split()
    if not remote or remote[0] != head:
        # Lease on the head the rebase started from: a push by someone else in between wins.
        git("push", "--quiet", f"--force-with-lease=refs/heads/{branch}:{task['old_head']}", "origin",
            f"{head}:refs/heads/{branch}")
    stack = load(STACK, {})
    stack[branch] = {"base": task["onto_name"], "base_sha": task["onto"]}
    save(STACK, stack)
    drop_worktree(cur)
    print(f"RESTACKED={branch}\nPR={task['pr']}")
    return 0


def drop_worktree(cur: dict) -> None:
    # Plain deletes: the host never runs git inside the agent clone.
    shutil.rmtree(cur["worktree"], ignore_errors=True)
    shutil.rmtree(GATE_TREES / "current", ignore_errors=True)
    git("worktree", "prune", check=False)
    git("update-ref", "-d", f"refs/ark/{PROGRAM}/gate", check=False)
    CURRENT.unlink(missing_ok=True)


def cmd_block(task_id: str, reason: str) -> int:
    blocked = load(BLOCKED, {})
    cur = load(CURRENT, None)
    blocked[task_id] = {"reason": reason, "at": dt.datetime.now(dt.timezone.utc).isoformat()}
    save(BLOCKED, blocked)
    if cur is not None and cur["task_id"] == task_id:
        drop_worktree(cur)
    print(f"BLOCKED={task_id}")
    return 0


def cmd_abort() -> int:
    cur = load(CURRENT, None)
    if cur is not None:
        drop_worktree(cur)
    print("ABORTED")
    return 0


def cmd_unblock(task_id: str) -> int:
    blocked = load(BLOCKED, {})
    blocked.pop(task_id, None)
    save(BLOCKED, blocked)
    print(f"UNBLOCKED={task_id}")
    return 0


def cmd_status() -> int:
    git("fetch", "--quiet", "--prune", "origin")
    open_prs = sorted(prs("open"), key=lambda p: branch_number(p["headRefName"]))
    print("Stack (open):")
    for p in open_prs:
        print(f"  #{p['number']} {p['headRefName']} ← {p['baseRefName']}  {p['url']}")
    print("Blocked:", json.dumps(load(BLOCKED, {}), indent=2, ensure_ascii=False))
    print("Current:", load(CURRENT, None))
    top = open_prs[-1]["headRefOid"] if open_prs else "origin/main"
    backlog = backlog_at(top)
    task = pick(backlog, load(BLOCKED, {})) if backlog else None
    print("Next:", task and f"{task['id']} {task.get('title', '')}")
    return 0


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__)
        return 2
    cmd, args = argv[0], argv[1:]
    table = {
        "next": cmd_next, "env": cmd_env, "gate": cmd_gate, "publish": cmd_publish,
        "abort": cmd_abort, "status": cmd_status, "ahead": cmd_ahead,
    }
    if cmd in table:
        return table[cmd]()
    if cmd == "block" and len(args) >= 2:
        return cmd_block(args[0], " ".join(args[1:]))
    if cmd == "unblock" and len(args) == 1:
        return cmd_unblock(args[0])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
