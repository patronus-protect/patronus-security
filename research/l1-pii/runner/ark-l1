# ── helpers ──────────────────────────────────────────────────────────────


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, env: dict | None = None) -> str:
    proc = subprocess.run(
        cmd, cwd=cwd, text=True, capture_output=True, env={**os.environ, **(env or {})}
    )
    if check and proc.returncode != 0:
        raise RuntimeError(f"{shlex.join(cmd)} failed ({proc.returncode}):\n{proc.stdout}\n{proc.stderr}")
    return proc.stdout.strip()


# Host-side git only touches the trusted repository and checkouts it created itself; these
# flags keep it from running configured commands even so.
GIT_SAFE = ["-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null"]


def git(*args: str, cwd: Path = REPO, check: bool = True) -> str:
    return run(["git", *GIT_SAFE, *args], cwd=cwd, check=check)


def git_raw(*args: str, stdin: str | None = None, env: dict | None = None) -> str:
    proc = subprocess.run(["git", *GIT_SAFE, *args], cwd=REPO, text=True, capture_output=True,
                          input=stdin, env={**os.environ, **(env or {})})
    if proc.returncode != 0:
        raise RuntimeError(f"git {shlex.join(args)} failed ({proc.returncode}):\n{proc.stderr}")
    return proc.stdout


def sandbox(cmd: list[str], cwd: Path, rw: list[Path], env: dict[str, str], *,
            network: bool = True, readable: tuple[Path, ...] = (), max_sec: int = 3600
            ) -> subprocess.CompletedProcess:
    """Run cmd as the current user in a transient systemd unit without credentials."""
    exposed = {*rw, *readable}
    # A private directory stays visible when a step exposes it or something below it.
    hidden = [path for path in PRIVATE if not any(e == path or e.is_relative_to(path) for e in exposed)]
    props = [
        "NoNewPrivileges=yes", "ProtectSystem=strict", "ProtectHome=read-only", "PrivateTmp=yes",
        "ReadWritePaths=" + " ".join(f"-{path}" for path in rw),
        "InaccessiblePaths=" + " ".join(f"-{path}" for path in hidden),
        f"RuntimeMaxSec={max_sec}", "CPUQuota=500%", "MemoryMax=9G",
    ]
    if not network:
        props.append("PrivateNetwork=yes")
    full = ["sudo", "systemd-run", f"--uid={os.getuid()}", f"--gid={os.getgid()}", "--pipe",
            "--wait", "--collect", "--quiet", f"--working-directory={cwd}"]
    for prop in props:
        full += ["-p", prop]
    base = {"HOME": str(HOME), "PATH": f"{CARGO.parent}:/usr/local/bin:/usr/bin:/bin",
            "RUSTUP_HOME": str(HOME / ".rustup"), "GIT_CONFIG_NOSYSTEM": "1"}
    for key, value in {**base, **env}.items():
        full += ["-E", f"{key}={value}"]
    return subprocess.run(full + cmd, text=True, capture_output=True, stdin=subprocess.DEVNULL)


def agent_git(wt: Path, *args: str) -> subprocess.CompletedProcess:
    """git inside the agent clone reads agent-controlled config, so it only runs sandboxed."""
    return sandbox(["git", *args], wt, [TRANSFER], {}, network=False, max_sec=300)


def load(path: Path, default):
    return json.loads(path.read_text()) if path.exists() else default


def save(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)


def branch_number(name: str) -> int:
    m = re.match(rf"{re.escape(BRANCH_PREFIX)}(\d+)-", name)
    return int(m.group(1)) if m else -1


RUNNER_LOGIN: list[str] = []


def runner_login() -> str:
    """The GitHub account the runner publishes as; only its own PRs belong to a stack."""
    if not RUNNER_LOGIN:
        RUNNER_LOGIN.append(os.environ.get("ARK_L1_GH_LOGIN") or run(["gh", "api", "user", "--jq", ".login"]))
    return RUNNER_LOGIN[0]


def prs(state: str) -> list[dict]:
    """The programme's stack PRs: its label and branch prefix, opened by the runner's own account
    from a branch of this repository. A fork or someone else's PR with the same label or branch
    name is never restacked, reviewed or merged."""
    out = run([
        "gh", "pr", "list", "--repo", GH_REPO, "--label", LABEL, "--state", state, "--limit", "200",
        "--json", "number,headRefName,baseRefName,headRefOid,state,url,mergeable,isDraft,"
                  "isCrossRepository,author",
    ])
    own = runner_login()
    return [p for p in json.loads(out)
            if p["headRefName"].startswith(BRANCH_PREFIX) and not p.get("isCrossRepository")
            and (p.get("author") or {}).get("login") == own]


def sha(ref: str) -> str:
    return git("rev-parse", ref)


def nothing(reason: str) -> int:
    print(f"RESULT={reason}")
    return NOTHING


# ── restack ──────────────────────────────────────────────────────────────


def restack(open_prs: list[dict]) -> tuple[tuple[str, str], dict | None]:
    """Keep the open task PRs mergeable on main (flat: each PR is based on main, not on another).

    Returns ((top_name, top_sha), conflict); conflict describes the first branch whose rebase did
    not apply cleanly (the branches above it stay untouched until it is resolved)."""
    stack = load(STACK, {})
    prev_name, prev_sha = "main", sha("origin/main")
    conflict = None
    for pr in sorted(open_prs, key=lambda p: branch_number(p["headRefName"])):
        name = pr["headRefName"]
        rec = stack.get(name)
        head = pr["headRefOid"]
        if rec is None:
            print(f"WARN=unrecorded stack branch {name}; leaving it untouched")
        elif (rec["base"] != prev_name or rec["base_sha"] != prev_sha) and subprocess.run(
                ["git", *GIT_SAFE, "merge-base", "--is-ancestor", prev_sha, head], cwd=REPO).returncode == 0:
            # Rebased outside the runner (by hand or by a report run), the bottom branch included:
            # only record the new base; replaying from the stale base would duplicate the parent's commits.
            stack[name] = {"base": prev_name, "base_sha": prev_sha}
            print(f"RECORDED={name} already on {prev_name}")
        elif (pr.get("mergeable") == "CONFLICTING" if prev_name == "main" and rec["base"] == "main"
              else rec["base_sha"] != prev_sha):
            # The bottom branch stays on its main commit until GitHub reports a conflict with main;
            # its old base is where it forks from main, whatever stack.json still says.
            old_base = (git("merge-base", head, prev_sha) if prev_name == "main" and rec["base"] == "main"
                        else rec["base_sha"])
            git("checkout", "--quiet", "--detach", head)
            proc = subprocess.run(
                ["git", *GIT_SAFE, "rebase", "--quiet", "--onto", prev_sha, old_base],
                cwd=REPO, text=True, capture_output=True,
            )
            if proc.returncode != 0:
                git("rebase", "--abort", check=False)
                git("checkout", "--quiet", "--detach", "origin/main")
                print(f"CONFLICT_BRANCH={name}")
                conflict = {"branch": name, "pr": pr["url"], "old_head": head, "old_base": old_base,
                            "onto_name": prev_name, "onto": prev_sha}
                break
            new_head = sha("HEAD")
            try:
                git("push", "--quiet", f"--force-with-lease=refs/heads/{name}:{head}", "origin",
                    f"HEAD:refs/heads/{name}")
            except RuntimeError as err:
                # E.g. a branch that touches .github/workflows and a token without `workflow` scope.
                # Keep the rebase for a push from outside; once the branch is there, the next run
                # only records it (see above).
                ref = f"refs/ark/{PROGRAM}/restack/{name}"
                git("update-ref", ref, new_head)
                git("checkout", "--quiet", "--detach", "origin/main")
                reason = next((line.strip() for line in str(err).splitlines() if "rejected" in line),
                              str(err).strip().splitlines()[-1])
                print(f"RESTACK_PUSH_ERROR={name}: {reason}\nRESTACK_REF={ref} {new_head} lease={head}")
                conflict = {"branch": name, "push_error": reason}
                break
            git("checkout", "--quiet", "--detach", "origin/main")
            stack[name] = {"base": prev_name, "base_sha": prev_sha}
            head = new_head
            print(f"RESTACKED={name}")
        if pr["baseRefName"] != prev_name:
            try:
                run(["gh", "pr", "edit", str(pr["number"]), "--repo", GH_REPO, "--base", prev_name])
            except RuntimeError as err:
                # GitHub refuses base changes on PRs that are part of a native stack. The branch is
                # already rebased; a stale PR base must not abort every following run.
                print(f"WARN=base of #{pr['number']} not changed to {prev_name}: "
                      f"{str(err).strip().splitlines()[-1]}")
                move_stale_base(pr, prev_name, prev_sha, {p["headRefName"] for p in open_prs})
        # Flat since 2026-10-23: every task PR targets main, none builds on another one; a PR is
        # rebased only when GitHub reports a conflict with main (or its recorded base is a branch).
    for name in list(stack):
        if name not in {p["headRefName"] for p in open_prs}:
            del stack[name]
    save(STACK, stack)
    return (prev_name, prev_sha), conflict


def move_stale_base(pr: dict, onto_name: str, onto_sha: str, open_heads: set[str]) -> None:
    """Point the stale base branch of a stacked PR at its new parent.

    A PR keeps the head branch of its merged parent as base when GitHub refuses the base change
    (native stack). That branch still holds the parent's unsquashed commits, so GitHub reports the
    rebased PR as conflicting and the next run rebases it again. Moving the merged branch, never an
    open stack branch, to the new parent leaves the PR with only its own commits."""
    base = pr["baseRefName"]
    if not base.startswith(BRANCH_PREFIX) or base in open_heads:
        return
    old = ""
    try:
        old = git("ls-remote", "origin", f"refs/heads/{base}").split("\t")[0]
        if not old or old == onto_sha:
            return
        git("push", "--quiet", f"--force-with-lease=refs/heads/{base}:{old}", "origin",
            f"{onto_sha}:refs/heads/{base}")
    except RuntimeError as err:
        # E.g. a `.github/workflows` change between the two commits and a token without `workflow`
        # scope; the PR stays as it is and the next run tries again.
        print(f"WARN=stale base {base} of #{pr['number']} not moved to {onto_name}: "
              f"{str(err).strip().splitlines()[-1]}\nSTALE_BASE_REF={base} {onto_sha} lease={old}")
        return
    print(f"MOVED_BASE={base} → {onto_name} for #{pr['number']}")


def start_restack(conflict: dict) -> int:
    """Hand a conflicting rebase to the agent: same sandbox, gate and rounds as a backlog task."""
    branch = conflict["branch"]
    task = {"id": f"RESTACK:{branch}", "type": "restack",
            "title": f"Rebase {branch} onto {conflict['onto_name']} and resolve the conflicts",
            "branch": branch, "pr": conflict["pr"], "onto": conflict["onto"],
            "onto_name": conflict["onto_name"], "old_base": conflict["old_base"],
            "old_head": conflict["old_head"]}
    worktree = WORKTREES / ("restack-" + branch.replace("/", "-"))
    shutil.rmtree(worktree, ignore_errors=True)
    git("clone", "--quiet", "--shared", "--no-checkout", str(REPO), str(worktree))
    git("checkout", "--quiet", "-B", branch, conflict["old_head"], cwd=worktree)
    current = {
        "task_id": task["id"], "task": task, "branch": branch, "base": conflict["onto_name"],
        "base_sha": conflict["onto"], "worktree": str(worktree),
        "started": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    save(CURRENT, current)
    print(f"TASK_ID={task['id']}\nBRANCH={branch}\nBASE={conflict['onto_name']}\nWORKTREE={worktree}")
    return 0


# ── review ───────────────────────────────────────────────────────────────

# Log lines of a failed CI job that point at the GitHub runner, not at the code: rerun once.
INFRA_FAILURES = ("failed to install component", "No space left on device",
                  "The runner has received a shutdown signal", "Could not resolve host",
                  "The operation was canceled", "lost communication with the server")


def rerun_infra_failures(head: str) -> bool:
    """Rerun the failed CI runs on head once when their logs show a runner or toolchain failure."""
    reruns = load(STATE / "ci-reruns.json", {})
    if head in reruns:
        return False
    runs = json.loads(run(["gh", "run", "list", "--repo", GH_REPO, "--commit", head, "--json",
                           "databaseId,conclusion"], check=False) or "[]")
    failed = [r["databaseId"] for r in runs if r.get("conclusion") == "failure"]
    if not failed:
        return False
    logs = "".join(run(["gh", "run", "view", str(r), "--repo", GH_REPO, "--log-failed"], check=False)
                   for r in failed)
    if not any(marker in logs for marker in INFRA_FAILURES):
        return False
    for r in failed:
        run(["gh", "run", "rerun", str(r), "--repo", GH_REPO, "--failed"], check=False)
    reruns[head] = dt.datetime.now(dt.timezone.utc).isoformat()
    save(STATE / "ci-reruns.json", reruns)
    print(f"CI_RERUN={head[:12]} (runner/toolchain failure)")
    return True


def find_review(open_prs: list[dict]) -> dict | None:
    """The lowest stack PR with unresolved review threads or red CI that is not a runner failure.

    Fixing it comes before any new backlog task: such a PR can never be merged, and everything
    stacked on it waits."""
    blocked = load(BLOCKED, {})
    for pr in sorted(open_prs, key=lambda p: branch_number(p["headRefName"])):
        threads = review_threads(pr["number"])
        ci_red = ci_state(pr["headRefOid"]) == "red" and not rerun_infra_failures(pr["headRefOid"])
        if not threads and not ci_red:
            continue
        if f"REVIEW:{pr['headRefName']}" in blocked:
            print(f"WARN=review of {pr['headRefName']} is blocked; it stays unmergeable until unblocked")
            continue
        return {"pr": pr, "threads": threads, "ci_red": ci_red}
    return None


def start_review(review: dict) -> int:
    """Hand a PR's open review threads and/or red CI to the agent, on top of the PR's own branch."""
    pr = review["pr"]
    branch, head = pr["headRefName"], pr["headRefOid"]
    git("fetch", "--quiet", "origin", f"+refs/heads/{branch}:refs/ark/{PROGRAM}/review-head")
    task = {"id": f"REVIEW:{branch}", "type": "review",
            "title": f"Address the open review threads and red CI of {pr['url']}",
            "branch": branch, "pr": pr["url"], "number": pr["number"], "old_head": head,
            "threads": review["threads"],
            "ci_failure": ci_failure_log(head) if review["ci_red"] else ""}
    worktree = WORKTREES / ("review-" + branch.replace("/", "-"))
    shutil.rmtree(worktree, ignore_errors=True)
    git("clone", "--quiet", "--shared", "--no-checkout", str(REPO), str(worktree))
    git("checkout", "--quiet", "-B", branch, head, cwd=worktree)
    current = {
        # base_sha is the PR head: the agent's fix commits sit on top of it and the gate compares
        # the fixed head against the PR as it was.
        "task_id": task["id"], "task": task, "branch": branch, "base": pr["baseRefName"],
        "base_sha": head, "worktree": str(worktree),
        "started": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    save(CURRENT, current)
    print(f"TASK_ID={task['id']}\nBRANCH={branch}\nBASE={pr['baseRefName']}\nWORKTREE={worktree}")
    return 0


# ── backlog ──────────────────────────────────────────────────────────────


def backlog_at(rev: str, path: str = BACKLOG) -> dict | None:
    text = git("show", f"{rev}:{path}", check=False)
    return yaml.safe_load(text) if text else None


MAIN_DONE: dict[str, set[str]] = {}


def done_on_main(ref: str) -> bool:
    """True when `program:ID` is done in that programme's backlog on origin/main."""
    program, _, task_id = ref.partition(":")
    if program not in PROGRAMS or not task_id:
        raise RuntimeError(f"bad ext_deps entry {ref!r}; expected <program>:<id>")
    if program not in MAIN_DONE:
        backlog = backlog_at("origin/main", PROGRAMS[program]["backlog"]) or {}
        MAIN_DONE[program] = {t["id"] for t in backlog.get("tasks", []) if t.get("status") == "done"}
    return task_id in MAIN_DONE[program]


def task_of_branch(branch: str) -> str:
    """`l1/042-b-iban` -> `b-iban`: the lower-cased task id a task branch was created for."""
    m = re.match(rf"{re.escape(BRANCH_PREFIX)}\d+-(.+)$", branch)
    return m.group(1) if m else ""


def pick(backlog: dict, blocked: dict, in_flight: set[str] = frozenset()) -> dict | None:
    """First selectable task; `in_flight` holds lower-cased ids that already have an open PR."""
    tasks = backlog.get("tasks", [])
    done = {t["id"] for t in tasks if t.get("status") == "done"}
    today = dt.date.today()
    week = f"{today.isocalendar().year}-W{today.isocalendar().week:02d}"
    if today.weekday() == 0 and not (STATE / f"triage-{week}").exists() and done:
        rec = next(r for r in backlog.get("recurring", []) if r["id"] == "TRIAGE")
        return {**rec, "type": "triage", "week": week}
    for t in tasks:
        if t.get("status", "todo") != "todo" or t["id"] in blocked or t["id"].lower() in in_flight:
            continue
        if t.get("needs_decision"):
            continue
        if all(d in done for d in t.get("deps", [])) and all(
            done_on_main(d) for d in t.get("ext_deps", [])
        ):
            return t
    return None


def mark_done(path: Path, task_id: str) -> None:
    path.write_text(mark_done_text(path.read_text(), task_id))


def mark_done_text(text: str, task_id: str) -> str:
    lines = text.splitlines(keepends=True)
    for i, line in enumerate(lines):
        flow = re.match(rf"(\s*- \{{id: {re.escape(task_id)},.*)\}}(\s*)$", line)
        if flow:
            lines[i] = f"{flow.group(1)}, status: done}}{flow.group(2)}"
            break
        block = re.match(rf"(\s*)- id: {re.escape(task_id)}\s*$", line)
        if block:
            lines.insert(i + 1, f"{block.group(1)}  status: done\n")
            break
    else:
        raise RuntimeError(f"task {task_id} not found in {BACKLOG}")
    return "".join(lines)


# ── auto-merge ───────────────────────────────────────────────────────────


def ci_state(head: str) -> str:
    """'green', 'red' or 'pending' for the GitHub check runs on head (same rule as `ci`)."""
    try:
        checks = json.loads(run(["gh", "api", f"repos/{GH_REPO}/commits/{head}/check-runs?per_page=100"]))[
            "check_runs"]
    except (RuntimeError, ValueError, KeyError):
        return "pending"
    names = {c["name"] for c in checks}
    if not CI_REQUIRED <= names or any(c["status"] != "completed" for c in checks):
        return "pending"
    return "green" if all(c["conclusion"] in OK_CONCLUSIONS for c in checks) else "red"


def review_threads(number: int) -> list[dict]:
    """Unresolved review threads of a PR (Codex, CodeQL, people); main requires all resolved."""
    owner, name = GH_REPO.split("/")
    query = (f'query($n:Int!){{repository(owner:"{owner}",name:"{name}"){{pullRequest(number:$n)'
             '{reviewThreads(first:100){nodes{id isResolved path line comments(first:1)'
             '{nodes{databaseId author{login} body}}}}}}}')
    out = json.loads(run(["gh", "api", "graphql", "-f", f"query={query}", "-F", f"n={number}"]) or "{}")
    nodes = (((out.get("data") or {}).get("repository") or {}).get("pullRequest") or {}).get(
        "reviewThreads", {}).get("nodes", [])
    threads = []
    for node in nodes:
        if node.get("isResolved") or not node["comments"]["nodes"]:
            continue
        first = node["comments"]["nodes"][0]
        threads.append({
            "id": node["id"], "comment": first["databaseId"], "path": node.get("path"),
            "line": node.get("line"), "author": (first.get("author") or {}).get("login", ""),
            # Bot comments carry HTML metadata after the finding; the agent needs only the text.
            "body": first.get("body", "").split("<!--")[0].strip()[:4000],
        })
    return threads


def open_review_threads(number: int) -> int:
    return len(review_threads(number))


def merge_async(number: int, head: str) -> str:
    """Squash-merge one PR through the asynchronous merge API (required for native stacks).

    Returns 'merged', 'failed: <message>' or 'pending' after MERGE_TIMEOUT seconds."""
    out = json.loads(run(["gh", "api", "-X", "PUT", f"repos/{GH_REPO}/pulls/{number}/merge-async",
                          "-f", "merge_method=squash", "-f", "merge_action=direct_merge",
                          "-f", f"sha={head}"]) or "{}")
    status, uuid = out.get("status"), (out.get("details") or {}).get("uuid")
    deadline = dt.datetime.now() + dt.timedelta(seconds=MERGE_TIMEOUT)
    while status not in ("merged", "failed") and uuid and dt.datetime.now() < deadline:
        subprocess.run(["sleep", "10"])
        out = json.loads(run(["gh", "api", f"repos/{GH_REPO}/pulls/{number}/merge-async/{uuid}"],
                             check=False) or "{}")
        status = out.get("status", status)
    if status == "failed":
        return f"failed: {(out.get('details') or {}).get('message', '')}"
    return status if status == "merged" else "pending"


CODEX_LOGIN = "chatgpt-codex-connector[bot]"
CODEX_WAIT = 20 * 60     # seconds to wait for the automatic Codex review of a new PR
CODEX_POLL = 30


def codex_reviewed(number: int, head: str) -> bool:
    """True once the Codex review summary on the PR reports a completed review of `head`."""
    out = run(["gh", "api", f"repos/{GH_REPO}/issues/{number}/comments", "--paginate", "--jq",
               f'[.[] | select(.user.login == "{CODEX_LOGIN}") | .body]'], check=False)
    try:
        bodies = json.loads(out or "[]")
    except ValueError:
        return False
    for body in bodies:
        for raw in re.findall(r"codex-review-state:v1 (\{.*?\}) -->", body or "", re.S):
            try:
                review = json.loads(raw).get("code_review") or {}
            except ValueError:
                continue
            if review.get("commit_sha") == head and review.get("status") == "completed":
                return True
    return False


def land(number: int, head: str, wait_for_codex: bool = True) -> None:
    """Merge a just-published, green PR in the same run instead of stacking the next task on it.

    A new PR gets an automatic Codex review: wait for it (CODEX_WAIT), and leave the PR open when
    it opened threads; the next run turns them into a REVIEW task and lands the fix the same way.
    A Codex review that never completes does not block the merge."""
    if not AUTO_MERGE:
        return
    label = f"#{number}"
    deadline = dt.datetime.now() + dt.timedelta(seconds=CODEX_WAIT if wait_for_codex else 0)
    while wait_for_codex and dt.datetime.now() < deadline and not codex_reviewed(number, head):
        if open_review_threads(number):
            break
        subprocess.run(["sleep", str(CODEX_POLL)])
    threads = open_review_threads(number)
    if threads:
        print(f"LAND_WAIT={label} {threads} unresolved review thread(s); the next run reviews them")
        return
    result = merge_async(number, head)
    if result == "merged":
        print(f"LANDED={label}")
    else:
        print(f"LAND_WAIT={label} merge {result}; the next run's auto-merge retries")


def wait_for_retarget(merged_branch: str) -> None:
    """After a merge GitHub rebases the PRs above and moves them to main; let it finish first so
    `restack` does not race the server-side rebase with its own force-push."""
    deadline = dt.datetime.now() + dt.timedelta(seconds=RETARGET_TIMEOUT)
    while dt.datetime.now() < deadline:
        if not any(p["baseRefName"] == merged_branch for p in prs("open")):
            return
        subprocess.run(["sleep", "15"])
    print(f"WARN=PRs on {merged_branch} not retargeted after {RETARGET_TIMEOUT}s; restack takes over")


def auto_merge(open_prs: list[dict]) -> int | None:  # PR number, MERGE_PENDING or None
    """Squash-merge the bottom stack PR when it targets main, is mergeable and its CI is green.

    At most one per run: the PR above it is rebased onto the squash commit by `restack` and needs
    a fresh CI run before it can follow. The repository deletes merged branches, so GitHub moves
    the next PR to main by itself. Returns the merged PR number, else None."""
    if not AUTO_MERGE or not open_prs:
        return None
    bottom = min(open_prs, key=lambda p: branch_number(p["headRefName"]))
    label = f"#{bottom['number']} {bottom['headRefName']}"
    if bottom["baseRefName"] != "main" or bottom.get("isDraft"):
        print(f"AUTO_MERGE_SKIP={label} (base {bottom['baseRefName']}, draft {bottom.get('isDraft')})")
        return None
    if bottom.get("mergeable") != "MERGEABLE":
        print(f"AUTO_MERGE_WAIT={label} mergeable={bottom.get('mergeable')}")
        return None
    state = ci_state(bottom["headRefOid"])
    if state != "green":
        print(f"AUTO_MERGE_WAIT={label} CI {state}")
        return None
    try:
        threads = open_review_threads(bottom["number"])
        if threads:
            print(f"AUTO_MERGE_WAIT={label} {threads} unresolved review thread(s)")
            return None
        result = merge_async(bottom["number"], bottom["headRefOid"])
    except (RuntimeError, ValueError) as err:
        print(f"AUTO_MERGE_ERROR={label}: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
        return None
    if result == "pending":
        # Still in progress: it may yet merge and rebase the stack on the server, so this run must
        # not restack or start a task now.
        print(f"AUTO_MERGE_PENDING={label} after {MERGE_TIMEOUT}s")
        return MERGE_PENDING
    if result != "merged":
        print(f"AUTO_MERGE_ERROR={label}: {result}")
        return None
    print(f"AUTO_MERGED={label}")
    wait_for_retarget(bottom["headRefName"])
    return bottom["number"]


