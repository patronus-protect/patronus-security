def gate_steps(wt: Path) -> list[tuple[str, list[str], dict]]:
    """(name, command, sandbox options); every step runs sandboxed in the trusted checkout wt."""
    py = str(ROOT / P["eval_venv"] / "bin" / "python")
    gpy = str(GATE_VENV / "bin" / "python")
    build = {"rw": [wt, GATE_TARGET, GATE_HOME, GATE_VENV]}
    gitleaks = program_root("dlp") / "baselines" / "bin" / "gitleaks"
    steps = [
        # First and cheap: GitHub push protection rejects a branch for one literal token in any commit.
        ("plaintext-secrets", ["python3", str(SHARED / "bin" / "secret_check.py"), "--repo", str(wt),
                               "--base", load(CURRENT, {}).get("base_sha", ""), "--head", "HEAD",
                               "--gitleaks", str(gitleaks)], {"rw": [wt], "network": False}),
        ("fmt", [str(CARGO), "fmt", "--all", "--", "--check"], build),
        ("clippy", [str(CARGO), "clippy", "--workspace", "--all-targets", "--", "-D", "warnings"], build),
        # The following steps mirror .github/workflows/ci.yml (rust and python jobs); GitHub CI on
        # the pushed branch is checked again before a PR is opened (`ark-l1 ci`).
        ("test", [str(CARGO), "test", "-p", "patronus-ark", "-p", "ark-api", "-p", "ark-coordinator",
                  "-p", "ark-distributed-protocol"], build),
        ("golden", ["sh", "-c", f"cd rust && exec {CARGO} run --quiet --locked --example 13_l1_golden_eval -- all"],
         build),
        ("python-ext", [gpy, "-m", "maturin", "develop", "--quiet", "--manifest-path", "python/Cargo.toml"],
         build),
        ("python-tests", [gpy, "-m", "unittest", "discover", "-s", "python/tests"], build),
        # scripts/tests/entrypoint_peers.py expects the binary in the checkout's target/debug.
        ("ark-api-entrypoint", ["sh", "-c", f"{CARGO} build --locked -p ark-api --bin ark-api-entrypoint && "
                                "mkdir -p target/debug && ln -sf \"$CARGO_TARGET_DIR/debug/ark-api-entrypoint\" "
                                "target/debug/ark-api-entrypoint"], build),
        ("scripts-tests", [gpy, "-m", "pytest", "scripts/tests", "-q"], build),
        ("docs", ["python3", "scripts/generate_docs.py", "--check"], build),
    ]
    prepare = wt / P["eval_dir"] / "prepare_corpora.py"
    if prepare.exists() and not (HOLDOUT / ".ready").exists():
        # Downloads public corpora and freezes the split; no credentials in the sandbox.
        steps.append(("prepare-corpora", [py, str(prepare), "--dev-out", str(DEV_DATA),
                                          "--holdout-out", str(HOLDOUT)],
                      {"rw": [wt, DEV_DATA, HOLDOUT, CACHE]}))
    favored = HOLDOUT / "presidio_favored"
    # Second source family (E12), frozen once like the neutral split; raw sources stay in the holdout.
    # Only scripts that know --family (not the DLP program's, not branches before E12) get the step.
    if prepare.exists() and "presidio_favored" in prepare.read_text(encoding="utf-8") \
            and not (favored / ".ready").exists():
        steps.append(("presidio-favored-corpora", [py, str(prepare), "--family", "presidio_favored",
                                                   "--dev-out", str(DEV_DATA / "presidio_favored"),
                                                   "--holdout-out", str(favored)],
                      {"rw": [wt, DEV_DATA, HOLDOUT, CACHE]}))
    synth = wt / P["eval_dir"] / "synth_goldset.py"
    if synth.exists() and not (HOLDOUT / "synthetic" / ".ready").exists():
        # Once, like prepare-corpora: afterwards agent branches never get write access to the holdout.
        # The secret holdout seed is created in HOLDOUT/synthetic/.seed.
        steps.append(("synthetic-goldset", [py, str(synth), "--dev-out", str(DEV_DATA / "synthetic"),
                                            "--holdout-out", str(HOLDOUT / "synthetic")],
                      {"rw": [DEV_DATA, HOLDOUT], "readable": (wt,), "network": False}))
    external = wt / P["eval_dir"] / "external_content.py"
    if external.exists() and not (DEV_DATA / "external" / ".ready").exists():
        # Dev only (gitleaks Go, SchemaPile SQL): public sources, never part of the holdout.
        steps.append(("external-corpora", [py, str(external), "prepare", "--out", str(DEV_DATA / "external"),
                                           "--sources", str(CACHE / "external_sources")],
                      {"rw": [wt, DEV_DATA, CACHE]}))
    scoreboard = wt / P["eval_dir"] / "scoreboard.py"
    if scoreboard.exists():
        cur = load(CURRENT, {})
        # The only step that reads the holdout: no network, writes only to the private cache.
        steps.append(("scoreboard", [py, str(scoreboard), "gate", "--head", str(wt),
                                     "--base-sha", cur.get("base_sha", ""), "--dev", str(DEV_DATA),
                                     "--holdout", str(HOLDOUT), "--cache", str(CACHE)],
                      {"rw": [CACHE], "readable": (HOLDOUT, wt), "network": False}))
    return steps


