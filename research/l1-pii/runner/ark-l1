def cmd_gate() -> int:
    cur = load(CURRENT, None)
    if cur is None:
        print("no current run")
        return 1
    report = STATE / "gate-report.md"
    lines = [f"# Gate {cur['task_id']} ({cur['branch']})", ""]
    ok = True
    status = agent_git(Path(cur["worktree"]), "status", "--porcelain")
    dirty = status.stdout.strip() if status.returncode == 0 else f"git status failed: {status.stderr[-500:]}"
    commit = import_agent_commits(cur)
    if dirty:
        lines.append("- ❌ uncommitted changes (only committed work is gated):\n```\n" + dirty[:2000] + "\n```")
        ok = False
    if commit is None or commit == cur["base_sha"]:
        lines.append("- ❌ no commits on the branch")
        ok = False
    elif subprocess.run(["git", *GIT_SAFE, "merge-base", "--is-ancestor", cur["base_sha"], commit],
                        cwd=REPO).returncode != 0:
        lines.append(f"- ❌ branch does not build on its base {cur['base_sha'][:12]}")
        ok = False
    if ok:
        # Writable sandbox paths must exist, or systemd silently leaves them read-only.
        for d in (GATE_TARGET, GATE_HOME / "cargo", GATE_HOME / "cache", CACHE, TRANSFER):
            d.mkdir(parents=True, exist_ok=True)
        tree = GATE_TREES / "current"
        shutil.rmtree(tree, ignore_errors=True)
        git("worktree", "prune")
        git("worktree", "add", "--quiet", "--detach", str(tree), commit)
        try:
            for name, cmd, opts in gate_steps(tree):
                proc = sandbox(cmd, tree, opts["rw"], gate_env(), network=opts.get("network", True),
                               readable=opts.get("readable", ()))
                if proc.returncode == 0:
                    tail = proc.stdout.strip().splitlines()[-15:] if name == "scoreboard" else []
                    lines.append(f"- ✅ {name}" + ("\n```\n" + "\n".join(tail) + "\n```" if tail else ""))
                else:
                    # The scoreboard reads the holdout: report its exit code, never its output.
                    out = "" if name == "scoreboard" else (proc.stdout + "\n" + proc.stderr).strip()[-6000:]
                    lines.append(f"- ❌ {name} (exit {proc.returncode}): `{shlex.join(cmd)}`\n```\n{out}\n```")
                    ok = False
                    break
        finally:
            shutil.rmtree(tree, ignore_errors=True)
            git("worktree", "prune", check=False)
    if ok:
        cur["gated_commit"] = commit
        save(CURRENT, cur)
    report.write_text("\n".join(lines) + "\n")
    print(report.read_text())
    return 0 if ok else 1


def done_commit(commit: str, task: dict) -> str:
    """Commit the task's `status: done` on top of commit without any checkout."""
    text = git_raw("show", f"{commit}:{BACKLOG}")
    tasks = (yaml.safe_load(text) or {}).get("tasks", [])
    if any(t["id"] == task["id"] and t.get("status") == "done" for t in tasks):
        return commit
    blob = git_raw("hash-object", "-w", "--stdin", stdin=mark_done_text(text, task["id"])).strip()
    with tempfile.TemporaryDirectory() as tmp:
        env = {"GIT_INDEX_FILE": str(Path(tmp) / "index")}
        git_raw("read-tree", commit, env=env)
        git_raw("update-index", "--cacheinfo", f"100644,{blob},{BACKLOG}", env=env)
        tree = git_raw("write-tree", env=env).strip()
    return git_raw("commit-tree", tree, "-p", commit, "-m",
                   f"chore({PROGRAM}): mark {task['id']} done").strip()


CI_REQUIRED = {"rust", "python"}     # jobs of .github/workflows/ci.yml that must be among the checks
CI_TIMEOUT = 75 * 60                 # native-throughput alone may take 30 minutes
CI_POLL = 60
OK_CONCLUSIONS = {"success", "skipped", "neutral"}


def publish_head(cur: dict) -> str:
    """The PR head for the gated commit, built once: commit-tree stamps the time, so building it
    again on a resumed run would give a new SHA, lose the green-CI record and push again."""
    task = cur["task"]
    cached = cur.get("publish_commit")
    if cached and "publish_of" not in cur:
        # State from a runner before publish_of: the head belongs to the gated commit when it is
        # that commit (triage) or the done commit right on top of it.
        parent = git("rev-parse", "--verify", "--quiet", f"{cached}^", check=False)
        if cached == cur["gated_commit"] or parent == cur["gated_commit"]:
            cur["publish_of"] = cur["gated_commit"]
    if cached and cur.get("publish_of") == cur["gated_commit"]:
        return cached
    head = (cur["gated_commit"] if task.get("type") in ("triage", "review", "restack")
            else done_commit(cur["gated_commit"], task))
    cur["publish_commit"], cur["publish_of"] = head, cur["gated_commit"]
    return head


def ci_failure_log(head: str) -> str:
    """Tail of the failed job logs of the CI runs on head, for the agent's next round."""
    runs = json.loads(run(["gh", "run", "list", "--repo", GH_REPO, "--commit", head, "--json",
                           "databaseId,conclusion,name"], check=False) or "[]")
    out = []
    for r in runs:
        if r.get("conclusion") not in OK_CONCLUSIONS:
            log = run(["gh", "run", "view", str(r["databaseId"]), "--repo", GH_REPO, "--log-failed"], check=False)
            out.append(f"### {r['name']} ({r.get('conclusion')})\n{log[-5000:]}")
    return "\n".join(out)[-9000:]


def cmd_ci() -> int:
    """Push the would-be PR head to the branch (no PR yet) and wait for GitHub CI on it.

    Exit 0 = green (publish may open a ready PR), 1 = red (report in gate-report.md for the next
    round), 3 = no verdict (timeout, missing checks, GitHub error): the run stays resumable."""
    cur = load(CURRENT, None)
    if cur is None or not cur.get("gated_commit"):
        print("no gated run to check")
        return 3
    head = publish_head(cur)
    cur["publish_commit"] = head
    save(CURRENT, cur)
    if cur.get("ci_green") == head:
        print(f"CI=green {head[:12]} (cached)")
        return 0
    try:
        if cur["task"].get("type") in ("review", "restack"):
            # The PR branch exists; fast-forward it, but never over a push made in the meantime
            # (a server-side stack rebase after a merge below, or a person). The lease follows our own
            # last push: after a red round the branch sits at that fix, not at the original PR head.
            lease = cur.get("review_pushed") or cur["task"]["old_head"]
            if cur.get("review_pushed") != head:
                git("push", "--quiet", f"--force-with-lease=refs/heads/{cur['branch']}:{lease}",
                    "origin", f"{head}:refs/heads/{cur['branch']}")
                cur["review_pushed"] = head
                save(CURRENT, cur)
        else:
            git("push", "--quiet", "origin", f"+{head}:refs/heads/{cur['branch']}")
    except RuntimeError as err:
        print(f"PUBLISH_ERROR={str(err).strip().splitlines()[-1]}")
        return 3
    print(f"== waiting for GitHub CI on {cur['branch']} @ {head[:12]}")
    deadline = dt.datetime.now() + dt.timedelta(seconds=CI_TIMEOUT)
    checks: list[dict] = []
    while dt.datetime.now() < deadline:
        subprocess.run(["sleep", str(CI_POLL)])
        try:
            checks = json.loads(run(["gh", "api", f"repos/{GH_REPO}/commits/{head}/check-runs?per_page=100"]))[
                "check_runs"]
        except (RuntimeError, ValueError, KeyError) as err:
            print(f"WARN=check-runs not readable: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
            continue
        names = {c["name"] for c in checks}
        if not CI_REQUIRED <= names or any(c["status"] != "completed" for c in checks):
            continue
        failed = [c["name"] for c in checks if c["conclusion"] not in OK_CONCLUSIONS]
        report = STATE / "gate-report.md"
        if not failed:
            cur["ci_green"] = head
            save(CURRENT, cur)
            if report.exists():
                report.write_text(report.read_text() + f"- ✅ GitHub CI ({', '.join(sorted(names))})\n")
            print(f"CI=green {head[:12]}")
            return 0
        report.write_text(
            f"# GitHub CI {cur['task_id']} ({cur['branch']} @ {head[:12]})\n\n"
            f"- ❌ GitHub CI red: {', '.join(failed)}. The local gate was green, so the failing step is not\n"
            f"  mirrored locally; reproduce it like .github/workflows/ci.yml does.\n```\n{ci_failure_log(head)}\n```\n")
        print(report.read_text())
        print(f"CI=red {', '.join(failed)}")
        return 1
    print(f"CI=timeout after {CI_TIMEOUT // 60} min; checks: "
          + ", ".join(f"{c['name']}:{c['status']}/{c.get('conclusion')}" for c in checks))
    return 3


def cmd_publish() -> int:
    cur = load(CURRENT, None)
    if cur is None or not cur.get("gated_commit"):
        print("no gated run to publish")
        return 1
    task = cur["task"]
    if task.get("type") == "restack":
        return publish_restack(cur)
    if task.get("type") == "review":
        return publish_review(cur)
    head = publish_head(cur)
    if cur.get("ci_green") != head:
        # Rule: no PR without green GitHub CI on exactly the commit the PR shows.
        print(f"PUBLISH_ERROR=GitHub CI not green on {head[:12]} (run `ark-l1 ci` first)")
        return 1
    if task.get("type") == "triage":
        (STATE / f"triage-{task['week']}").write_text(dt.datetime.now(dt.timezone.utc).isoformat() + "\n")
    cur["publish_commit"] = head
    save(CURRENT, cur)
    git("push", "--quiet", "origin", f"+{head}:refs/heads/{cur['branch']}")
    report = (STATE / "gate-report.md").read_text() if (STATE / "gate-report.md").exists() else ""
    body = "\n".join([
        f"Scheduled {P['name']} run, backlog task **{task['id']}**: {task.get('title', '')}",
        "",
        f"Stacked on `{cur['base']}`. One task per run; see `{P['readme']}`.",
        "",
        "```yaml",
        yaml.safe_dump(task, allow_unicode=True, sort_keys=False).strip(),
        "```",
        "",
        report,
        "",
        "🤖 Generated with [Claude Code](https://claude.com/claude-code)",
    ])
    existing = json.loads(run(["gh", "pr", "list", "--repo", GH_REPO, "--head", cur["branch"],
                               "--state", "open", "--json", "url"]))
    if existing:
        url = existing[0]["url"]
    else:
        # Ready for review, not a draft: only green, finished work reaches this point.
        url = run(["gh", "pr", "create", "--repo", GH_REPO, "--base", cur["base"],
                   "--head", cur["branch"], "--label", LABEL,
                   "--title", f"{P['title']} {task['id']}: {task.get('title', '')}"[:250], "--body", body])
    stack = load(STACK, {})
    stack[cur["branch"]] = {"base": cur["base"], "base_sha": cur["base_sha"]}
    save(STACK, stack)
    drop_worktree(cur)
    print(f"PR={url}")
    try:
        number = int(url.rstrip("/").rsplit("/", 1)[-1])
        land(number, head)
    except (RuntimeError, ValueError) as err:
        print(f"WARN=landing {url} failed: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
    return 0


def publish_restack(cur: dict) -> int:
    """Replace the conflicting branch with the gated rebase; the next `next` restacks the branches above."""
    task, branch, head = cur["task"], cur["branch"], cur["gated_commit"]
    if cur.get("ci_green") != head:
        # `ci` pushed the rebase (lease on the head it started from) and waits for GitHub CI.
        print(f"PUBLISH_ERROR=GitHub CI not green on {head[:12]} (run `ark-l1 ci` first)")
        return 1
    stack = load(STACK, {})
    stack[branch] = {"base": task["onto_name"], "base_sha": task["onto"]}
    save(STACK, stack)
    drop_worktree(cur)
    print(f"RESTACKED={branch}\nPR={task['pr']}")
    try:
        # Merge the rebased PR in this run instead of leaving it to a later auto-merge, before main
        # moves again; open review threads keep it open for a REVIEW run.
        land(int(task["pr"].rstrip("/").rsplit("/", 1)[-1]), head, wait_for_codex=False)
    except (RuntimeError, ValueError) as err:
        print(f"WARN=landing {task['pr']} failed: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
    return 0


def review_notes(cur: dict) -> dict:
    """Per-thread notes the agent left in its clone (`.git/ark-review.json`, thread id -> text).

    Untrusted agent output: only short plain strings for known thread ids are used."""
    path = Path(cur["worktree"]) / ".git" / "ark-review.json"
    try:
        notes = json.loads(path.read_text()) if path.is_file() and path.stat().st_size < 64_000 else {}
    except (OSError, ValueError):
        return {}
    if not isinstance(notes, dict):
        return {}
    known = {t["id"] for t in cur["task"].get("threads", [])}
    return {k: v.strip()[:1500] for k, v in notes.items() if k in known and isinstance(v, str) and v.strip()}


def publish_review(cur: dict) -> int:
    """The fix is on the PR branch (pushed by `ci`, CI green): answer and resolve every thread."""
    task, head = cur["task"], cur["gated_commit"]
    if cur.get("ci_green") != head:
        print(f"PUBLISH_ERROR=GitHub CI not green on {head[:12]} (run `ark-l1 ci` first)")
        return 1
    notes = review_notes(cur)
    # Per-thread progress survives a failed GitHub call: the retry neither posts a reply twice nor
    # drops the state (and with it the promised answer) before every thread is answered and resolved.
    done = cur.setdefault("review_done", {})
    failed = []
    for thread in task.get("threads", []):
        step = done.setdefault(thread["id"], {})
        try:
            if not step.get("replied"):
                body = f"Addressed in {head[:12]} (scheduled {P['name']} review run)."
                if notes.get(thread["id"]):
                    body += "\n\n" + notes[thread["id"]]
                run(["gh", "api", f"repos/{GH_REPO}/pulls/{task['number']}/comments/{thread['comment']}/replies",
                     "-f", f"body={body}"])
                step["replied"] = True
                save(CURRENT, cur)
            if not step.get("resolved"):
                run(["gh", "api", "graphql", "-f",
                     f'query=mutation{{resolveReviewThread(input:{{threadId:"{thread["id"]}"}}){{thread{{isResolved}}}}}}'])
                step["resolved"] = True
                save(CURRENT, cur)
        except RuntimeError as err:
            failed.append(thread["id"])
            print(f"WARN=thread {thread['id']}: {str(err).strip().splitlines()[0] if str(err).strip() else err}")
    if failed:
        print(f"PUBLISH_ERROR=GitHub thread update failed for {len(failed)} thread(s); the next run retries")
        return 1
    drop_worktree(cur)
    print(f"REVIEWED={cur['branch']} threads={len(task.get('threads', []))}\nPR={task['pr']}")
    try:
        # Codex does not review follow-up pushes on its own; merge once the threads are resolved.
        land(task["number"], head, wait_for_codex=False)
    except (RuntimeError, ValueError) as err:
        print(f"WARN=landing {task['pr']} failed: {str(err).strip().splitlines()[-1] if str(err).strip() else err}")
    return 0


def drop_worktree(cur: dict) -> None:
    # Plain deletes: the host never runs git inside the agent clone.
    shutil.rmtree(cur["worktree"], ignore_errors=True)
    shutil.rmtree(GATE_TREES / "current", ignore_errors=True)
    git("worktree", "prune", check=False)
    git("update-ref", "-d", f"refs/ark/{PROGRAM}/gate", check=False)
    CURRENT.unlink(missing_ok=True)


def cmd_block(task_id: str, reason: str) -> int:
    blocked = load(BLOCKED, {})
    cur = load(CURRENT, None)
    blocked[task_id] = {"reason": reason, "at": dt.datetime.now(dt.timezone.utc).isoformat()}
    save(BLOCKED, blocked)
    if cur is not None and cur["task_id"] == task_id:
        if cur.get("publish_commit") and cur["task"].get("type") != "restack" and not json.loads(run(
                ["gh", "pr", "list", "--repo", GH_REPO, "--head", cur["branch"], "--state", "all",
                 "--json", "number"], check=False) or "[]"):
            # `ark-l1 ci` pushed the branch for a CI run that stayed red; without a PR it is just noise.
            git("push", "--quiet", "origin", "--delete", cur["branch"], check=False)
        drop_worktree(cur)
    print(f"BLOCKED={task_id}")
    return 0


def cmd_abort() -> int:
    cur = load(CURRENT, None)
    if cur is not None:
        drop_worktree(cur)
    print("ABORTED")
    return 0


def cmd_unblock(task_id: str) -> int:
    blocked = load(BLOCKED, {})
    blocked.pop(task_id, None)
    save(BLOCKED, blocked)
    print(f"UNBLOCKED={task_id}")
    return 0


def cmd_status() -> int:
    git("fetch", "--quiet", "--prune", "origin")
    open_prs = sorted(prs("open"), key=lambda p: branch_number(p["headRefName"]))
    print("Stack (open):")
    for p in open_prs:
        print(f"  #{p['number']} {p['headRefName']} ← {p['baseRefName']}  {p['url']}")
    print("Blocked:", json.dumps(load(BLOCKED, {}), indent=2, ensure_ascii=False))
    print("Current:", load(CURRENT, None))
    # Same choice as `next`: flat tasks start from main and skip tasks that already have a PR.
    backlog = backlog_at("origin/main")
    in_flight = {task_of_branch(p["headRefName"]) for p in open_prs}
    task = pick(backlog, load(BLOCKED, {}), in_flight) if backlog else None
    print("Next:", task and f"{task['id']} {task.get('title', '')}")
    return 0


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__)
        return 2
    cmd, args = argv[0], argv[1:]
    table = {
        "next": cmd_next, "env": cmd_env, "gate": cmd_gate, "publish": cmd_publish,
        "abort": cmd_abort, "status": cmd_status, "ahead": cmd_ahead, "ci": cmd_ci,
    }
    if cmd in table:
        return table[cmd]()
    if cmd == "block" and len(args) >= 2:
        return cmd_block(args[0], " ".join(args[1:]))
    if cmd == "unblock" and len(args) == 1:
        return cmd_unblock(args[0])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
